        echo "  Blocklist created: $hosts_blocklist ($(wc -l < "$hosts_blocklist") entries)"
    fi

    if [ -w "$hosts_target" ] || [ "$(id -u)" = "0" ]; then
        cat "$hosts_blocklist" >> "$hosts_target" 2>/dev/null && \
            echo "  Blocklist appended to $hosts_target" || \
            echo "  Failed to write to $hosts_target"
    else
        echo "  Blocklist (for manual install): $hosts_blocklist"
        echo "  Install via Magisk: Systemless Hosts module"
    fi

    # Android-specific telemetry
    echo ""
    echo "  Android telemetry endpoints:"
    settings put global captive_portal_detection_enabled 0 2>/dev/null && echo "  Captive portal: disabled" || true
    settings put global wifi_scan_always_enabled 0 2>/dev/null && echo "  WiFi scanning: disabled" || true
    settings put global ble_scan_always_enabled 0 2>/dev/null && echo "  BLE scanning: disabled" || true

    log "Tracking blocklist applied"
}

app_permissions_audit() {
    echo "── Application Permissions Audit ──"
    echo ""

    if ! command -v pm >/dev/null 2>&1; then
        echo "  pm (package manager) not available"
        return 1
    fi

    echo "  Suspicious permissions:"
    echo ""
    pm list packages -3 2>/dev/null | sed 's/package://' | while read -r pkg; do
        local perms=$(pm list permissions -g -p "$pkg" 2>/dev/null | grep -E 'dangerous|signature' | head -3)
        if [ -n "$perms" ]; then
            echo "  $pkg:"
            echo "$perms" | sed 's/^/    /'
        fi
    done | head -40

    echo ""
    echo "  Permission groups (dangerous):"
    echo "    CAMERA, RECORD_AUDIO, READ_CONTACTS, READ_SMS"
    echo "    ACCESS_FINE_LOCATION, READ_EXTERNAL_STORAGE"
    echo "    WRITE_EXTERNAL_STORAGE, READ_CALL_LOG"
    echo ""
    echo "  Check specific: pm list permissions -g -p <package>"
    echo "  Revoke:        pm revoke <package> <permission>"
}

signal_check() {
    echo "── Signal/Privacy Check ──"
    echo ""
    local issues=0

    # Check ADB
    local adb_tcp=$(getprop persist.adb.tcp.port 2>/dev/null || echo "")
    if [ -n "$adb_tcp" ]; then
        echo "  WARNING: ADB over TCP enabled on port $adb_tcp"
        issues=$((issues + 1))
    fi

    # Check USB debugging
    local usb_debug=$(getprop persist.sys.usb.config 2>/dev/null || echo "")
    case "$usb_debug" in *adb*) echo "  WARNING: USB debugging enabled"; issues=$((issues + 1));; esac

    # Check WiFi scanning
    local wifi_scan=$(settings get global wifi_scan_always_enabled 2>/dev/null || echo "0")
    [ "$wifi_scan" = "1" ] && echo "  WARNING: WiFi scanning always on" && issues=$((issues + 1))

    # Check BLE scanning
    local ble_scan=$(settings get global ble_scan_always_enabled 2>/dev/null || echo "0")
    [ "$ble_scan" = "1" ] && echo "  WARNING: BLE scanning always on" && issues=$((issues + 1))

    # Check GPS
    local gps=$(settings get secure location_providers_allowed 2>/dev/null || echo "")
    case "$gps" in *gps*) echo "  WARNING: GPS enabled"; issues=$((issues + 1));; esac

    # Check MAC randomization
    local mac_random=$(settings get global wlan_scan_no_randomization 2>/dev/null || echo "?")
    [ "$mac_random" = "1" ] && echo "  WARNING: MAC randomization disabled" && issues=$((issues + 1))

    # Check developer options
    local dev_mode=$(settings get global development_settings_enabled 2>/dev/null || echo "0")
    [ "$dev_mode" = "1" ] && echo "  INFO: Developer options enabled"

    echo ""
    if [ $issues -eq 0 ]; then
        echo "  No signal issues found"
    else
        echo "  $issues signal/privacy issue(s) found"
        echo "  Fix suggestions:"
        echo "    settings put global wifi_scan_always_enabled 0"
        echo "    settings put global ble_scan_always_enabled 0"
        echo "    settings put secure location_providers_allowed -gps"
        echo "    settings put global development_settings_enabled 0"
    fi
    log "Signal check: $issues issues"
}

firewall_privacy() {
    echo "── Privacy Firewall Rules ──"
    echo ""

    if ! command -v iptables >/dev/null 2>&1; then
        echo "  iptables not available"
        return 1
    fi

    # Block common tracking domains via iptables (DNS-level + IP-level)
    echo "  Adding privacy iptables rules..."

    # Block known tracking networks
    for net in "216.58.192.0/19" "172.217.0.0/16" "142.250.0.0/15"; do
        iptables -A OUTPUT -d "$net" -j REJECT 2>/dev/null || true
    done

    # Block Facebook tracking
    for net in "31.13.24.0/21" "157.240.0.0/16" "69.171.224.0/19"; do
        iptables -A OUTPUT -d "$net" -j REJECT 2>/dev/null || true
    done

    # Block telemetry
    for net in "64.233.160.0/19" "66.102.0.0/20"; do
        iptables -A OUTPUT -d "$net" -j REJECT 2>/dev/null || true
    done

    echo "  Privacy rules applied"
    echo "  Rules saved to: $PRIVACY_DIR/iptables-privacy.rules"
    iptables-save 2>/dev/null > "$PRIVACY_DIR/iptables-privacy.rules"
    log "Privacy firewall rules applied"
}

usage() {
    cat <<EOF
nh-privacy - Privacy toolkit for the NetHunter platform

Usage: nh-privacy <command> [args]

Commands:
  dns             Configure encrypted DNS (Cloudflare/Quad9/AdGuard)
  mac [iface]     Spoof MAC address (interactive or specify interface)
  restore-mac <iface>  Restore original MAC address
  proxy           Configure proxy chain (Tor/SSH/HTTP/dynamic)
  killswitch      Activate VPN/proxy killswitch (iptables-based)
  killstop        Deactivate killswitch
  trackblock      Block tracking & telemetry hosts
  signal          Check signal/privacy exposure
  app-perms       Audit app permissions for privacy risks
  fw-privacy      Add privacy iptables rules

Examples:
  nh-privacy dns
  nh-privacy mac wlan0
  nh-privacy killswitch
  nh-privacy signal
  nh-privacy trackblock
  nh-privacy app-perms
EOF
    exit 1
}

ensure_dirs
case "${1:-help}" in
    dns|dns-encrypt) dns_encrypt ;;
    mac|mac-spoof|spoof) shift; mac_spoof "$@" ;;
    restore-mac|mac-restore) shift; restore_mac "$@" ;;
    proxy|proxychain) proxy_chain ;;
    killswitch|ks) killswitch_setup ;;
    killstop|ks-stop|ks-off) killswitch_stop ;;
    trackblock|tracking|block-tracking) tracking_block ;;
    signal|signal-check|privacy-check) signal_check ;;
    app-perms|app-permissions|audit-perms) app_permissions_audit ;;
    fw-privacy|firewall-privacy) firewall_privacy ;;
    *) usage ;;
esac
