#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P1
# nh-privacy - Privacy toolkit: DNS encryption, proxy chains, MAC spoofing, killswitch
set -u

NHSYSTEM=/data/local/nhsystem
NHWORK=$NHSYSTEM/workspaces/main
PRIVACY_DIR=$NHSYSTEM/etc/privacy
PRIVACY_LOG=$NHSYSTEM/logs/privacy.log
KILLSWITCH_PID=$PRIVACY_DIR/killswitch.pid

ensure_dirs() { mkdir -p "$PRIVACY_DIR" "$NHSYSTEM/logs"; log "ensured dirs"; }
log() { echo "[$(date '+%H:%M:%S')] $*" >> "$PRIVACY_LOG"; }

dns_encrypt() {
    echo "── DNS Encryption Setup ──"
    ensure_dirs
    local dns_config="$PRIVACY_DIR/resolv.conf"

    echo "  Select DNS provider:"
    echo "    1) Cloudflare (1.1.1.1) [DoH/DoT]"
    echo "    2) Quad9 (9.9.9.9) [Privacy-first]"
    echo "    3) AdGuard (94.140.14.14) [Ad-blocking]"
    echo "    4) Custom"
    printf "  Choice [1-4]: "
    read -r choice

    local primary="1.1.1.1"
    local secondary="1.0.0.1"
    local name="Cloudflare"

    case "$choice" in
        2) primary="9.9.9.9"; secondary="149.112.112.112"; name="Quad9" ;;
        3) primary="94.140.14.14"; secondary="94.140.15.15"; name="AdGuard" ;;
        4) printf "  Primary DNS: "; read -r primary
           printf "  Secondary DNS: "; read -r secondary
           name="Custom" ;;
    esac

    cat > "$dns_config" <<DNS
# DNS configuration - $name
# Generated by nh-privacy on $(date)
nameserver $primary
nameserver $secondary
DNS

    # Apply system-wide
    cp "$dns_config" /etc/resolv.conf 2>/dev/null || true
    for root in "$NHSYSTEM/roots/archlinux" "$NHSYSTEM/kali-arm64"; do
        [ -d "$root/etc" ] && cp "$dns_config" "$root/etc/resolv.conf" 2>/dev/null || true
    done

    echo "  DNS set to $name ($primary, $secondary)"
    echo "  Config: $dns_config"
    log "DNS set to $name ($primary, $secondary)"

    # Try DoH via curl
    if command -v curl >/dev/null 2>&1; then
        echo ""
        echo "  Testing DNS resolution..."
        if curl -s --doh-url "https://cloudflare-dns.com/dns-query" "https://1.1.1.1" >/dev/null 2>&1; then
            echo "  DNS-over-HTTPS: available"
        else
            echo "  DNS-over-HTTPS: check connectivity"
        fi
    fi
}

mac_spoof() {
    local iface="${1:-}"
    [ -z "$iface" ] && {
        echo "── MAC Address Spoofing ──"
        echo ""
        ip -br link show 2>/dev/null | grep -v '^lo' | while read -r iface state; do
            local current=$(cat "/sys/class/net/$iface/address" 2>/dev/null || echo "?")
            echo "  $iface: $current"
        done
        echo ""
        printf "  Interface to spoof: "
        read -r iface
    }

    [ -z "$iface" ] && { echo "No interface specified"; exit 1; }
    [ -d "/sys/class/net/$iface" ] || { echo "Interface not found: $iface"; exit 1; }

    local current=$(cat "/sys/class/net/$iface/address" 2>/dev/null || echo "?")
    local original="$PRIVACY_DIR/mac.orig.$iface"

    # Save original
    echo "$current" > "$original"

    # Generate random MAC
    local vendor=$(openssl rand -hex 3 2>/dev/null || echo "02$(date +%N | cut -c1-4)")
    local suffix=$(openssl rand -hex 3 2>/dev/null || echo "$(date +%N | cut -c1-6)")
    local new_mac=$(echo "$vendor:$suffix" | sed 's/\(..\)/\1:/g; s/:$//')

    echo "── MAC Spoofing ──"
    echo "  Interface: $iface"
    echo "  Original:  $current"
    echo "  New:       $new_mac"
    echo ""

    if ip link set "$iface" down 2>/dev/null && \
       ip link set "$iface" address "$new_mac" 2>/dev/null && \
       ip link set "$iface" up 2>/dev/null; then
        echo "  MAC spoofed successfully"
        log "MAC $iface: $current -> $new_mac"
        echo "  Restore: nh-privacy restore-mac $iface"
    else
        echo "  Failed to spoof MAC (requires root, may not be supported)"
    fi
}

restore_mac() {
    local iface="${1:-}"
    [ -z "$iface" ] && { echo "Usage: nh-privacy restore-mac <interface>"; exit 1; }
    local original="$PRIVACY_DIR/mac.orig.$iface"
    [ -f "$original" ] || { echo "No saved MAC for $iface"; exit 1; }
    local mac=$(cat "$original")

    ip link set "$iface" down 2>/dev/null
    ip link set "$iface" address "$mac" 2>/dev/null
    ip link set "$iface" up 2>/dev/null
    echo "  MAC restored to $mac for $iface"
    log "MAC $iface restored to $mac"
}

proxy_chain() {
    echo "── Proxy Chain Configuration ──"
    ensure_dirs
    local proxychains_conf="$PRIVACY_DIR/proxychains.conf"

    echo "  Select proxy type:"
    echo "    1) SOCKS5 (Tor - localhost:9050)"
    echo "    2) SOCKS5 (SSH tunnel)"
    echo "    3) HTTP/HTTPS proxy"
    echo "    4) Auto-select (dynamic chain)"
    printf "  Choice [1-4]: "
    read -r choice

    case "$choice" in
        1) cat > "$proxychains_conf" <<PROXY
# ProxyChains - Tor
strict_chain
proxy_dns
tcp_read_time_out 15000
tcp_connect_time_out 8000
[ProxyList]
socks5 127.0.0.1 9050
PROXY
            echo "  Proxy: Tor SOCKS5 on localhost:9050"
            ;;
        2) printf "  SSH host: "; read -r ssh_host
           printf "  SSH port [22]: "; read -r ssh_port
           ssh_port="${ssh_port:-22}"
           printf "  SSH user: "; read -r ssh_user
           cat > "$proxychains_conf" <<PROXY
# ProxyChains - SSH tunnel
strict_chain
proxy_dns
[ProxyList]
socks5 127.0.0.1 1080
PROXY
            echo "  Proxy: SSH tunnel ($ssh_user@$ssh_host:$ssh_port)"
            echo "  Start: ssh -D 1080 $ssh_user@$ssh_host -p $ssh_port"
            ;;
        3) printf "  HTTP proxy host: "; read -r http_host
           printf "  HTTP proxy port: "; read -r http_port
           cat > "$proxychains_conf" <<PROXY
# ProxyChains - HTTP
strict_chain
[ProxyList]
http $http_host $http_port
PROXY
            echo "  Proxy: HTTP $http_host:$http_port"
            ;;
        4) cat > "$proxychains_conf" <<PROXY
# ProxyChains - Dynamic chain
dynamic_chain
proxy_dns
random_chain
chain_len 2
[ProxyList]
socks5 127.0.0.1 9050
socks5 127.0.0.1 9051
PROXY
            echo "  Proxy: Dynamic chain (Tor + random)" ;;
    esac

    echo "  Config: $proxychains_conf"
    echo "  Usage: proxychains4 -f $proxychains_conf <command>"
    log "Proxy chain configured"
}

killswitch_setup() {
    echo "── VPN/Proxy Killswitch ──"
    echo ""
    echo "  A killswitch blocks ALL non-tunnel traffic"
    echo "  when your VPN/proxy disconnects"
    echo ""

    if ! command -v iptables >/dev/null 2>&1; then
        echo "  iptables not available"
        return 1
    fi

    if [ -f "$KILLSWITCH_PID" ] && [ "$(cat "$KILLSWITCH_PID")" = "1" ]; then
        echo "  Killswitch is ACTIVE"
        printf "  Deactivate? [y/N]: "
        read -r ans
        case "$ans" in y|Y) killswitch_stop;; *) return;; esac
        return
    fi

    echo "  Select killswitch type:"
    echo "    1) VPN killswitch (block if tun0 down)"
    echo "    2) Tor killswitch (block if :9050 down)"
    echo "    3) Proxy killswitch (block if proxy unreachable)"
    echo "    4) Full lockdown (block all, whitelist only)"
    printf "  Choice [1-4]: "
    read -r choice

    # Save current iptables
    iptables-save 2>/dev/null > "$PRIVACY_DIR/iptables-save.killswitch" 2>/dev/null
    log "Saved iptables state"

    # Flush existing
    iptables -F INPUT 2>/dev/null
    iptables -F OUTPUT 2>/dev/null
    iptables -F FORWARD 2>/dev/null

    case "$choice" in
        1) # VPN killswitch
            iptables -P OUTPUT DROP 2>/dev/null
            iptables -A OUTPUT -o tun0 -j ACCEPT 2>/dev/null
            iptables -A OUTPUT -o lo -j ACCEPT 2>/dev/null
            iptables -A OUTPUT -p udp --dport 1194 -j ACCEPT 2>/dev/null  # OpenVPN
            iptables -A OUTPUT -p udp --dport 51820 -j ACCEPT 2>/dev/null  # WireGuard
            iptables -A OUTPUT -p tcp --dport 443 -j ACCEPT 2>/dev/null   # HTTPS
            echo "  VPN killswitch: ACTIVE (tun0 required)"
            ;;
        2) # Tor killswitch
            iptables -P OUTPUT DROP 2>/dev/null
            iptables -A OUTPUT -o lo -j ACCEPT 2>/dev/null
            iptables -A OUTPUT -m owner --uid-owner debian-tor -j ACCEPT 2>/dev/null || \
                iptables -A OUTPUT -d 127.0.0.1 -p tcp --dport 9050 -j ACCEPT 2>/dev/null
            iptables -A OUTPUT -p tcp --dport 443 -j ACCEPT 2>/dev/null  # For Tor bridges
            echo "  Tor killswitch: ACTIVE"
            ;;
        3) # Proxy killswitch
            iptables -P OUTPUT DROP 2>/dev/null
            iptables -A OUTPUT -o lo -j ACCEPT 2>/dev/null
            iptables -A OUTPUT -p tcp --dport 1080 -j ACCEPT 2>/dev/null  # SOCKS
            iptables -A OUTPUT -p tcp --dport 8080 -j ACCEPT 2>/dev/null  # HTTP proxy
            iptables -A OUTPUT -p tcp --dport 8118 -j ACCEPT 2>/dev/null  # Privoxy
            echo "  Proxy killswitch: ACTIVE"
            ;;
        4) # Full lockdown
            iptables -P INPUT DROP 2>/dev/null
            iptables -P OUTPUT DROP 2>/dev/null
            iptables -P FORWARD DROP 2>/dev/null
            iptables -A INPUT -i lo -j ACCEPT 2>/dev/null
            iptables -A OUTPUT -o lo -j ACCEPT 2>/dev/null
            iptables -A OUTPUT -p udp --dport 53 -j ACCEPT 2>/dev/null     # DNS
            iptables -A OUTPUT -p tcp --dport 443 -j ACCEPT 2>/dev/null     # HTTPS
            iptables -A OUTPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null      # HTTP
            echo "  Full lockdown: ACTIVE"
            ;;
    esac

    # Allow established connections
    iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null
    iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null

    echo "1" > "$KILLSWITCH_PID"
    echo "  Deactivate: nh-privacy killstop"
    log "Killswitch activated (type $choice)"
}

killswitch_stop() {
    echo "── Deactivating Killswitch ──"
    if [ -f "$PRIVACY_DIR/iptables-save.killswitch" ]; then
        iptables-restore < "$PRIVACY_DIR/iptables-save.killswitch" 2>/dev/null
        echo "  iptables restored to previous state"
    else
        iptables -P INPUT ACCEPT 2>/dev/null
        iptables -P OUTPUT ACCEPT 2>/dev/null
        iptables -P FORWARD ACCEPT 2>/dev/null
        iptables -F 2>/dev/null
        echo "  iptables reset to ACCEPT all"
    fi
    rm -f "$KILLSWITCH_PID"
    log "Killswitch deactivated"
}

tracking_block() {
    echo "── Tracking & Telemetry Blocking ──"
    echo ""

    local hosts_blocklist="$PRIVACY_DIR/hosts.blocklist"
    local hosts_target="/system/etc/hosts"

    if [ ! -f "$hosts_blocklist" ]; then
        echo "  Creating tracking hosts blocklist..."
        cat > "$hosts_blocklist" <<HOSTS
