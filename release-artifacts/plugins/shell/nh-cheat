}

list_cheats() {
    ensure_cheats
    echo "── Cheat Sheets ──"
    echo ""
    for f in "$CHEAT_DIR"/*.txt; do
        [ -f "$f" ] || continue
        local name=$(basename "$f" .txt)
        local lines=$(wc -l < "$f")
        printf "  %-20s %d commands\n" "$name" "$((lines - 3))"
    done
    echo ""
    echo "Usage: nh-cheat <topic>"
    echo "Topics: network, crypto, reverse, exploit, system, wifi, forensic"
}

show_cheat() {
    local topic="$1"
    local file="$CHEAT_DIR/$topic.txt"
    [ -f "$file" ] || { echo "Cheat sheet not found: $topic"; echo "Available: network crypto reverse exploit system wifi forensic"; exit 1; }
    cat "$file"
}

usage() {
    cat <<EOF
nh-cheat - Cheat sheet generator

Usage: nh-cheat <topic>

Topics:
  network    Scanning, capture, tunneling, DNS
  crypto     Hash cracking, generation, verification
  reverse    Frida, APK analysis, MITM, certs
  exploit    Metasploit, payloads, searchsploit, web
  system     Processes, storage, services, chroot, dev
  wifi       Monitor mode, WPA, WPS, BT, wardriving
  forensic   File analysis, memory, logs, recovery
EOF
    exit 1
}

ensure_cheats
[ $# -ge 1 ] || usage
case "$1" in
    list|ls) list_cheats ;;
    *) show_cheat "$1" ;;
esac
