#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P2
# nh-hsm - Hardware Security Module Integration
# YubiKey, SoloKey, Nitrokey, Android TEE bridge
set -u

NHSYSTEM=${NHSYSTEM:-/data/local/nhsystem}
HSM_DIR="$NHSYSTEM/hsm"
CONFIG_DIR="$NHSYSTEM/etc/hsm"
LOG_DIR="$NHSYSTEM/logs/hsm"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p "$HSM_DIR" "$CONFIG_DIR" "$LOG_DIR"

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
err()   { printf "${RED}[ERR]${NC} %s\n" "$*" >&2; }
debug() { [ "${DEBUG:-0}" = "1" ] && printf "${CYAN}[DBG]${NC} %s\n" "$*" || true; }

check_root() {
    [ "$(id -u)" -eq 0 ] || { err "This command requires root"; return 1; }
}

# ── Hardware Detection ──────────────────────────────

detect_usb_keys() {
    info "Detecting USB security keys..."
    
    # Check for USB devices (requires lsusb or /sys/bus/usb/devices)
    if command -v lsusb >/dev/null 2>&1; then
        echo "── USB Devices ──"
        lsusb 2>/dev/null | grep -iE "yubi|solo|nitro|fido" || echo "  No HSM devices found"
    fi
    
    # Check /sys for USB devices
    if [ -d /sys/bus/usb/devices ]; then
        for dev in /sys/bus/usb/devices/*; do
            [ -f "$dev/idVendor" ] && [ -f "$dev/idProduct" ] || continue
            local vendor product
            vendor=$(cat "$dev/idVendor" 2>/dev/null)
            product=$(cat "$dev/idProduct" 2>/dev/null)
            # Check for known FIDO devices
            if echo "$vendor" | grep -qiE "1050|20a0|311f|096e"; then
                echo "  ✓ FIDO2 device found: $vendor:$product"
            fi
        done
    fi
}

detect_tee() {
    info "Checking Android TEE (Trusted Execution Environment)..."
    
    # Check for KeyMint/StrongBox
    if [ -d /data/user_de/0/android.security.keymaster ]; then
        ok "KeyMint service found"
    fi
    
    # Check for TEE device
    if [ -e /dev/tee0 ] || [ -e /dev/tbase ]; then
        ok "TEE device found"
    else
        info "TEE device not found (normal on non-Samsung)"
    fi
}

# ── YubiKey Operations ──────────────────────────────

setup_yubikey() {
    info "Setting up YubiKey integration..."
    
    # Install required tools in chroot
    if [ -f /data/local/nhsystem/roots/archlinux/usr/bin/pacman ]; then
        info "Installing YubiKey tools in Arch chroot..."
        chroot /data/local/nhsystem/roots/archlinux pacman -S --noconfirm \
            libfido2 ykpers pcsc-lite ccid 2>/dev/null || warn "Failed to install via pacman"
    fi
    
    # Check for ykman
    if command -v ykman >/dev/null 2>&1; then
        ok "ykman available"
        ykman info 2>/dev/null | head -10
    else
        warn "ykman not found"
        info "Install: pacman -S ykman (Arch) or pip install yubikey-manager"
    fi
}

yubikey_ssh_setup() {
    info "Setting up YubiKey for SSH authentication..."
    
    if ! command -v ykman >/dev/null 2>&1; then
        err "ykman not found. Install: pip install yubikey-manager"
        return 1
    fi
    
    # Generate PIV key for SSH
    info "Generating PIV key on YubiKey..."
    ykman piv generate-key -a RSA2048 9a 2>/dev/null || warn "Failed to generate key"
    
    ykman piv generate-csr -s "CN=nethunter" 9a | \
        ykman piv import-certificate 9a - 2>/dev/null || warn "Failed to import cert"
    
    ok "YubiKey SSH setup complete"
    info "Use: ssh-keygen -D libfido2.so -v to extract public key"
}

yubikey_gpg_setup() {
    info "Setting up YubiKey for GPG signing..."
    
    if ! command -v gpg >/dev/null 2>&1; then
        warn "GPG not found"
        return 1
    fi
    
    # Check if YubiKey is in GPG mode
    gpg --card-status 2>/dev/null | head -10 || warn "YubiKey not detected in GPG mode"
    
    info "To setup GPG on YubiKey:"
    echo "  1. ykman otp --disable  (if OTP enabled)"
    echo "  2. gpg --card-edit"
    echo "  3. Inside gpg: admin -> key-attr -> RSA 4096 -> key-gen"
}

# ── HSM-backed Operations ──────────────────────────────

hsm_backed_ssh() {
    info "Configuring HSM-backed SSH..."
    
    local ssh_config="$HOME/.ssh/config"
    mkdir -p "$HOME/.ssh"
    
    # Configure SSH to use PKCS#11
    if ! grep -q "PKCS11Provider" "$ssh_config" 2>/dev/null; then
        cat >> "$ssh_config" <<'SSH'
# YubiKey/HSM SSH
Host *
    PKCS11Provider libfido2.so
SSH
        ok "SSH config updated for HSM"
    else
        info "SSH already configured for HSM"
    fi
}

hsm_backed_gpg() {
    info "Configuring HSM-backed GPG..."
    
    # Set GPG to use YubiKey
    if command -v gpg >/dev/null 2>&1; then
        gpg --card-status 2>/dev/null && ok "GPG using YubiKey" || \
            warn "YubiKey not detected"
    fi
}

# ── TEE Keystore Bridge ──────────────────────────────

setup_tee_bridge() {
    check_root || return 1
    
    info "Setting up Android TEE -> Chroot bridge..."
    
    # Create bridge script
    cat > "$HSM_DIR/tee-bridge.sh" <<'BRIDGE'
#!/system/bin/sh
# Bridge Android KeyMint/StrongBox to Linux chroot
# Uses android-security-keymaster interface

KEYMASTER_SOCKET="/data/user_de/0/android.security.keymaster"

if [ ! -S "$KEYMASTER_SOCKET" ]; then
    echo "KeyMint socket not found"
    exit 1
fi

echo "KeyMint bridge ready"
echo "Use: keytool -provider KnCAndroidProvider"
BRIDGE
    
    chmod +x "$HSM_DIR/tee-bridge.sh"
    ok "TEE bridge script created: $HSM_DIR/tee-bridge.sh"
}

# ── FIDO2 Authentication ──────────────────────────────

setup_fido2() {
    info "Setting up FIDO2 authentication..."
    
    # Install pam_u2f or similar
    if [ -f /data/local/nhsystem/roots/archlinux/usr/bin/pacman ]; then
        chroot /data/local/nhsystem/roots/archlinux pacman -S --noconfirm pam_u2f 2>/dev/null || \
            warn "Failed to install pam_u2f"
    fi
    
    cat > "$CONFIG_DIR/fido2.conf" <<'FIDO2'
# FIDO2 Configuration
# For sudo, nhctl, chroot login

# PAM configuration for sudo:
# auth required pam_u2f.so authfile=/etc/u2f_keys
FIDO2
    
    ok "FIDO2 config created: $CONFIG_DIR/fido2.conf"
}

# ── Status ──────────────────────────────────────

show_status() {
    echo ""
    echo "═════════════════════════════════════════════════════════"
    echo "  NH-HSM STATUS"
    echo "  Time: $(date)"
    echo "═════════════════════════════════════════════════════════"
    echo ""
    
    # Hardware detection
    detect_usb_keys
    echo ""
    detect_tee
    echo ""
    
    # Tool availability
    echo "── Tools Available ──"
    for tool in ykman gpg ssh-keygen pam_u2f libfido2; do
        if command -v "$tool" >/dev/null 2>&1 || \
           [ -f "/usr/lib/$tool.so" ] || [ -f "/lib/$tool.so" ]; then
            ok "$tool: Available"
        else
            info "$tool: Not found"
        fi
    done
}

# ── Usage ──────────────────────────────────────

usage() {
    cat <<EOF
nh-hsm - Hardware Security Module (HSM) Integration

Usage: nh-hsm <command> [options]

Setup:
  setup               Install HSM tools (YubiKey, FIDO2)
  detect              Detect USB security keys and TEE
  status              Show HSM status

YubiKey:
  yubikey-ssh         Setup YubiKey for SSH (PIV)
  yubikey-gpg         Setup YubiKey for GPG signing
  ykman <cmd>         Direct ykman commands

FIDO2:
  fido2-setup         Configure FIDO2 authentication
  pam-config          Configure PAM for FIDO2

TEE Bridge:
  tee-bridge          Setup Android TEE -> Chroot bridge

HSM-backed Services:
  ssh-hsm             Configure HSM-backed SSH
  gpg-hsm             Configure HSM-backed GPG

Examples:
  nh-hsm setup
  nh-hsm detect
  nh-hsm yubikey-ssh
  nh-hsm status

Notes:
  - Requires USB OTG for YubiKey/Nitrokey/SoloKey
  - Android TEE: KeyMint/StrongBox
  - Install in Arch: pacman -S ykman libfido2
  - FIDO2 for sudo: configure pam_u2f

Files:
  Config: $CONFIG_DIR/
  Data:   $HSM_DIR/
  Logs:   $LOG_DIR/
EOF
}

# ── Main ──────────────────────────────────────

[ $# -ge 1 ] || usage

case "$1" in
    setup)
        setup_yubikey
        setup_fido2
        setup_tee_bridge
        ;;
    detect)
        detect_usb_keys
        echo ""
        detect_tee
        ;;
    yubikey-ssh)
        yubikey_ssh_setup
        ;;
    yubikey-gpg)
        yubikey_gpg_setup
        ;;
    fido2-setup)
        setup_fido2
        ;;
    tee-bridge)
        setup_tee_bridge
        ;;
    ssh-hsm)
        hsm_backed_ssh
        ;;
    gpg-hsm)
        hsm_backed_gpg
        ;;
    status)
        show_status
        ;;
    help|--help|-h)
        usage
        ;;
    ykman)
        shift
        command -v ykman >/dev/null 2>&1 && ykman "$@" || \
            err "ykman not found. Install: pip install yubikey-manager"
        ;;
    *)
        err "Unknown command: $1"
        usage
        ;;
esac
