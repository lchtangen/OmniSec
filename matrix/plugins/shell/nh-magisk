install_guide() {
    cat <<GUIDE
══ Module Installation Guide ══

NetHunter via Magisk (Official Method):
  1. Download NetHunter installer zip from:
     https://image-nethunter.kali.org/nethunter-installer/kali-daily/
  2. Open Magisk Manager -> Modules -> Install from storage
  3. Select the zip, wait for flash, reboot
  4. Install Nethunter APK from the zip (or from F-Droid)
  5. Open Nethunter app, allow root, download chroot
  6. Use Kali Chroot Manager to install

Other Magisk Modules:
  1. Download .zip to device
  2. Magisk Manager -> Modules -> Install from storage
  3. Reboot
  4. Verify: ls /data/adb/modules/

Quick Download:
  nh-magisk fetch <module-number>
  Then transfer the .zip and install in Magisk Manager

NOTE: Full NetHunter requires a custom kernel for:
  - Wi-Fi injection (monitor mode, packet injection)
  - HID attacks (BadUSB, DuckHunter)
  - Bluetooth Arsenal
  Check: https://nethunter.kali.org/device-kernels.html
GUIDE
}

fetch_module() {
    ensure_dirs
    local num="${1:-}"
    case "$num" in
        4|5|cert|certs)
            echo "── AlwaysTrustUserCerts ──"
            download_module "AlwaysTrustUserCerts" \
                "https://github.com/NVISOsecurity/AlwaysTrustUserCerts/releases/latest/download/AlwaysTrustUserCerts.zip"
            echo "  Install in Magisk Manager, then reboot"
            echo "  Add user cert in Settings -> Security -> Trusted credentials"
            ;;
        6|frida)
            echo "── MagiskFrida ──"
            local tag=$(curl -s "https://api.github.com/repos/ViRb3/magisk-frida/releases/latest" 2>/dev/null | grep '"tag_name"' | cut -d'"' -f4)
            [ -z "$tag" ] && tag="v1.7.0"
            download_module "MagiskFrida" \
                "https://github.com/ViRb3/magisk-frida/releases/download/$tag/MagiskFrida.zip"
            echo "  Install in Magisk Manager, reboot"
            echo "  Frida-server starts automatically on boot"
            ;;
        7|hluda)
            echo "── MagiskHluda ──"
            download_module "MagiskHluda" \
                "https://github.com/Exo1i/MagiskHluda/releases/latest/download/MagiskHluda.zip"
            echo "  Stealth Frida server (undetectable)"
            ;;
        8|yaypentest|yay)
            echo "── YayPentestMagiskModuleYay ──"
            download_module "YayPentestMagiskModuleYay" \
                "https://github.com/MaliciousErection/YayPentestMagiskModuleYay/releases/latest/download/YayPentestMagiskModuleYay.zip"
            echo "  Combines: MoveCert + Frida + custom tools"
            ;;
        9|beerus)
            echo "── Beerus Android Framework ──"
            echo "  Download APK + Magisk module from:"
            echo "  https://github.com/hakaioffsec/beerus-android/releases"
            echo "  Features: Frida Core, ADB over network, proxy, certs"
            ;;
        10|busybox)
            echo "── Busybox ──"
            echo "  Download from Magisk Module Repo or:"
            echo "  https://github.com/Magisk-Modules-Repo/busybox-ndk"
            ;;
        11|hosts|adaway)
            echo "── Systemless Hosts ──"
            echo "  Download from Magisk Module Repo"
            echo "  Blocks ads systemlessly via /etc/hosts"
            ;;
        12|zygisk)
            echo "── Zygisk Modules ──"
            echo "  Zygisk is built into Magisk 24+"
            echo "  Popular Zygisk modules:"
            echo "    - Zygisk-LSPosed (Xposed framework)"
            echo "    - Shamiko (Zygisk hiding)"
            echo "    - ZygiskFrida (Frida via Zygisk)"
            ;;
        *)
            echo "Usage: nh-magisk fetch <number>"
            echo "Numbers: 4(cert) 6(frida) 7(hluda) 8(yay) 9(beerus) 10(busybox) 11(hosts) 12(zygisk)"
            ;;
    esac
}

usage() {
    cat <<EOF
nh-magisk - Magisk module manager for NetHunter security tools

Usage: nh-magisk <command>

Commands:
  list        List installed Magisk modules (on device)
  available   List available security modules
  fetch <n>   Download a module by number (save to workspace)
  guide       Detailed installation guide
  detect      Detect Magisk version and status

Examples:
  nh-magisk detect
  nh-magisk available
  nh-magisk fetch 4        # AlwaysTrustUserCerts
  nh-magisk fetch frida    # MagiskFrida
  nh-magisk list
  nh-magisk guide
EOF
    exit 1
}

[ $# -ge 1 ] || usage
case "$1" in
    list|installed) list_installed_modules ;;
    available|list-available) list_available ;;
    fetch) shift; fetch_module "${1:-}" ;;
    guide|install-guide) install_guide ;;
    detect|status) detect_magisk ;;
    *) usage ;;
esac
