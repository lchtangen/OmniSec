#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P1
# nh-magisk - Magisk module downloader and security tool manager
set -u

NHSYSTEM=/data/local/nhsystem
MAGISK_MODULES_DIR=$NHSYSTEM/workspaces/main/magisk-modules
NH_CACHE=$NHSYSTEM/tmp/module-cache
NH_LOGS=$NHSYSTEM/logs/nh-magisk.log

log() { echo "[$(date '+%H:%M:%S')] $*" >> "$NH_LOGS"; }

ensure_dirs() {
    mkdir -p "$MAGISK_MODULES_DIR" "$NH_CACHE"
}

detect_magisk() {
    local magisk=""
    for p in /debug_ramdisk/magisk /data/adb/magisk/magisk64 /data/adb/magisk/magisk /sbin/magisk "$(magisk --path 2>/dev/null)/magisk"; do
        [ -x "$p" ] && magisk="$p" && break
    done
    if [ -n "$magisk" ]; then
        echo "  Magisk: $magisk"
        local ver=$("$magisk" -v 2>/dev/null || echo "?")
        echo "  Version: $ver"
        [ -d /data/adb/modules ] && echo "  Modules: $(ls /data/adb/modules 2>/dev/null | wc -l) installed"
        return 0
    fi
    echo "  Magisk not found (run this on device)"
    return 1
}

list_installed_modules() {
    echo "── Installed Magisk Modules ──"
    local count=0
    if [ -d /data/adb/modules ]; then
        for m in /data/adb/modules/*/; do
            [ -d "$m" ] || continue
            local name=$(basename "$m")
            local ver=$(cat "$m/module.prop" 2>/dev/null | grep '^version=' | cut -d= -f2 || echo "?")
            local disable=""
            [ -f "$m/disable" ] && disable=" [DISABLED]"
            echo "  $name v$ver$disable"
            count=$((count + 1))
        done
    fi
    [ $count -eq 0 ] && echo "  No Magisk modules found"
    echo "  Total: $count"
}

download_module() {
    local name="$1"
    local url="$2"
    local outfile="$MAGISK_MODULES_DIR/$name.zip"

    ensure_dirs
    [ -f "$outfile" ] && echo "  Already downloaded: $name.zip" && return 0

    echo "  Downloading $name..."
    if command -v curl >/dev/null 2>&1; then
        curl -sL --connect-timeout 30 "$url" -o "$outfile" || return 1
    elif command -v wget >/dev/null 2>&1; then
        wget -q --timeout=30 "$url" -O "$outfile" || return 1
    else
        echo "  curl/wget not found" >&2
        return 1
    fi

    local size=$(ls -lh "$outfile" 2>/dev/null | awk '{print $5}')
    echo "  Saved: $outfile ($size)"
    log "Downloaded $name from $url"
    return 0
}

