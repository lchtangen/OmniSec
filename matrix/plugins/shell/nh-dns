#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P2
# nh-dns - DNS management (dnsmasq, resolvconf, DoH/DoT)
set -u

NHSYSTEM=/data/local/nhsystem
DNS_DIR=$NHSYSTEM/etc/dns
DNS_CONFIG=$DNS_DIR/dnsmasq.conf
RESOLV_CONF=$DNS_DIR/resolv.conf

ensure_dirs() {
    mkdir -p $DNS_DIR
}

show_status() {
    ensure_dirs
    echo "── DNS Status ──"
    echo ""
    echo "  System DNS:"
    if [ -f /etc/resolv.conf ]; then
        grep nameserver /etc/resolv.conf 2>/dev/null | while read -r line; do
            echo "    $line"
        done
    fi
    echo ""
    if [ -f $RESOLV_CONF ]; then
        echo "  Custom resolv.conf:"
        grep nameserver $RESOLV_CONF | while read -r line; do
            echo "    $line"
        done
    fi
    echo ""
    # Check dnsmasq
    if command -v dnsmasq >/dev/null 2>&1; then
        echo "  dnsmasq: available"
        if pidof dnsmasq >/dev/null 2>&1; then
            echo "  dnsmasq: running"
        else
            echo "  dnsmasq: stopped"
        fi
    else
        echo "  dnsmasq: not installed"
    fi
}

set_dns() {
    local dns1="$1" dns2="${2:-}"
    ensure_dirs
    echo "# Generated by nh-dns" > $RESOLV_CONF
    echo "nameserver $dns1" >> $RESOLV_CONF
    [ -n "$dns2" ] && echo "nameserver $dns2" >> $RESOLV_CONF
    # Try to apply via Termux
    if [ -d $PREFIX/etc ]; then
        cp $RESOLV_CONF $PREFIX/etc/resolv.conf 2>/dev/null || true
    fi
    echo "  DNS set to: $dns1 ${dns2:-}"
}

reset_dns() {
    ensure_dirs
    echo "# nh-dns default" > $RESOLV_CONF
    echo "nameserver 1.1.1.1" >> $RESOLV_CONF
    echo "nameserver 8.8.8.8" >> $RESOLV_CONF
    echo "  DNS reset to Cloudflare + Google"
}

start_dnsmasq() {
    if ! command -v dnsmasq >/dev/null 2>&1; then
        echo "  dnsmasq not installed. Install: pkg install dnsmasq" >&2
        exit 1
    fi
    ensure_dirs
    if [ ! -f $DNS_CONFIG ]; then
        cat > $DNS_CONFIG <<'CFG'
# nh-dns dnsmasq configuration
port=53
domain-needed
bogus-priv
no-resolv
server=1.1.1.1
server=8.8.8.8
server=2606:4700:4700::1111
cache-size=1000
neg-ttl=3600
log-queries
CFG
    fi
    dnsmasq -C $DNS_CONFIG --pid-file=$DNS_DIR/dnsmasq.pid
    echo "  dnsmasq started"
}

stop_dnsmasq() {
    if [ -f $DNS_DIR/dnsmasq.pid ]; then
        kill $(cat $DNS_DIR/dnsmasq.pid) 2>/dev/null || true
        rm -f $DNS_DIR/dnsmasq.pid
        echo "  dnsmasq stopped"
    else
        echo "  dnsmasq not running"
    fi
}

query_dns() {
    local domain="${1:-google.com}"
    echo "── DNS Query: $domain ──"
    nslookup "$domain" 2>/dev/null || host "$domain" 2>/dev/null || dig "$domain" +short 2>/dev/null || \
        echo "  No DNS tools available (install dnsutils)"
}

usage() {
    cat <<EOF
usage: nh-dns <command> [args]

Commands:
  status                  Show DNS status
  set <dns1> [dns2]       Set custom DNS servers
  reset                   Reset to defaults (1.1.1.1, 8.8.8.8)
  dnsmasq start           Start local DNS cache
  dnsmasq stop            Stop local DNS cache
  query <domain>          Query a domain
EOF
    exit 1
}

[ $# -ge 1 ] || usage
case "$1" in
    status) show_status ;;
    set) shift; [ $# -ge 1 ] || usage; set_dns "$1" "${2:-}" ;;
    reset) reset_dns ;;
    dnsmasq)
        shift; [ $# -ge 1 ] || usage
        case "$1" in
            start) start_dnsmasq ;;
            stop) stop_dnsmasq ;;
            *) usage ;;
        esac
        ;;
    query) shift; query_dns "${1:-google.com}" ;;
    *) usage ;;
esac
