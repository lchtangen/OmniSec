#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P5
# nh-password — Password generator
set -euo pipefail
show_usage() { cat <<EOF
nh-password - Password Generator
Usage: nh-password [length] [count]
EOF
}
len="${1:-16}"
count="${2:-1}"
for i in $(seq 1 $count); do
    head -c $((len * 2)) /dev/urandom | base64 | tr -d "=+/" | cut -c1-$len
done
