# ── Self-Sovereign Identity ──────────────────────────────

setup_identity() {
    info "Setting up self-sovereign identity on mesh..."
    
    # Generate identity keypair
    if ! [ -f "$CONFIG_DIR/identity_key.pem" ]; then
        openssl genrsa -out "$CONFIG_DIR/identity_key.pem" 2048 2>/dev/null || {
            warn "OpenSSL not available"
            return 1
        }
        ok "Identity keypair generated"
    fi
    
    # Create identity certificate
    openssl req -new -x509 -key "$CONFIG_DIR/identity_key.pem" \
        -out "$CONFIG_DIR/identity_cert.pem" \
        -days 3650 \
        -subj "/CN=NetHunter-Device/OU=Matrix Platform" 2>/dev/null || warn "Cert generation failed"
    
    ok "Self-sovereign identity created"
    info "Certificate: $CONFIG_DIR/identity_cert.pem"
}

# ── Status ──────────────────────────────

show_status() {
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  NH-AUTONOMOUS STATUS"
    echo "  Time: $(date)"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    
    # Active services
    echo "── Active Services ──"
    local services="predictive power security"
    for svc in $services; do
        if [ -f "$AUTO_DIR/${svc}.pid" ]; then
            pid=$(cat "$AUTO_DIR/${svc}.pid" 2>/dev/null)
            if kill -0 "$pid" 2>/dev/null; then
                ok "$svc: Running (PID: $pid)"
            else
                warn "$svc: Not running (stale PID)"
            fi
        else
            info "$svc: Not running"
        fi
    done
    
    echo ""
    
    # Identity
    echo "── Self-Sovereign Identity ──"
    if [ -f "$CONFIG_DIR/identity_cert.pem" ]; then
        ok "Identity: Configured"
        openssl x509 -in "$CONFIG_DIR/identity_cert.pem" -noout -subject 2>/dev/null | sed 's/^/  /'
    else
        info "Identity: Not configured"
    fi
}

# ── Usage ──────────────────────────────

usage() {
    cat <<EOF
nh-autonomous - Autonomous Operations Platform.

Usage: nh-autonomous <command> [options]

Self-Healing:
  predictive-start    Start predictive self-healing ML
  predictive-stop     Stop predictive healing
  heal-now          Run immediate healing check.

Power Optimization:
  power-start        Start autonomous power optimization
  power-stop         Stop power optimization.

Adaptive Security:
  security-start      Start adaptive security posture
  security-stop       Stop adaptive security.

Federated Learning:
  federated-start    Start federated learning.
  share-behavior     Share learned behavior via mesh.

Identity:
  setup-identity    Setup self-sovereign identity on mesh.
  show-identity     Display identity information.

Status:
  status              Show autonomous status.

Examples:
  nh-autonomous predictive-start
  nh-autonomous power-start
  nh-autonomous security-start
  nh-autonomous setup-identity
  nh-autonomous status.

Files:
  Config: $CONFIG_DIR/
  Data:   $AUTO_DIR/
  Logs:   $LOG_DIR/

Notes:
  - Requires Python3 + scikit-learn for ML.
  - Federated learning uses Reticulum mesh.
  - Identity uses RSA 2048 + X.509 certs.
EOF
}

# ── Main ──────────────────────────────

[ $# -ge 1 ] || usage

case "$1" in
    predictive-start)
        predictive_heal
        start_predictive_monitor
        ;;
    predictive-stop)
        [ -f "$AUTO_DIR/predictive.pid" ] && \
            kill "$(cat "$AUTO_DIR/predictive.pid")" 2>/dev/null && ok "Stopped" || info "Not running"
        ;;
    heal-now)
        predictive_heal
        python3 "$AUTO_DIR/predictive_heal.py"
        ;;
    power-start)
        optimize_power
        start_power_optimization
        ;;
    power-stop)
        [ -f "$AUTO_DIR/power.pid" ] && \
            kill "$(cat "$AUTO_DIR/power.pid")" 2>/dev/null && ok "Stopped" || info "Not running"
        ;;
    security-start)
        adaptive_security
        start_adaptive_security
        ;;
    security-stop)
        [ -f "$AUTO_DIR/security.pid" ] && \
            kill "$(cat "$AUTO_DIR/security.pid")" 2>/dev/null && ok "Stopped" || info "Not running"
        ;;
    federated-start)
        federated_learn
        ;;
    setup-identity)
        setup_identity
        ;;
    status)
        show_status
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        err "Unknown command: $1"
        usage
        ;;
esac
