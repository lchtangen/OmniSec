    with open(gradient_file, 'w') as f:
        json.dump(gradient, f)
    
    # In reality, would share via Reticulum mesh
    print(f"📡 Gradient shared: {gradient_file}")

def aggregate_gradients():
    """Aggregate gradients from multiple devices."""
