    cat > "$AUTO_DIR/federated_learn.py" <<'FED'
#!/usr/bin/env python3
"""Federated learning - share learned behaviors without raw data."""
import json
from pathlib import Path
import hashlib

FEDERATED_DIR = Path("/data/local/nhsystem/autonomous/federated")
FEDERATED_DIR.mkdir(exist_ok=True)

def compute_gradient(local_data):
    """Compute gradient from local data (simplified)."""
    # In reality, this would train a model
    return {"pattern": "usage_pattern", "weight": 0.95}

def share_gradient(gradient, device_id):
    """Share gradient with other devices via mesh."""
