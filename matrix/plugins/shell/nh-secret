#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P2/P5
# nh-secret - Encrypted secrets store (GPG + Post-Quantum hybrid)
set -u

NHSYSTEM=/data/local/nhsystem
SECRET_DIR=$NHSYSTEM/etc/secrets
SECRET_FILE=$SECRET_DIR/store.gpg
PQC_DIR=$NHSYSTEM/etc/pqc

ensure_dirs() {
    mkdir -p $SECRET_DIR $PQC_DIR/keys
    chmod 700 $SECRET_DIR
}

have_gpg() {
    command -v gpg >/dev/null 2>&1
}

have_pqc() {
    command -v nh-pqc >/dev/null 2>&1 && nh-pqc status >/dev/null 2>&1
}

secrets_list() {
    ensure_dirs
    echo "── GPG Secrets ──"
    if [ -f "$SECRET_FILE" ] && have_gpg; then
        gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -v '^#' | cut -d= -f1 | \
            while read -r key; do
                [ -n "$key" ] && echo "  ${key}"
            done
        local count
        count=$(gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -cvE '^#|^$' || echo 0)
        echo "  ($count GPG secrets)"
    else
        echo "  (no GPG secrets store)"
    fi

    echo ""
    echo "── PQ-Encrypted Secrets ──"
    local pq_count=0
    for f in $PQC_DIR/secrets/*.pqc-enc; do
        [ -f "$f" ] || continue
        pq_count=$((pq_count+1))
        echo "  $(basename "$f" .pqc-enc)"
    done
    [ "$pq_count" -eq 0 ] && echo "  (no PQ secrets. Generate a PQ key first: nh-key pq-generate)"

    echo ""
    echo "  Tip: Use 'nh-secret pq-set <name> <value>' for PQ-encrypted storage"
}

secret_get() {
    local key="$1"
    ensure_dirs
    if [ ! -f "$SECRET_FILE" ]; then
        echo "  Secret not found: $key" >&2
        exit 1
    fi
    if ! have_gpg; then
        echo "  gpg not available" >&2
        exit 1
    fi
    gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep "^${key}=" | cut -d= -f2- || \
        { echo "  Secret not found: $key" >&2; exit 1; }
}

secret_set() {
    local key="$1" value="$2"
    ensure_dirs
    if ! have_gpg; then
        echo "  gpg not available" >&2
        exit 1
    fi
    local tmp="$SECRET_DIR/tmp"
    if [ -f "$SECRET_FILE" ]; then
        gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -v "^${key}=" > "$tmp" || true
    fi
    echo "${key}=${value}" >> "$tmp"
    local recipient
    recipient=$(gpg --list-keys --keyid-format SHORT 2>/dev/null | grep '^   ' | head -1 | awk '{print $1}')
    if [ -n "$recipient" ]; then
        gpg --encrypt --armor --recipient "$recipient" --output "$SECRET_FILE" "$tmp" 2>/dev/null || {
            gpg --symmetric --armor --output "$SECRET_FILE" "$tmp" 2>/dev/null || {
                cp "$tmp" "${SECRET_FILE%.gpg}.txt"
                chmod 600 "${SECRET_FILE%.gpg}.txt"
                echo "  Warning: GPG unavailable, stored as plaintext" >&2
            }
        }
    else
        gpg --symmetric --armor --output "$SECRET_FILE" "$tmp" 2>/dev/null || {
            cp "$tmp" "${SECRET_FILE%.gpg}.txt"
            chmod 600 "${SECRET_FILE%.gpg}.txt"
        }
    fi
    rm -f "$tmp"
    echo "  Secret stored: $key"
}

secret_delete() {
    local key="$1"
    ensure_dirs
    [ -f "$SECRET_FILE" ] || { echo "  No secrets store" >&2; exit 1; }
    have_gpg || { echo "  gpg not available" >&2; exit 1; }
    local tmp="$SECRET_DIR/tmp"
    gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -v "^${key}=" > "$tmp"
    local recipient
    recipient=$(gpg --list-keys --keyid-format SHORT 2>/dev/null | grep '^   ' | head -1 | awk '{print $1}')
    if [ -n "$recipient" ]; then
        gpg --encrypt --armor --recipient "$recipient" --output "$SECRET_FILE" "$tmp" 2>/dev/null || \
            gpg --symmetric --armor --output "$SECRET_FILE" "$tmp" 2>/dev/null || true
    else
        gpg --symmetric --armor --output "$SECRET_FILE" "$tmp" 2>/dev/null || true
    fi
    rm -f "$tmp"
    echo "  Secret deleted: $key"
}

pq_secret_set() {
    local key="$1" value="$2"
    local pubkey="${3:-}"
    ensure_dirs
    mkdir -p $PQC_DIR/secrets

    if [ -z "$pubkey" ]; then
        # Find first available PQ public key
        pubkey=$(find $PQC_DIR/keys -name "*.pqkey.pub" 2>/dev/null | head -1)
        if [ -z "$pubkey" ]; then
            echo "  No PQ public key found" >&2
            echo "  Generate one: nh-key pq-generate ml-kem-768 mykey" >&2
            exit 1
        fi
        echo "  Using PQ key: $(basename "$pubkey")"
    fi

    local tmp="$SECRET_DIR/pq-${key}"
    printf '%s' "$value" > "$tmp"

    nh-pqc encrypt "$pubkey" "$tmp" || {
        echo "  ERROR: PQ encryption failed" >&2
        rm -f "$tmp"
        exit 1
    }

    mv "${tmp}.pqc-enc" "$PQC_DIR/secrets/${key}.pqc-enc"
    rm -f "$tmp"
    echo "  PQ secret stored: $key"
    echo "  (decrypt with: nh-secret pq-get $key <private-key>)"
}

pq_secret_get() {
    local key="$1"
    local privkey="${2:-}"
    ensure_dirs

    local enc_file="$PQC_DIR/secrets/${key}.pqc-enc"
    [ -f "$enc_file" ] || { echo "  PQ secret not found: $key" >&2; exit 1; }

    if [ -z "$privkey" ]; then
        # Auto-detect matching private key
        privkey=$(find $PQC_DIR/keys -name "*.pqkey" 2>/dev/null | head -1)
        if [ -z "$privkey" ]; then
            echo "  No PQ private key found" >&2
            echo "  Provide one: nh-secret pq-get <key> <private-key>" >&2
            exit 1
        fi
    fi

    nh-pqc decrypt "$privkey" "$enc_file" || {
        echo "  ERROR: PQ decryption failed" >&2
        exit 1
    }

    local dec_file="${enc_file%.pqc-enc}.pqc-dec"
    if [ -f "$dec_file" ]; then
        cat "$dec_file"
        rm -f "$dec_file"  # securely remove decrypted temp file
    fi
}

pq_list_keys() {
    ensure_dirs
    echo "── Post-Quantum Public Keys ──"
    local has=0
    for pub in $PQC_DIR/keys/*.pqkey.pub; do
        [ -f "$pub" ] || continue
        has=1
        echo "  $(basename "$pub" .pqkey.pub)"
    done
    [ "$has" -eq 0 ] && echo "  (no PQ public keys. Generate: nh-key pq-generate)"
}

usage() {
    cat <<EOF
usage: nh-secret <command> [args]

Commands:
  list                  List all stored secrets (GPG + PQ)
  get <key>             Get a GPG secret value
  set <key> <value>     Store a GPG secret
  delete <key>          Delete a GPG secret

Post-Quantum (PQ):
  pq-set <key> <value> [pubkey]  Store PQ-encrypted secret
  pq-get <key> [privkey]         Retrieve PQ-encrypted secret
  pq-keys                        List available PQ public keys

GPG secrets use your GPG key pair.
PQ secrets use ML-KEM-768 hybrid encryption (requires OQS OpenSSL).
EOF
    exit 1
}

[ $# -ge 1 ] || usage
case "$1" in
    list) secrets_list ;;
    get) shift; [ $# -ge 1 ] || usage; secret_get "$1" ;;
    set) shift; [ $# -ge 2 ] || usage; secret_set "$1" "$2" ;;
    delete) shift; [ $# -ge 1 ] || usage; secret_delete "$1" ;;
    pq-set|pqset)
        shift; [ $# -ge 2 ] || usage; pq_secret_set "$1" "$2" "${3:-}"
        ;;
    pq-get|pqget)
        shift; [ $# -ge 1 ] || usage; pq_secret_get "$1" "${2:-}"
        ;;
    pq-keys|pqkeys)
        pq_list_keys
        ;;
    *) usage ;;
esac
