#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P3
# nh-qos - Quality of Service and traffic shaping for chroots
# Performance: efficient iptables/tc rules, minimal overhead
set -u

NHSYSTEM=${NHSYSTEM:-/data/local/nhsystem}
QOS_DIR="$NHSYSTEM/qos"
CONFIG_DIR="$NHSYSTEM/etc/qos"
DATA_DIR="$NHSYSTEM/logs/qos"

# Default settings
IFACE="wlan0"
UPLOAD_LIMIT="1mbit"
DOWNLOAD_LIMIT="5mbit"
SSH_PRIO=1      # Highest priority
DNS_PRIO=2
WEB_PRIO=3
DEFAULT_PRIO=5  # Lowest priority

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Ensure directories
mkdir -p "$QOS_DIR" "$CONFIG_DIR" "$DATA_DIR"

# ── Utility Functions ─────────────────────────────────────

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
err()   { printf "${RED}[ERR]${NC} %s\n" "$*" >&2; }
debug() { [ "${DEBUG:-0}" = "1" ] && printf "${CYAN}[DBG]${NC} %s\n" "$*" || true; }

check_root() {
    [ "$(id -u)" -eq 0 ] || { err "This command requires root access"; return 1; }
}

check_tools() {
    local missing=0
    for tool in iptables tc; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            warn "Tool not found: $tool"
            missing=$((missing + 1))
        fi
    done
    return $missing
}

# ── QoS Rules Setup ──────────────────────────────────────

setup_qos() {
    check_root || return 1
    
    info "Setting up QoS on interface: $IFACE"
    
    # Check if tools available
    if ! command -v tc >/dev/null 2>&1; then
        warn "tc (traffic control) not available"
        warn "Install with: apt install iproute2 (in chroot) or use iptables only"
    fi
    
    # Clear existing qdisc
    tc qdisc del dev "$IFACE" root 2>/dev/null || true
    
    # Create root qdisc (HTB - Hierarchical Token Bucket)
    tc qdisc add dev "$IFACE" root handle 1: htb default 50 2>/dev/null || {
        warn "Failed to create HTB qdisc (tc may not be available)"
        # Fall back to iptables only
        setup_iptables_only
        return $?
    }
    
    # Create main class (total bandwidth)
    tc class add dev "$IFACE" parent 1: classid 1:1 htb rate "$UPLOAD_LIMIT" 2>/dev/null || true
    
    # Create priority classes
    # Class 1:1:1 - SSH (highest priority)
    tc class add dev "$IFACE" parent 1:1 classid 1:10 htb rate "$UPLOAD_LIMIT" prio "$SSH_PRIO" 2>/dev/null || true
    # Class 1:1:2 - DNS
    tc class add dev "$IFACE" parent 1:1 classid 1:20 htb rate "$UPLOAD_LIMIT" prio "$DNS_PRIO" 2>/dev/null || true
    # Class 1:1:3 - Web
    tc class add dev "$IFACE" parent 1:1 classid 1:30 htb rate "$UPLOAD_LIMIT" prio "$WEB_PRIO" 2>/dev/null || true
    # Class 1:1:5 - Default (lowest priority)
    tc class add dev "$IFACE" parent 1:1 classid 1:50 htb rate "$UPLOAD_LIMIT" prio "$DEFAULT_PRIO" 2>/dev/null || true
    
    # Create qdiscs for each class (sfq for fairness)
    for class in 10 20 30 50; do
        tc qdisc add dev "$IFACE" parent 1:$class handle ${class}: sfq perturb 10 2>/dev/null || true
    done
    
    # Setup filters (mark packets with iptables)
    setup_iptables
    
    ok "QoS setup complete"
}

setup_iptables() {
    info "Setting up iptables rules for traffic classification..."
    
    # Create custom chain for QoS
    iptables -N QOS_CHAIN 2>/dev/null || iptables -F QOS_CHAIN 2>/dev/null
    
    # Mark SSH traffic (port 22, 2222 for Arch)
    iptables -A QOS_CHAIN -p tcp --dport 22 -j MARK --set-mark 10 2>/dev/null || true
    iptables -A QOS_CHAIN -p tcp --dport 2222 -j MARK --set-mark 10 2>/dev/null || true
    
    # Mark DNS traffic
    iptables -A QOS_CHAIN -p udp --dport 53 -j MARK --set-mark 20 2>/dev/null || true
    
    # Mark HTTP/HTTPS traffic
    iptables -A QOS_CHAIN -p tcp --dport 80 -j MARK --set-mark 30 2>/dev/null || true
    iptables -A QOS_CHAIN -p tcp --dport 443 -j MARK --set-mark 30 2>/dev/null || true
    
    # Default mark
    iptables -A QOS_CHAIN -j MARK --set-mark 50 2>/dev/null || true
    
    # Add to OUTPUT chain
    iptables -C OUTPUT -j QOS_CHAIN 2>/dev/null || \
        iptables -A OUTPUT -j QOS_CHAIN 2>/dev/null || true
    
    # Setup tc filters to use marks
    tc filter add dev "$IFACE" parent 1: protocol ip handle 10 fw flowid 1:10 2>/dev/null || true
    tc filter add dev "$IFACE" parent 1: protocol ip handle 20 fw flowid 1:20 2>/dev/null || true
    tc filter add dev "$IFACE" parent 1: protocol ip handle 30 fw flowid 1:30 2>/dev/null || true
    tc filter add dev "$IFACE" parent 1: protocol ip handle 50 fw flowid 1:50 2>/dev/null || true
}

setup_iptables_only() {
    info "Using iptables-only mode (no tc available)"
    
    # Just set up basic traffic prioritization via iptables marks
    iptables -N QOS_CHAIN 2>/dev/null || iptables -F QOS_CHAIN 2>/dev/null
    
    # Mark packets for different treatment
    iptables -A QOS_CHAIN -p tcp --dport 22 -j TOS --set-tos 0x10 2>/dev/null || true
    iptables -A QOS_CHAIN -p tcp --dport 2222 -j TOS --set-tos 0x10 2>/dev/null || true
    iptables -A QOS_CHAIN -p udp --dport 53 -j TOS --set-tos 0x08 2>/dev/null || true
    
    iptables -C OUTPUT -j QOS_CHAIN 2>/dev/null || \
        iptables -A OUTPUT -j QOS_CHAIN 2>/dev/null || true
    
    ok "Iptables QoS setup complete (basic mode)"
}

# ── Chroot-Specific Rules ─────────────────────────────────

setup_chroot_qos() {
    local chroot_name="${1:-arch}"
    check_root || return 1
    
    info "Setting up QoS for $chroot_name chroot..."
    
    local chroot_path=""
    case "$chroot_name" in
        arch) chroot_path="/data/local/nhsystem/roots/archlinux" ;;
        kali) chroot_path="/data/local/nhsystem/roots/kali-arm64" ;;
        *)    chroot_path="$chroot_name" ;;
    esac
    
    [ -d "$chroot_path" ] || { err "Chroot not found: $chroot_name"; return 1; }
    
    # Get chroot IP (if using network namespace or similar)
    # This is a simplified version - actual implementation depends on chroot network setup
    
    # Example: Limit bandwidth for chroot processes
    # This requires cgroups or similar, which may not be available
    
    warn "Chroot QoS requires advanced network setup (not fully implemented)"
    info "Consider using containerization with network namespaces"
}

# ── Status & Monitoring ──────────────────────────────────

show_status() {
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo "  NH-QOS STATUS"
    echo "  Interface: $IFACE"
    echo "  Time: $(date)"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    
    # Check if QoS is active
    echo "── Traffic Control (tc) ──"
    if command -v tc >/dev/null 2>&1; then
        local qdisc
        qdisc=$(tc qdisc show dev "$IFACE" 2>/dev/null | head -5)
        if [ -n "$qdisc" ]; then
            ok "QoS active on $IFACE"
            echo "$qdisc" | sed 's/^/  /'
        else
            info "No QoS active on $IFACE"
        fi
    else
        warn "tc not available"
    fi
    
    echo ""
    
    # Check iptables rules
    echo "── Iptables Rules ──"
    if command -v iptables >/dev/null 2>&1; then
        local rules
        rules=$(iptables -L QOS_CHAIN -v 2>/dev/null | head -10)
        if [ -n "$rules" ]; then
            ok "QoS iptables rules active"
            echo "$rules" | sed 's/^/  /'
        else
            info "No QoS iptables rules found"
        fi
    else
        warn "iptables not available"
    fi
    
    echo ""
    
    # Show current traffic stats
    echo "── Traffic Statistics ──"
    if command -v tc >/dev/null 2>&1; then
        tc -s class show dev "$IFACE" 2>/dev/null | head -20 | sed 's/^/  /'
    else
        # Fallback to basic stats
        if command -v ifstat >/dev/null 2>&1; then
            ifstat -t 1 1 2>/dev/null | tail -1 | sed 's/^/  /'
        else
            cat /proc/net/dev 2>/dev/null | grep "$IFACE" | sed 's/^/  /'
        fi
    fi
}

# ── Bandwidth Limiting ──────────────────────────────────

limit_bandwidth() {
    local target="$1"
    local limit="$2"
    
    [ -z "$target" ] || [ -z "$limit" ] && { 
        err "Usage: nh-qos limit <target> <speed>"
        echo "Example: nh-qos limit arch 512kbit"
        return 1
    }
    
    check_root || return 1
    
    info "Limiting bandwidth for $target to $limit..."
    
    case "$target" in
        arch|kali)
            # Limit chroot traffic (requires advanced setup)
            warn "Per-chroot bandwidth limiting requires cgroups or network namespaces"
            warn "Not fully implemented yet"
            ;;
        global)
            # Limit overall outgoing bandwidth
            if command -v tc >/dev/null 2>&1; then
                tc class replace dev "$IFACE" parent 1:1 classid 1:1 \
                    htb rate "$limit" prio 1 2>/dev/null && \
                    ok "Global bandwidth limited to $limit" || \
                    warn "Failed to set bandwidth limit"
            else
                warn "tc not available"
            fi
            ;;
        *)
            err "Unknown target: $target (use 'arch', 'kali', or 'global')"
            return 1
            ;;
    esac
}

# ── Cleanup ──────────────────────────────────────

clear_qos() {
    check_root || return 1
    
    info "Clearing all QoS rules..."
    
    # Remove tc qdiscs
    if command -v tc >/dev/null 2>&1; then
        tc qdisc del dev "$IFACE" root 2>/dev/null || true
        ok "Traffic control rules cleared"
    fi
    
    # Remove iptables rules
    if command -v iptables >/dev/null 2>&1; then
        iptables -D OUTPUT -j QOS_CHAIN 2>/dev/null || true
        iptables -F QOS_CHAIN 2>/dev/null || true
        iptables -X QOS_CHAIN 2>/dev/null || true
        ok "Iptables rules cleared"
    fi
    
    ok "All QoS rules cleared"
}

# ── Usage ──────────────────────────────────────

usage() {
    cat <<EOF
nh-qos - Quality of Service & Traffic Shaping for Chroots

Usage: nh-qos <command> [options]

Setup:
  setup [iface]         Set up QoS (default interface: wlan0)
  clear                Clear all QoS rules
  restart             Restart QoS

Chroot Rules:
  chroot <name>        Set up QoS for specific chroot (arch/kali)
  limit <target> <spd> Limit bandwidth (target: arch/kali/global)

Status:
  status               Show QoS status and statistics
  stats                Show traffic statistics
  watch                Monitor traffic in real-time

Examples:
  nh-qos setup wlan0
  nh-qos status
  nh-qos limit global 1mbit
  nh-qos chroot arch

Configuration:
  Upload limit:   $UPLOAD_LIMIT
  Download limit: $DOWNLOAD_LIMIT
  SSH priority:  $SSH_PRIO (highest)
  DNS priority:  $DNS_PRIO
  Web priority:  $WEB_PRIO
  Default priority: $DEFAULT_PRIO (lowest)

Notes:
  - Requires root access
  - Requires iptables and tc (iproute2)
  - Chroot-specific rules require advanced network setup
  - Some features may not be available on all Android devices

Files:
  Config: $CONFIG_DIR/
  Data:   $DATA_DIR/
EOF
    exit 0
}

# ── Main ──────────────────────────────────────

[ $# -ge 1 ] || usage

case "$1" in
    setup)
        shift
        [ $# -ge 1 ] && IFACE="$1"
        setup_qos
        ;;
    clear)
        clear_qos
        ;;
    restart)
        clear_qos
        sleep 1
        setup_qos
        ;;
    chroot)
        shift
        setup_chroot_qos "$@"
        ;;
    limit)
        shift
        limit_bandwidth "$@"
        ;;
    status)
        show_status
        ;;
    stats)
        echo "── Traffic Statistics ──"
        if command -v tc >/dev/null 2>&1; then
            tc -s class show dev "$IFACE" 2>/dev/null
        else
            cat /proc/net/dev 2>/dev/null | grep "$IFACE"
        fi
        ;;
    watch)
        info "Monitoring traffic (Ctrl+C to stop)..."
        while true; do
            clear
            show_status
            sleep 2
        done
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        err "Unknown command: $1"
        usage
        ;;
esac
