#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P5
# nh-hash — File hashing tool
set -euo pipefail
show_usage() { cat <<EOF
nh-hash - File Hashing Tool
Usage: nh-hash {md5|sha1|sha256|sha512} <file>
EOF
}
algo="${1:-sha256}"; file="${2:-}"
[ -z "$file" ] && show_usage && exit 1
case "$algo" in
    md5) md5sum "$file" ;; sha1) sha1sum "$file" ;; sha256) sha256sum "$file" ;; sha512) sha512sum "$file" ;;
    *) show_usage ;;
esac
