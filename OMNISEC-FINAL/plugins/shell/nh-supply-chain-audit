#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P2
# nh-supply-chain-audit - Supply Chain Security Auditor
# Checks for Log4j, SolarWinds-style vulnerabilities
set -u

NHSYSTEM=${NHSYSTEM:-/data/local/nhsystem}
AUDIT_DIR="$NHSYSTEM/audit/supply-chain"
TEMP_DIR="/tmp/nh-supply-audit"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p "$AUDIT_DIR" "$TEMP_DIR"

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
err()   { printf "${RED}[ERR]${NC} %s\n" "$*" >&2; }

# ── Audit Node.js Project ──────────────────────────────

audit_nodejs() {
    local project_dir="$1"
    
    [ ! -d "$project_dir" ] && { err "Directory not found: $project_dir"; return 1; }
    [ ! -f "$project_dir/package.json" ] && { warn "Not a Node.js project"; return 1; }
    
    info "📦 Auditing Node.js project: $project_dir"
    
    cd "$project_dir" || return 1
    
    # npm audit
    info "Running npm audit..."
    npm audit --json > "$TEMP_DIR/npm-audit.json" 2>/dev/null || true
    
    # Check for known vulnerable packages
    info "Checking for Log4j-style vulnerabilities..."
    grep -r "log4j\|jndi\|ldap://" . 2>/dev/null | head -20 > "$TEMP_DIR/log4j-check.txt"
    
    # Check package.json for suspicious packages
    info "Analyzing dependencies..."
    cat package.json | python3 -c "
import json, sys
with open('$TEMP_DIR/deps.txt', 'w') as f:
    data = json.load(sys.stdin)
    for dep, version in data.get('dependencies', {}).items():
        f.write(f'{dep}: {version}\n')
    print('Dependencies analyzed')
" 2>/dev/null || warn "Python analysis failed"
    
    ok "Node.js audit complete"
}

# ── Audit Python Project ──────────────────────────────

audit_python() {
    local project_dir="$1"
    
    [ ! -d "$project_dir" ] && { err "Directory not found: $project_dir"; return 1; }
    
    info "🐍 Auditing Python project: $project_dir"
    
    cd "$project_dir" || return 1
    
    # pip-audit
    if command -v pip-audit >/dev/null 2>&1; then
        info "Running pip-audit..."
        pip-audit --format json > "$TEMP_DIR/pip-audit.json" 2>/dev/null || true
    else
        warn "pip-audit not found. Install: pip install pip-audit"
    fi
    
    # Check requirements.txt
    if [ -f "requirements.txt" ]; then
        info "Checking requirements.txt..."
        pip3 check -r requirements.txt > "$TEMP_DIR/pip-check.txt" 2>/dev/null || true
    fi
    
    ok "Python audit complete"
}

# ── Audit Rust Project ──────────────────────────────

audit_rust() {
    local project_dir="$1"
    
    [ ! -d "$project_dir" ] && { err "Directory not found: $project_dir"; return 1; }
    [ ! -f "$project_dir/Cargo.toml" ] && { warn "Not a Rust project"; return 1; }
    
    info "🦀 Auditing Rust project: $project_dir"
    
    cd "$project_dir" || return 1
    
    # cargo audit
    if command -v cargo-audit >/dev/null 2>&1; then
        info "Running cargo audit..."
        cargo audit --json > "$TEMP_DIR/cargo-audit.json" 2>/dev/null || true
    else
        warn "cargo-audit not found. Install: cargo install cargo-audit"
    fi
    
    ok "Rust audit complete"
}

# ── Generate SBOM ──────────────────────────────

generate_sbom() {
    local project_dir="$1"
    local sbom_file="$AUDIT_DIR/sbom-$(basename "$project_dir")-$(date +%Y%m%d).json"
    
    info "📄 Generating SBOM..."
    
    if command -v cyclonedx >/dev/null 2>&1; then
        cd "$project_dir" || return 1
        cyclonedx convert --output-format json --output-file "$sbom_file" 2>/dev/null || warn "CycloneDX failed"
        ok "SBOM generated: $sbom_file"
    else
        warn "CycloneDX not found. Install: npm install -g @cyclonedx/cdxgen"
        # Create basic SBOM
        cat > "$sbom_file" <<SBOM
{
  "bomFormatVersion": 1,
  "specVersion": "1.4",
  "serialNumber": "urn:uuid:$(uuidgen 2>/dev/null || echo 'unknown')",
  "version": 1,
  "components": []
}
SBOM
        warn "Basic SBOM created (install CycloneDX for full SBOM)"
    fi
}

# ── Usage ──────────────────────────────

usage() {
    cat <<EOF
nh-supply-chain-audit - Supply Chain Security Auditor

Usage: nh-supply-chain-audit <project_directory>

Checks for:
  - Log4j-style vulnerabilities
  - SolarWinds-style supply chain attacks
  - Known CVEs in dependencies
  - Generates SBOM (Software Bill of Materials)

Supported Project Types:
  - Node.js (package.json)
  - Python (requirements.txt)
  - Rust (Cargo.toml)

Examples:
  nh-supply-chain-audit /path/to/node-project
  nh-supply-chain-audit /path/to/python-project
  nh-supply-chain-audit /path/to/rust-project

Output:
  - Audit results in: $AUDIT_DIR/
  - SBOM file: $AUDIT_DIR/sbom-*.json

Requirements:
  - npm audit (Node.js)
  - pip-audit (Python)
  - cargo-audit (Rust)
  - CycloneDX (SBOM generation)

Notes:
  - Trending: Supply chain attacks are #1 fear
  - Required by US Executive Order
  - Generates SBOM automatically
EOF
}

# ── Main ──────────────────────────────

[ $# -ge 1 ] || usage

project_dir="${1:-.}"

# Detect project type and audit
if [ -f "$project_dir/package.json" ]; then
    audit_nodejs "$project_dir"
    generate_sbom "$project_dir"
elif [ -f "$project_dir/requirements.txt" ] || [ -f "$project_dir/setup.py" ]; then
    audit_python "$project_dir"
    generate_sbom "$project_dir"
elif [ -f "$project_dir/Cargo.toml" ]; then
    audit_rust "$project_dir"
    generate_sbom "$project_dir"
else
    err "Unknown project type in: $project_dir"
    usage
    exit 1
fi

ok "✅ Supply chain audit complete!"
warn "Check results in: $AUDIT_DIR/"
