#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P2
# nh-honeypot - Lightweight honeypot and intrusion detection system
# Performance: non-blocking, efficient logging, minimal resource usage
set -u

NHSYSTEM=${NHSYSTEM:-/data/local/nhsystem}
HONEYPOT_DIR="$NHSYSTEM/honeypot"
CONFIG_DIR="$NHSYSTEM/etc/honeypot"
LOG_DIR="$NHSYSTEM/logs/honeypot"
PID_DIR="$HONEYPOT_DIR/pids"

# Default ports to monitor (fake services)
SSH_PORT=2222      # Fake SSH (different from real SSH)
HTTP_PORT=8080     # Fake HTTP
TELNET_PORT=2323  # Fake Telnet
MYSQL_PORT=3306    # Fake MySQL

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Ensure directories
mkdir -p "$HONEYPOT_DIR" "$CONFIG_DIR" "$LOG_DIR" "$PID_DIR"

# ── Utility Functions ───────────────────────────────────────────────

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
err()   { printf "${RED}[ERR]${NC} %s\n" "$*" >&2; }
debug() { [ "${DEBUG:-0}" = "1" ] && printf "${CYAN}[DBG]${NC} %s\n" "$*" || true; }

log_attack() {
    local service="$1"
    local src_ip="$2"
    local src_port="$3"
    local timestamp
    timestamp=$(date +'%Y-%m-%d %H:%M:%S')
    
    echo "[$timestamp] ATTACK service=$service src=$src_ip:$src_port" >> "$LOG_DIR/attacks.log"
    
    # Check for blacklist
    if grep -q "^$src_ip$" "$CONFIG_DIR/blacklist.txt" 2>/dev/null; then
        debug "  IP already blacklisted: $src_ip"
    else
        # Count attacks from this IP
        local count
        count=$(grep -c "$src_ip" "$LOG_DIR/attacks.log" 2>/dev/null || echo 0)
        if [ "$count" -ge "${AUTO_BLACKLIST_THRESHOLD:-5}" ]; then
            echo "$src_ip" >> "$CONFIG_DIR/blacklist.txt"
            warn "Auto-blacklisted: $src_ip (count: $count)"
            # Send notification
            send_alert "BLACKLIST" "IP auto-blacklisted: $src_ip (count: $count)"
        fi
    fi
    
    # GeoIP lookup (if available)
    if command -v geoiplookup >/dev/null 2>&1; then
        local geo
        geo=$(geoiplookup "$src_ip" 2>/dev/null | head -1)
        debug "  GeoIP: $geo"
    fi
}

send_alert() {
    local type="$1"
    local msg="$2"
    local timestamp
    timestamp=$(date +'%Y-%m-%d %H:%M:%S')
    
    echo "[$timestamp] ALERT type=$type msg=$msg" >> "$LOG_DIR/alerts.log"
    
    # Try Android notification (if available)
    am broadcast -a android.intent.action.HONEYPOT_ALERT \
        --es type "$type" --es msg "$msg" >/dev/null 2>&1 || true
}

# ── Fake Service Emulation ─────────────────────────────────────────

start_fake_ssh() {
    local port="${1:-$SSH_PORT}"
    info "Starting fake SSH on port $port..."
    
    while true; do
        # Use nc to listen (more portable than specialied tools)
        # This is a very simple emulation
        {
            echo "SSH-2.0-OpenSSH_7.9p1 Debian-10+deb9u2"
            while IFS= read -r line; do
                # Log the attempt
                local src
                src=$(echo "$line" | grep -oP '(?<=from )[0-9.]+' || echo "unknown")
                log_attack "ssh" "$src" "unknown"
                echo "Permission denied (publickey,password)."
            done
        } | nc -l -p "$port" -q 1 -w 30 2>/dev/null
        
        # Small delay to prevent CPU spinning
        sleep 0.5
    done &
    
    local pid=$!
    echo "$pid" > "$PID_DIR/fake_ssh.pid"
    ok "Fake SSH started (PID: $pid)"
}

start_fake_http() {
    local port="${1:-$HTTP_PORT}"
    info "Starting fake HTTP on port $port..."
    
    while true; do
        # Simple HTTP server that logs and returns fake response
        {
            read -r request
            local src
            src=$(echo "$request" | grep -oP 'from \K[0-9.]+' || echo "unknown")
            log_attack "http" "$src" "unknown"
            
            # Return fake response
            cat <<'HTTP_RESPONSE'
HTTP/1.1 200 OK
Server: Apache/2.4.25 (Debian)
Content-Type: text/html

<html>
<head><title>403 Forbidden</title></head>
<body><h1>Forbidden</h1></body>
</html>
HTTP_RESPONSE
        } | nc -l -p "$port" -q 1 -w 30 2>/dev/null
        
        sleep 0.5
    done &
    
    local pid=$!
    echo "$pid" > "$PID_DIR/fake_http.pid"
    ok "Fake HTTP started (PID: $pid)"
}

start_fake_telnet() {
    local port="${1:-$TELNET_PORT}"
    info "Starting fake Telnet on port $port..."
    
    while true; do
        {
            echo "Ubuntu 18.04 LTS"
            echo "login:"
            read -r username
            echo "Password:"
            read -r password
            log_attack "telnet" "unknown" "unknown"
            echo "Login incorrect"
        } | nc -l -p "$port" -q 1 -w 30 2>/dev/null
        
        sleep 0.5
    done &
    
    local pid=$!
    echo "$pid" > "$PID_DIR/fake_telnet.pid"
    ok "Fake Telnet started (PID: $pid)"
}

# ── Network Monitoring (Alternative to fake services) ───────────────

start_monitor() {
    info "Starting network monitor (detects port scans and attacks)..."
    
    # Use tcpdump or similar to monitor for connection attempts
    if command -v tcpdump >/dev/null 2>&1; then
        tcpdump -i any -n 'tcp[tcp flags] & (tcp-syn) != 0' 2>/dev/null | \
        while IFS= read -r line; do
            # Parse tcpdump output for connection attempts
            local src_ip
            src_ip=$(echo "$line" | grep -oP '\d+\.\d+\.\d+\.\d+' | head -1)
            [ -z "$src_ip" ] && continue
            
            # Check if it's a whitelisted IP
            grep -q "^$src_ip$" "$CONFIG_DIR/whitelist.txt" 2>/dev/null && continue
            
            log_attack "monitor" "$src_ip" "unknown"
            debug "  Connection attempt from: $src_ip"
        done &
        
        local pid=$!
        echo "$pid" > "$PID_DIR/monitor.pid"
        ok "Network monitor started (PID: $pid)"
    else
        warn "tcpdump not available, monitor mode limited"
    fi
}

# ── Honeypot Control ──────────────────────────────────────────────

cmd_start() {
    info "Starting honeypot services..."
    
    # Check if already running
    if [ -f "$PID_DIR/fake_ssh.pid" ] && kill -0 "$(cat "$PID_DIR/fake_ssh.pid")" 2>/dev/null; then
        warn "Honeypot already running"
        return 1
    fi
    
    # Start services
    start_fake_ssh "$SSH_PORT"
    start_fake_http "$HTTP_PORT"
    start_fake_telnet "$TELNET_PORT"
    start_monitor
    
    # Create status file
    cat > "$HONEYPOT_DIR/status.txt" <<STATS
START_TIME=$(date +%s)
SSH_PORT=$SSH_PORT
HTTP_PORT=$HTTP_PORT
TELNET_PORT=$TELNET_PORT
STATS
    
    ok "Honeypot started"
    info "Logs: $LOG_DIR/"
    info "PIDs: $PID_DIR/"
}

cmd_stop() {
    info "Stopping honeypot services..."
    
    local stopped=0
    for pid_file in "$PID_DIR"/*.pid; do
        [ -f "$pid_file" ] || continue
        local pid
        pid=$(cat "$pid_file" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            rm -f "$pid_file"
            stopped=$((stopped + 1))
        fi
    done
    
    if [ "$stopped" -gt 0 ]; then
        ok "Stopped $stopped services"
    else
        info "No running services found"
    fi
}

cmd_status() {
    echo ""
    echo "═════════════════════════════════════════════════════════════"
    echo "  NH-HONEYPOT STATUS"
    echo "  Time: $(date)"
    echo "═════════════════════════════════════════════════════════════"
    echo ""
    
    # Check running services
    echo "── Services ──"
    local services="fake_ssh fake_http fake_telnet monitor"
    for svc in $services; do
        local pid_file="$PID_DIR/${svc}.pid"
        if [ -f "$pid_file" ]; then
            local pid
            pid=$(cat "$pid_file")
            if kill -0 "$pid" 2>/dev/null; then
                ok "$svc: running (PID: $pid)"
            else
                warn "$svc: NOT running (stale PID file)"
            fi
        else
            warn "$svc: NOT running"
        fi
    done
    
    echo ""
    
    # Statistics
    echo "── Statistics ──"
    if [ -f "$LOG_DIR/attacks.log" ]; then
        local total_attacks
        total_attacks=$(wc -l < "$LOG_DIR/attacks.log")
        echo "  Total attacks logged: $total_attacks"
        
        local recent
        recent=$(grep "$(date +%Y-%m-%d)" "$LOG_DIR/attacks.log" 2>/dev/null | wc -l)
        echo "  Attacks today: $recent"
        
        echo ""
        echo "  Top attacking services:"
        grep -o "service=[^ ]*" "$LOG_DIR/attacks.log" 2>/dev/null | \
            sort | uniq -c | sort -rn | head -5 | \
            while read -r count svc; do
                echo "    $svc: $count attempts"
            done
        
        echo ""
        echo "  Top attacking IPs:"
        grep -o "src=[^:]*" "$LOG_DIR/attacks.log" 2>/dev/null | \
            sort | uniq -c | sort -rn | head -5 | \
            while read -r count ip; do
                echo "    $ip: $count attempts"
            done
    else
        info "No attacks logged yet"
    fi
    
    echo ""
    
    # Blacklist
    echo "── Blacklist ──"
    if [ -f "$CONFIG_DIR/blacklist.txt" ]; then
        local bl_count
        bl_count=$(wc -l < "$CONFIG_DIR/blacklist.txt")
        echo "  Blacklisted IPs: $bl_count"
        [ "$bl_count" -gt 0 ] && head -5 "$CONFIG_DIR/blacklist.txt" | \
            while read -r ip; do echo "    $ip"; done
    else
        info "No blacklisted IPs"
    fi
    
    echo ""
}

cmd_logs() {
    local lines="${1:-50}"
    echo "── Recent Attacks (last $lines) ──"
    if [ -f "$LOG_DIR/attacks.log" ]; then
        tail -n "$lines" "$LOG_DIR/attacks.log"
    else
        info "No attack logs found"
    fi
}

cmd_blacklist() {
    local action="${1:-list}"
    shift 2>/dev/null || true
    
    case "$action" in
        list)
            echo "── Blacklisted IPs ──"
            if [ -f "$CONFIG_DIR/blacklist.txt" ]; then
                cat "$CONFIG_DIR/blacklist.txt" | nl
            else
                info "No blacklisted IPs"
            fi
            ;;
        add)
            local ip="$1"
            [ -n "$ip" ] || { err "Usage: nh-honeypot blacklist add <ip>"; return 1; }
            echo "$ip" >> "$CONFIG_DIR/blacklist.txt"
            ok "Added to blacklist: $ip"
            ;;
        remove|del)
            local ip="$1"
            [ -n "$ip" ] || { err "Usage: nh-honeypot blacklist remove <ip>"; return 1; }
            if [ -f "$CONFIG_DIR/blacklist.txt" ]; then
                grep -v "^$ip$" "$CONFIG_DIR/blacklist.txt" > "${CONFIG_DIR}/blacklist.txt.tmp"
                mv "${CONFIG_DIR}/blacklist.txt.tmp" "$CONFIG_DIR/blacklist.txt"
                ok "Removed from blacklist: $ip"
            fi
            ;;
        clear)
            > "$CONFIG_DIR/blacklist.txt"
            ok "Blacklist cleared"
            ;;
        *)
            err "Unknown action: $action"
            echo "Usage: nh-honeypot blacklist [list|add|remove|clear]"
            ;;
    esac
}

cmd_whitelist() {
    local action="${1:-list}"
    shift 2>/dev/null || true
    
    case "$action" in
        list)
            echo "── Whitelisted IPs ──"
            if [ -f "$CONFIG_DIR/whitelist.txt" ]; then
                cat "$CONFIG_DIR/whitelist.txt" | nl
            else
                info "No whitelisted IPs (create $CONFIG_DIR/whitelist.txt)"
            fi
            ;;
        add)
            local ip="$1"
            [ -n "$ip" ] || { err "Usage: nh-honeypot whitelist add <ip>"; return 1; }
            echo "$ip" >> "$CONFIG_DIR/whitelist.txt"
            ok "Added to whitelist: $ip"
            ;;
        remove|del)
            local ip="$1"
            [ -n "$ip" ] || { err "Usage: nh-honeypot whitelist remove <ip>"; return 1; }
            if [ -f "$CONFIG_DIR/whitelist.txt" ]; then
                grep -v "^$ip$" "$CONFIG_DIR/whitelist.txt" > "${CONFIG_DIR}/whitelist.txt.tmp"
                mv "${CONFIG_DIR}/whitelist.txt.tmp" "$CONFIG_DIR/whitelist.txt"
                ok "Removed from whitelist: $ip"
            fi
            ;;
        *)
            err "Unknown action: $action"
            echo "Usage: nh-honeypot whitelist [list|add|remove]"
            ;;
    esac
}

cmd_clear_logs() {
    info "Clearing honeypot logs..."
    rm -f "$LOG_DIR"/*.log 2>/dev/null
    ok "Logs cleared"
}

# ── Usage ──────────────────────────────────────────────────────────

usage() {
    cat <<EOF
nh-honeypot - Lightweight Intrusion Detection & Honeypot

Usage: nh-honeypot <command> [options]

Control:
  start               Start honeypot services
  stop                Stop honeypot services
  restart             Restart honeypot services
  status              Show honeypot status and statistics

Monitoring:
  logs [lines]       Show recent attack logs (default: 50)
  watch               Monitor attacks in real-time
  alerts              Show recent alerts

Blacklist:
  blacklist [action] Manage blacklisted IPs
    list              List blacklisted IPs
    add <ip>          Add IP to blacklist
    remove <ip>       Remove IP from blacklist
    clear             Clear blacklist

Whitelist:
  whitelist [action] Manage whitelisted IPs
    list              List whitelisted IPs
    add <ip>          Add IP to whitelist
    remove <ip>       Remove IP from whitelist

Maintenance:
  clear-logs         Clear all logs
  config              Show/edit configuration

Examples:
  nh-honeypot start
  nh-honeypot status
  nh-honeypot blacklist add 192.168.1.100
  nh-honeypot logs 100

Configuration:
  Config dir: $CONFIG_DIR/
  Log dir:    $LOG_DIR/
  PIDs:       $PID_DIR/

Note: Requires nc (netcat) for fake services
Setup: Ensure netcat is installed in chroot or on device
EOF
    exit 0
}

# ── Main ─────────────────────────────────────────────────────────────

[ $# -ge 1 ] || usage

case "$1" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_stop
        sleep 1
        cmd_start
        ;;
    status)
        cmd_status
        ;;
    logs)
        shift
        cmd_logs "${1:-50}"
        ;;
    watch)
        info "Watching attacks in real-time (Ctrl+C to stop)..."
        tail -f "$LOG_DIR/attacks.log" 2>/dev/null || warn "No log file yet"
        ;;
    alerts)
        echo "── Recent Alerts ──"
        if [ -f "$LOG_DIR/alerts.log" ]; then
            tail -20 "$LOG_DIR/alerts.log"
        else
            info "No alerts"
        fi
        ;;
    blacklist)
        shift
        cmd_blacklist "$@"
        ;;
    whitelist)
        shift
        cmd_whitelist "$@"
        ;;
    clear-logs)
        cmd_clear_logs
        ;;
    config)
        info "Configuration directory: $CONFIG_DIR"
        ls -la "$CONFIG_DIR/" 2>/dev/null || { warn "No config files yet"; exit 0; }
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        err "Unknown command: $1"
        usage
        ;;
esac
