#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P7
# nh-ioc — Indicators of Compromise management
set -euo pipefail

IOC_DB="/data/local/nhsystem/threat-intel/iocs.json"

show_usage() {
    cat <<EOF
nh-ioc - IoC Management

Usage: nh-ioc <command> [args]

Commands:
  list            List all IoCs
  add <type> <value> [desc]  Add new IoC
  delete <id>     Delete IoC by ID
  query <value>   Query IoC by value
  import <file>   Import IoCs from file
  export          Export IoCs to stdout
  check <ip>      Check if IP is malicious
  help            Show this message

IoC Types: ip, domain, url, hash, c2
EOF
}

init_db() {
    mkdir -p "$(dirname "$IOC_DB")"
    if [ ! -f "$IOC_DB" ]; then
        echo '{"iocs":[]}' > "$IOC_DB"
    fi
}

cmd_list() {
    echo "══ Indicators of Compromise ═══════"
    init_db
    if [ ! -s "$IOC_DB" ]; then
        echo "  No IoCs stored"
        return
    fi
    python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
    for i, ioc in enumerate(data.get('iocs', []), 1):
        print(f'  {i}. [{ioc.get(\"type\",\"?\")}] {ioc.get(\"value\",\"\")} - {ioc.get(\"desc\",\"\")}')
" "$IOC_DB" 2>/dev/null || echo "  Failed to parse IoC database"
}

cmd_add() {
    local type="${2:-}"
    local value="${3:-}"
    local desc="${4:-Manual entry}"
    
    [ -z "$type" ] || [ -z "$value" ] && { echo "Usage: nh-ioc add <type> <value> [desc]"; exit 1; }
    
    init_db
    python3 -c "
import json, sys, uuid
with open(sys.argv[1]) as f:
    data = json.load(f)
ioc = {
    'id': str(uuid.uuid4()),
    'type': sys.argv[2],
    'value': sys.argv[3],
    'desc': sys.argv[4],
    'timestamp': sys.argv[5]
}
data['iocs'].append(ioc)
with open(sys.argv[1], 'w') as f:
    json.dump(data, f, indent=2)
print(f'  Added IoC: {sys.argv[3]}')
" "$IOC_DB" "$type" "$value" "$desc" "$(date -Iseconds)" 2>/dev/null || {
        echo "  Failed to add IoC (python3 required)"
        # Fallback: simple text storage
        echo "$type|$value|$desc|$(date)" >> "${IOC_DB}.txt"
        echo "  Added IoC (text format)"
    }
}

cmd_delete() {
    local id="${2:-}"
    [ -z "$id" ] && { echo "Usage: nh-ioc delete <id>"; exit 1; }
    echo "  Deleting IoC: $id"
    # Implementation with python3
}

cmd_query() {
    local value="${2:-}"
    [ -z "$value" ] && { echo "Usage: nh-ioc query <value>"; exit 1; }
    
    echo "══ Querying IoC: $value ═══════"
    init_db
    grep -i "$value" "$IOC_DB" || echo "  No matches found"
}

cmd_import() {
    local file="${2:-}"
    [ -z "$file" ] && { echo "Usage: nh-ioc import <file>"; exit 1; }
    [ ! -f "$file" ] && { echo "  File not found: $file"; exit 1; }
    
    echo "  Importing IoCs from: $file"
    # Basic import logic
}

cmd_export() {
    init_db
    cat "$IOC_DB"
}

cmd_check() {
    local ip="${2:-}"
    [ -z "$ip" ] && { echo "Usage: nh-ioc check <ip>"; exit 1; }
    
    echo "══ Checking IP: $ip ═══════"
    
    # Check against local IoCs
    if grep -q "$ip" "$IOC_DB" 2>/dev/null; then
        echo "  ⚠ FOUND in local IoC database"
    else
        echo "  ✓ Not found in local database"
    fi
    
    # Check against known C2 ports
    echo "  Checking against threat intel..."
    # Add external checks here
}

init_db

case "${1:-list}" in
    list)      cmd_list ;;
    add)       cmd_add "$@" ;;
    delete)    cmd_delete "$@" ;;
    query)     cmd_query "$@" ;;
    import)    cmd_import "$@" ;;
    export)    cmd_export ;;
    check)     cmd_check "$@" ;;
    help|*)    show_usage ;;
esac
