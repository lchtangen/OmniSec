# Aegis Nexus Multi-Arch Docker Image
# Supports: ARM64, x86_64

FROM --platform=linux/arm64 ubuntu:24.04

LABEL maintainer="Aegis Nexus <team@aegis-nexus.org>"
LABEL description="Next-Gen Mobile Security Platform with AI, Mesh, eBPF, PQ Crypto"

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install base dependencies
RUN apt-get update && apt-get install -y \
    bash \
    git \
    make \
    gcc \
    python3 \
    python3-pip \
    curl \
    wget \
    openssh-client \
    openssl \
    iproute2 \
    iputils-ping \
    net-tools \
    iputils-tracepath \
    tcpdump \
    nmap \
    && rm -rf /var/lib/apt/lists/*

# Install Aegis Nexus
WORKDIR /opt/aegis-nexus
RUN git clone https://github.com/AegisNexus/aegis-nexus.git .
RUN make stage
RUN make build-c

# Install AI dependencies (optional)
RUN pip3 install --no-cache-dir \
    llama-cpp-python \
    requests \
    py-compile

# Set up environment
ENV PATH="/opt/aegis-nexus:${PATH}"
ENV PYTHONPATH="/opt/aegis-nexus/src/device/ai:${PYTHONPATH}"

# Create volume for data
VOLUME ["/data/aegis-nexus"]

WORKDIR /data/aegis-nexus

# Default command
CMD ["/opt/aegis-nexus/nhctl", "help"]

# Expose web console port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD nhctl status || exit 1
