# NH_KERNEL_VERSION: 2.0.0
# NetHunter NextGen Kernel Config — OnePlus 7 Pro (guacamole)
# Reference: LineageOS android_kernel_oneplus_sm8150
# Base kernel: 4.14.356-openela
# Android: 16, LineageOS: 23.2, Variant: nethunter
#
# This is a reference overlay. For full matrix builds, use:
#   ./build-kernel.sh build guacamole nethunter
#   ./build-kernel.sh build guacamole performance
#   ./build-kernel.sh build guacamole battery
#
# The build system merges config fragments from configs/fragments/
# with the stock LineageOS defconfig.
#
# Fragment order for nethunter variant:
#   base → containers → security → nethunter → performance

# Stock defconfig to build on
CONFIG_LINEAGEOS_GUACAMOLE_DEFCONFIG=y

# ── Branding ───────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-nethunter-nextgen-v2.0"
CONFIG_LOCALVERSION_AUTO=n

# ── Android Compatibility ──────────────────────────────────────────
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ── Netfilter / iptables ───────────────────────────────────────────
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_WEBURL=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# ── USB Gadget (HID injection, RNDIS, ACM) ─────────────────────────
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_G_HID=y

# ── External Wi-Fi Adapters ────────────────────────────────────────
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT73USB=m
CONFIG_RTL8187=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# ── Bluetooth ──────────────────────────────────────────────────────
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HIDP=y

# ── Container Support ──────────────────────────────────────────────
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y

# ── Filesystems ────────────────────────────────────────────────────
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BTRFS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y

# ── Performance ────────────────────────────────────────────────────
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_CAKE=m

# ── Security ───────────────────────────────────────────────────────
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_DISABLE=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_SELINUX=y

# ── Debug (development only) ───────────────────────────────────────
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x01
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_INFO=y

# ── Required for chroot compatibility ──────────────────────────────
CONFIG_COMPAT=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
