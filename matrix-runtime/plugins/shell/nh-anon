#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P2
# nh-anon - Anonymity toolkit: Tor, I2P, proxychains, traffic obfuscation
set -u

NHSYSTEM=/data/local/nhsystem
ANON_DIR=$NHSYSTEM/etc/anon
ANON_LOG=$NHSYSTEM/logs/anon.log
NHWORK=$NHSYSTEM/workspaces/main

ensure_dirs() { mkdir -p "$ANON_DIR" "$NHSYSTEM/logs"; }
log() { echo "[$(date '+%H:%M:%S')] $*" >> "$ANON_LOG"; }

tor_setup() {
    echo "── Tor Setup ──"
    local root="$NHSYSTEM/roots/archlinux"
    [ -d "$root" ] || { echo "  Arch chroot required"; return 1; }

    if [ ! -x "$root/usr/bin/tor" ]; then
        echo "  Installing Tor in Arch chroot..."
        chroot_exec "$root" /bin/sh -c 'pacman -S --noconfirm tor torsocks 2>/dev/null' && echo "  Tor installed" || echo "  Tor install failed"
    fi

    # Torrc configuration
    local torrc="$root/etc/tor/torrc"
    mkdir -p "$root/etc/tor"
    local orport="${TOR_ORPORT:-9001}"
    local dirport="${TOR_DIRPORT:-9030}"

    cat > "$torrc" <<TORRC
## Tor configuration - Generated by nh-anon
User tor
DataDirectory /var/lib/tor
PidFile /run/tor/tor.pid

## SOCKS proxy
SOCKSPort 0.0.0.0:9050
SOCKSPolicy accept 127.0.0.0/8
SOCKSPolicy accept 10.0.0.0/8
SOCKSPolicy reject *

## Relay/bridge config
ORPort $orport
# DirPort $dirport
BridgeRelay 0

## Logging
Log notice file /var/log/tor/notices.log
Log warn file /var/log/tor/warnings.log

## Security
CircuitBuildTimeout 60
LearnCircuitBuildTimeout 0
MaxCircuitDirtiness 600
UseEntryGuards 1
NumEntryGuards 3
SafeSocks 1
TestSocks 1
HardwareAccel 1

## Disable DNS
DNSPort 0
AutomapHostsOnResolve 0
TORRC
    echo "  Tor configured"
    echo "  SOCKS5: 127.0.0.1:9050"

    # Setup torsocks
    local torsocks_conf="$root/etc/torsocks/torsocks.conf"
    mkdir -p "$root/etc/torsocks" 2>/dev/null
    cat > "$torsocks_conf" <<TORSOCKS
# Tor SOCKS configuration
TorAddress 127.0.0.1
TorPort 9050
OnionAddrRange 127.42.42.0/24
AllowInbound 0
TORSOCKS

    echo "  torsocks configured"
    echo ""
    echo "  Usage:"
    echo "    nh-anon tor start     - Start Tor daemon"
    echo "    nh-anon tor stop      - Stop Tor"
    echo "    nh-anon tor status    - Check Tor status"
    echo "    torsocks curl http://check.torproject.org"
    log "Tor setup complete"
}

tor_start() {
    local root="$NHSYSTEM/roots/archlinux"
    [ -d "$root" ] || { echo "  Arch chroot not found"; return 1; }

    if [ -f "$root/run/tor/tor.pid" ] && kill -0 $(cat "$root/run/tor/tor.pid") 2>/dev/null; then
        echo "  Tor already running (PID $(cat $root/run/tor/tor.pid))"
        return 0
    fi

    nh-mount arch 2>/dev/null || nh-mount 2>/dev/null

    chroot_exec "$root" /bin/sh -c '
        mkdir -p /run/tor /var/log/tor /var/lib/tor
        chown -R tor:tor /run/tor /var/log/tor /var/lib/tor 2>/dev/null || true
        chmod 700 /var/lib/tor 2>/dev/null || true
        tor -f /etc/tor/torrc --RunAsDaemon 1 2>/dev/null
        sleep 2
        pgrep -x tor >/dev/null && echo "Tor started" || echo "Tor failed to start"
    ' 2>/dev/null

    if [ -f "$root/run/tor/tor.pid" ]; then
        echo "  Tor PID: $(cat $root/run/tor/tor.pid)"
        echo "  SOCKS5: 127.0.0.1:9050"
        log "Tor started"
    else
        echo "  Tor start failed. Check: $root/var/log/tor/warnings.log"
    fi
}

tor_stop() {
    local root="$NHSYSTEM/roots/archlinux"
    [ -f "$root/run/tor/tor.pid" ] && {
        kill $(cat "$root/run/tor/tor.pid") 2>/dev/null
        rm -f "$root/run/tor/tor.pid"
        echo "  Tor stopped"
        log "Tor stopped"
    } || echo "  Tor not running"
}

tor_status() {
    local root="$NHSYSTEM/roots/archlinux"
    echo "── Tor Status ──"
    echo ""

    if [ -f "$root/run/tor/tor.pid" ] && kill -0 $(cat "$root/run/tor/tor.pid") 2>/dev/null; then
        local pid=$(cat "$root/run/tor/tor.pid")
        echo "  Status: RUNNING (PID $pid)"
        echo "  SOCKS:  127.0.0.1:9050"
        echo "  Uptime: $(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ' || echo '?')"

        # Test Tor connectivity
        if command -v curl >/dev/null 2>&1; then
            local ip=$(curl -s --socks5 127.0.0.1:9050 --connect-timeout 5 "http://check.torproject.org" 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1 || echo "")
            [ -n "$ip" ] && echo "  Exit IP: $ip" || echo "  Exit IP: (checking...)"
        fi
    else
        echo "  Status: STOPPED"
        echo "  Start: nh-anon tor start"
    fi
}

tor_check_ip() {
    echo "── IP / Leak Check ──"
    echo ""

    local direct_ip=$(curl -s --connect-timeout 5 "https://api.ipify.org" 2>/dev/null || echo "(timeout)")
    local tor_ip=""
    if [ -f "$NHSYSTEM/roots/archlinux/run/tor/tor.pid" ]; then
        tor_ip=$(curl -s --socks5 127.0.0.1:9050 --connect-timeout 10 "https://api.ipify.org" 2>/dev/null || echo "(timeout)")
    fi

    echo "  Direct IP:  $direct_ip"
    [ -n "$tor_ip" ] && echo "  Tor IP:     $tor_ip"

    if [ -n "$tor_ip" ] && [ "$tor_ip" != "$direct_ip" ]; then
        echo "  Status: ANONYMIZED (IPs differ)"
    elif [ -n "$tor_ip" ]; then
        echo "  Status: LEAK (same IP through Tor)"
    else
        echo "  Status: DIRECT (no Tor)"
    fi
    echo ""
    echo "  DNS leak test:"
    curl -s --connect-timeout 5 "https://ipleak.net/json/" 2>/dev/null | grep -o '"dns":[^,]*' | head -1 || echo "    (test unavailable)"
}

i2p_setup() {
    echo "── I2P Setup ──"
    local root="$NHSYSTEM/roots/archlinux"
    [ -d "$root" ] || { echo "  Arch chroot required"; return 1; }

    if [ ! -x "$root/usr/bin/i2prouter" ]; then
        echo "  Installing I2P..."
        chroot_exec "$root" /bin/sh -c 'pacman -S --noconfirm i2p 2>/dev/null' && echo "  I2P installed" || echo "  I2P install failed"
    fi

    echo "  I2P HTTP proxy: 127.0.0.1:4444"
    echo "  I2P SOCKS:     127.0.0.1:4445"
    echo "  I2P console:   http://127.0.0.1:7657"
    echo ""
    echo "  Start: i2prouter start (inside chroot)"
}

proxychains_usage() {
    echo "── ProxyChains Usage ──"
    echo ""
    echo "  proxychains4 makes any app route through Tor"
    echo ""
    echo "  Basic usage:"
    echo "    proxychains4 curl http://check.torproject.org"
    echo "    proxychains4 nmap -sT -Pn 185.130.5.1"
    echo "    proxychains4 wget http://example.com"
    echo "    proxychains4 ssh user@host"
    echo ""
    echo "  Config file:"
    echo "    $NHSYSTEM/etc/privacy/proxychains.conf"
    echo "    (configure via: nh-privacy proxy)"
    echo ""
    echo "  Dynamic chain (random proxy per request):"
    echo "    nh-privacy proxy (choose option 4)"
    echo "    proxychains4 -f /path/to/dynamic.conf <cmd>"
    echo ""
    echo "  Note: Some apps leak DNS/IP. Use Tor Browser for safety."
    echo "  Verify: nh-anon checkip"
}

obfuscation_setup() {
    echo "── Traffic Obfuscation ──"
    echo ""

    # Obfsproxy
    local root="$NHSYSTEM/roots/archlinux"
    if [ -d "$root" ]; then
        if ! [ -x "$root/usr/bin/obfsproxy" ] && ! [ -x "$root/usr/bin/obfs4proxy" ]; then
            echo "  Installing obfs4proxy..."
            chroot_exec "$root" /bin/sh -c 'pacman -S --noconfirm obfs4proxy 2>/dev/null' && echo "  obfs4proxy installed" || echo "  obfs4proxy install failed"
        fi
    fi

    echo "  Obfuscation methods available:"
    echo ""
    echo "  1. obfs4 (Tor bridge with obfuscation)"
    echo "     Bridge obfs4 <IP>:<PORT> <FINGERPRINT> cert=<CERT> iat-mode=0"
    echo ""
    echo "  2. Shadowsocks (SOCKS5 proxy with encryption)"
    echo "     sslocal -s <server> -p 8388 -k password -m aes-256-gcm"
    echo ""
    echo "  3. SSH tunnel (encrypted tunnel)"
    echo "     ssh -D 1080 user@host  (dynamic SOCKS proxy)"
    echo ""
    echo "  4. VPN over WebSocket"
    echo "     trojan-go / v2ray / xray"
    echo ""
    echo "  Configure in Arch chroot:"
    echo "    pacman -S obfs4proxy shadowsocks-libev trojan-go"
}

anonymize_hostname() {
    echo "── Anonymizing Hostname ──"
    local current=$(getprop net.hostname 2>/dev/null || uname -n 2>/dev/null || echo "android")
    local new="${1:-android-$(openssl rand -hex 4 2>/dev/null || echo "$(date +%N | md5sum | head -c 8)")}"

    echo "  Current: $current"
    echo "  New:     $new"
    echo ""

    if [ "$(id -u)" = "0" ]; then
        hostname "$new" 2>/dev/null && echo "  Hostname changed (runtime)"
        setprop net.hostname "$new" 2>/dev/null && echo "  net.hostname updated"
        echo "$new" > /proc/sys/kernel/hostname 2>/dev/null || true
        echo "  Note: Android may revert hostname on reboot"
    else
        echo "  Root required for hostname change"
    fi
    log "Hostname: $current -> $new"
}

usage() {
    cat <<EOF
nh-anon - Anonymity and anti-censorship toolkit

Usage: nh-anon <command> [args]

Commands:
  tor-setup            Install and configure Tor
  tor start|stop|status Control Tor daemon
  checkip              Check IP and DNS leaks
  i2p                  Setup I2P network
  proxychains          Guide: using proxychains4
  obfuscate            Configure traffic obfuscation
  hostname [name]      Anonymize device hostname

Examples:
  nh-anon tor-setup
  nh-anon tor start
  nh-anon checkip
  nh-anon hostname
EOF
    exit 1
}

case "${1:-help}" in
    tor-setup|tor-init) tor_setup ;;
    tor)
        shift
        case "${1:-status}" in
            start|up) tor_start ;;
            stop|down|kill) tor_stop ;;
            status|check) tor_status ;;
            *) tor_status ;;
        esac
        ;;
    checkip|leak-test|ip) tor_check_ip ;;
    i2p|i2p-setup) i2p_setup ;;
    proxychains|proxy) proxychains_usage ;;
    obfuscate|obfuscation) obfuscation_setup ;;
    hostname|anonymize-hostname) shift; anonymize_hostname "$@" ;;
    *) usage ;;
esac
