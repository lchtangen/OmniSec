#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# nh-scan - Network discovery and port scanning wrapper
# Uses nmap inside chroot or basic /system/bin tools
set -u

NHSYSTEM=/data/local/nhsystem
LOG=$NHSYSTEM/logs/nh-scan.log

usage() {
    echo "usage: nh-scan <target> [options]"
    echo "  targets: local, subnet, gateway, <ip>"
    echo "  options: -q (quick), -d (deep), -p <ports>"
    exit 1
}

[ $# -ge 1 ] || usage

TARGET="$1"
shift

case "$TARGET" in
    local)
        ip -br addr show 2>/dev/null | grep -v '^lo' | head -5
        ;;
    subnet)
        DEVICE_IP=$(ip -br addr show 2>/dev/null | grep -v '^lo' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
        SUBNET=$(echo "$DEVICE_IP" | cut -d. -f1-3).0/24
        echo "[scan] scanning $SUBNET..."
        if [ -x /data/local/nhsystem/roots/archlinux/usr/bin/nmap ]; then
            /system/bin/chroot /data/local/nhsystem/roots/archlinux /usr/bin/nmap -sn "$SUBNET" 2>/dev/null
        else
            busybox ping -c 1 -W 1 "$SUBNET" 2>/dev/null || true
        fi
        ;;
    gateway)
        ip route show 2>/dev/null | grep default | awk '{print $3}'
        ;;
    *)
        if echo "$TARGET" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
            ping -c 2 -W 2 "$TARGET" 2>/dev/null
        else
            echo "[scan] unknown target: $TARGET"
            usage
        fi
        ;;
esac
