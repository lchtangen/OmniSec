#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P1
# nh-market - Module marketplace and registry with real module data
set -u

NHSYSTEM=/data/local/nhsystem
MARKET_DIR=$NHSYSTEM/etc/market
REGISTRY=$MARKET_DIR/registry.json
INSTALLED_DIR=$NHSYSTEM/modules
CACHE_DIR=$MARKET_DIR/cache
NHWORK=$NHSYSTEM/workspaces/main

MARKET_URL=${NH_MARKET_URL:-https://raw.githubusercontent.com/nethunter-nx/modules/main/registry.json}

