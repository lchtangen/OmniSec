#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P2
# nh-watch - Event-driven file/network watcher and trigger system
set -u

NHSYSTEM=/data/local/nhsystem
WATCH_DIR=$NHSYSTEM/etc/watches
NHWORK=$NHSYSTEM/workspaces/main
WATCH_LOG=$NHSYSTEM/logs/watch.log

ensure_dirs() { mkdir -p "$WATCH_DIR" "$NHSYSTEM/logs"; }

watch_file() {
    local path="$1"
    shift
    local cmd="${*:-echo 'File changed: $path'}"

    [ -f "$path" ] || [ -d "$path" ] || { echo "Path not found: $path"; exit 1; }

    echo "── Watching: $path ──"
    echo "  Trigger: $cmd"
    echo "  PID: $$"
    echo ""

    local last=$(stat -c '%Y' "$path" 2>/dev/null || echo 0)

    while true; do
        local current=$(stat -c '%Y' "$path" 2>/dev/null || echo 0)
        if [ "$current" != "$last" ]; then
            echo "[$(date)] Change detected: $path" >> "$WATCH_LOG"
            eval "$cmd" 2>&1 | sed 's/^/  /'
            last="$current"
        fi
        sleep 2
    done
}

watch_dir() {
    local path="$1"
    shift
    local cmd="${*:-echo 'Directory changed'}"

    [ -d "$path" ] || { echo "Directory not found: $path"; exit 1; }

    echo "── Watching Directory: $path ──"
    echo "  Trigger: $cmd"
    echo ""

    local snapshot=$(find "$path" -type f -printf '%T@ %p\n' 2>/dev/null | sort || find "$path" -type f -newer "$path" 2>/dev/null | wc -l)

    while true; do
        local current=$(find "$path" -type f -printf '%T@ %p\n' 2>/dev/null | sort | wc -l || echo 0)
        if [ "$current" != "$snapshot" ]; then
            echo "[$(date)] Directory changed: $path" >> "$WATCH_LOG"
            eval "$cmd" 2>&1 | sed 's/^/  /'
            snapshot=$(find "$path" -type f -printf '%T@ %p\n' 2>/dev/null | sort || echo 0)
        fi
        sleep 5
    done
}

watch_network() {
    local target="${1:-8.8.8.8}"
    local cmd="${2:-echo 'Network state changed'}"

    echo "── Watching Network: $target ──"
    echo "  Trigger: $cmd"
    echo ""

    local last_state=1
    ping -c 1 -W 1 "$target" >/dev/null 2>&1 && last_state=0

    while true; do
        local current_state=1
        ping -c 1 -W 2 "$target" >/dev/null 2>&1 && current_state=0

        if [ "$current_state" != "$last_state" ]; then
            local msg=""
            [ "$current_state" -eq 0 ] && msg="ONLINE" || msg="OFFLINE"
            echo "[$(date)] Network $msg: $target" >> "$WATCH_LOG"
            eval "TARGET=\"$target\" STATE=\"$msg\" $cmd" 2>&1 | sed 's/^/  /'
            last_state="$current_state"
        fi
        sleep 10
    done
}

watch_process() {
    local proc_name="$1"
    shift
    local cmd="${*:-echo 'Process $proc_name state changed'}"

    echo "── Watching Process: $proc_name ──"
    echo ""

    local last_running=0
    pgrep -x "$proc_name" >/dev/null 2>&1 && last_running=1

    while true; do
        local running=0
        pgrep -x "$proc_name" >/dev/null 2>&1 && running=1

        if [ "$running" != "$last_running" ]; then
            local msg=""
            [ "$running" -eq 1 ] && msg="STARTED" || msg="STOPPED"
            echo "[$(date)] Process $proc_name $msg" >> "$WATCH_LOG"
            eval "PROCESS=\"$proc_name\" STATE=\"$msg\" $cmd" 2>&1 | sed 's/^/  /'
            last_running=$running
        fi
        sleep 3
    done
}

usage() {
    cat <<EOF
nh-watch - Event-driven file/network watcher

Usage: nh-watch <type> <target> [command]

Types:
  file <path> [cmd]      Watch file for changes
  dir <path> [cmd]       Watch directory for changes
  net <host> [cmd]       Watch network connectivity
  proc <name> [cmd]      Watch process state

The command is executed when a change is detected.
Variables: \$TARGET, \$STATE (net/proc)

Examples:
  nh-watch file /etc/passwd "nh-sentinel check"
  nh-watch dir /workspace/projects "echo 'Project updated'"
  nh-watch net 8.8.8.8 "nh-cron run all"
  nh-watch proc sshd "nh-services start"
EOF
    exit 1
}

ensure_dirs
case "${1:-help}" in
    file|f) shift; [ $# -ge 1 ] || usage; watch_file "$@" ;;
    dir|directory|d) shift; [ $# -ge 1 ] || usage; watch_dir "$@" ;;
    net|network|ping) shift; watch_network "$@" ;;
    proc|process|p) shift; watch_process "$@" ;;
    *) usage ;;
esac
