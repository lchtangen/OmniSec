    fi
}

# ── Usage ──────────────────────────────────────────────

usage() {
    cat <<EOF
nh-immersive - Immersive Operations Interface

Usage: nh-immersive <command> [options]

Setup:
  setup               Install all immersive components
  setup-ar            Setup AR terminal overlay
  setup-audio        Setup spatial audio alerts
  setup-gestures     Setup gesture control
  setup-voice        Setup offline voice control
  setup-holographic   Setup 3D holographic dashboard

Start:
  start-ar            Start AR overlay
  start-audio         Start spatial audio alerts
  start-gestures      Start gesture control
  start-voice         Start voice control

Status:
  status              Show immersive setup status

Examples:
  nh-immersive setup
  nh-immersive start-ar
  nh-immersive start-voice
  nh-immersive status

Requirements:
  - AR: ARCore (Android), Three.js
  - Audio: OpenAL (in chroot)
  - Gestures: OpenCV + MediaPipe (in chroot)
  - Voice: Whisper.cpp (offline STT)
  - Holographic: WebXR + Three.js

Files:
  Config: $CONFIG_DIR/
  Data:   $IMMERSIVE_DIR/
  Logs:   $LOG_DIR/
EOF
}

# ── Main ───────────────────────────────────────────────

[ $# -ge 1 ] || usage

case "$1" in
    setup)
        setup_ar
        setup_spatial_audio
        setup_gestures
        setup_voice
        setup_holographic
        ;;
    setup-ar)
        setup_ar
        ;;
    setup-audio)
        setup_spatial_audio
        ;;
    setup-gestures)
        setup_gestures
        ;;
    setup-voice)
        setup_voice
        ;;
    setup-holographic)
        setup_holographic
        ;;
    start-ar)
        start_ar
        ;;
    start-audio)
        [ -f "$IMMERSIVE_DIR/spatial-alert.py" ] && \
            python3 "$IMMERSIVE_DIR/spatial-alert.py" || err "Run: nh-immersive setup-audio"
        ;;
    start-gestures)
        [ -f "$IMMERSIVE_DIR/gesture-control.py" ] && \
            python3 "$IMMERSIVE_DIR/gesture-control.py" || err "Run: nh-immersive setup-gestures"
        ;;
    start-voice)
        [ -f "$IMMERSIVE_DIR/voice-control.sh" ] && \
            sh "$IMMERSIVE_DIR/voice-control.sh" || err "Run: nh-immersive setup-voice"
        ;;
    status)
        show_status
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        err "Unknown command: $1"
        usage
        ;;
esac
