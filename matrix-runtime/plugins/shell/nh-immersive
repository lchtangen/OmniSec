# ── Voice Control (Offline) ────────────────────────────────

setup_voice() {
    info "Setting up offline voice control..."
    
    # Install whisper.cpp or similar
    if [ -f /data/local/nhsystem/roots/archlinux/usr/bin/whisper ]; then
        ok "Whisper available"
    else
        info "Installing Whisper.cpp in chroot..."
        chroot /data/local/nhsystem/roots/archlinux bash -c \
            "cd /tmp && git clone https://github.com/ggerganov/whisper.cpp && cd whisper.cpp && make" 2>/dev/null || \
            warn "Failed to build Whisper.cpp"
    fi
    
    # Create voice command script
    cat > "$IMMERSIVE_DIR/voice-control.sh" <<'VOICE'
#!/system/bin/sh
# Voice-controlled operations using offline speech recognition

MODEL="${WHISPER_MODEL:-base}"

echo "🎤 Voice Control Active"
echo "Say commands like: 'run status', 'start mesh', 'check health'"

while true; do
    # Record audio (simplified - would use proper audio capture)
    arecord -d 3 -f cd -t wav /tmp/voice_command.wav 2>/dev/null
    
    # Transcribe with whisper
    if command -v whisper >/dev/null 2>&1; then
        text=$(whisper --model "$MODEL" --file /tmp/voice_command.wav 2>/dev/null | grep -oP '(?<=\[).*?(?=\])')
        
        echo "Heard: $text"
        
        # Map to commands
        case "$text" in
            *status*)  nh-status ;;
            *health*)  nh-health ;;
            *mesh*)    nh-mesh start ;;
            *backup*) nh-backup ;;
            *ai*)      nh-ai chat "$text" ;;
        esac
    fi
    sleep 1
done
VOICE
    
    chmod +x "$IMMERSIVE_DIR/voice-control.sh"
    ok "Voice control script created"
}

# ── Holographic Dashboard (WebXR) ─────────────────────────

setup_holographic() {
    info "Setting up holographic 3D dashboard..."
    
    cat > "$IMMERSIVE_DIR/holographic-dashboard.html" <<'HOLO'
<!DOCTYPE html>
<html>
<head>
    <script src="https://cdn.jsdelivr.net/npm/three@0.150.0/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@webxr-polyfill/webxr-polyfill.js"></script>
    <title>NH Holographic Dashboard</title>
</head>
<body style="margin:0; background:#000;">
    <div id="hud" style="position:absolute; top:10px; left:10px; color:cyan; z-index:999;">
        <h2>NetHunter 3D Dashboard</h2>
        <div id="stats"></div>
    </div>
    <script>
        // Holographic network topology visualization
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.xr.enabled = true;
        document.body.appendChild(renderer.domElement);
        
        // Create 3D network nodes
        const nodes = [];
        const edges = [];
        
        // Fetch real data
        fetch('/api/status').then(r => r.json()).then(data => {
            // Create nodes for each service/device
            data.services.forEach((s, i) => {
                const geometry = new THREE.BoxGeometry(1, 1, 1);
                const material = new THREE.MeshBasicMaterial({ 
                    color: s.status === 'running' ? 0x00ff00 : 0xff0000 
                });
                const cube = new THREE.Mesh(geometry, material);
                cube.position.set(i * 2, 0, 0);
                scene.add(cube);
                nodes.push(cube);
            });
        });
        
        function animate() {
            renderer.setAnimationLoop(() => {
                nodes.forEach((node, i) => {
                    node.rotation.x += 0.01;
                    node.rotation.y += 0.01;
                });
                renderer.render(scene, camera);
            });
        }
        animate();
    </script>
</body>
</html>
HOLO
    
    ok "Holographic dashboard created"
}

