    echo "  NH-IMMERSIVE STATUS"
    echo "  Time: $(date)"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    
    echo "── AR Overlay ──"
    if [ -f "$IMMERSIVE_DIR/ar-overlay.html" ]; then
        ok "AR overlay: Available"
    else
        info "AR overlay: Not set up"
    fi
    
    echo ""
    echo "── Spatial Audio ──"
    if [ -f "$IMMERSIVE_DIR/spatial-alert.py" ]; then
        ok "Spatial audio: Configured"
