#!/usr/bin/env python3
"""
NetHunter Matrix Platform v3.0 - UNIFIED MASTER ENTRY

ALL-IN-ONE: 151+ tools, 10 phases, cross-platform, web API, Matrix protocol.

Phases Integrated:
  Phase 1: AI-Native Security Copilot ✅
  Phase 2: Resilient Mesh Networking ⚠️
  Phase 3: 5G/LTE Security ❌
  Phase 4: eBPF Kernel Defense ❌
  Phase 5: Post-Quantum Cryptography ⚠️
  Phase 6: Hardware Security Module ❌
  Phase 7: Threat Intelligence ❌
  Phase 8: Cyber-Physical Systems ❌
  Phase 9: Immersive Interface ❌
  Phase 10: Autonomous Operations ❌

Usage: nmatrix <command> [options]
       nmatrix <tool> [args]          # Direct tool access
       nmatrix <subsystem> <command>   # Subsystem routing
"""

import os
import sys
import json
import platform
import subprocess
import importlib
from pathlib import Path
from typing import Dict, List, Optional, Any

# ── Matrix Platform Metadata ────────────────────────────────────────

MATRIX_VERSION = "3.0.0"
MATRIX_CODENAME = "Revolutionary"
MATRIX_BUILD = "20260508"
MATRIX_PLATFORM = platform.system().lower()

# Paths
MATRIX_ROOT = Path(__file__).parent.parent
REPO_ROOT = MATRIX_ROOT.parent
MATRIX_BIN = REPO_ROOT / "src" / "device" / "bin"
MATRIX_PLUGINS = MATRIX_ROOT / "plugins"
MATRIX_PLATFORMS = REPO_ROOT / "platform-legacy"
MATRIX_CONFIG = Path.home() / ".nmatrix"

# ── Color Support ─────────────────────────────────────────────────

class Colors:
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    CYAN = '\033[0;36m'
    BOLD = '\033[1m'
    NC = '\033[0m'

    @staticmethod
    def disable():
        Colors.RED = Colors.GREEN = Colors.YELLOW = Colors.BLUE = \
        Colors.CYAN = Colors.BOLD = Colors.NC = ''

if platform.system() == "Windows":
    Colors.disable()

# ── Platform Detection ───────────────────────────────────────────────

class Platform:
    """Cross-platform detection and abstraction layer."""

    def __init__(self):
        self.system = platform.system().lower()
        self.machine = platform.machine()
        self.is_android = self._detect_android()
        self.is_chroot = self._detect_chroot()
        self.is_wsl = self._detect_wsl()

    def _detect_android(self) -> bool:
        """Detect if running on Android."""
        return (
            self.system == "linux" and
            (Path("/system/build.prop").exists() or
             Path("/system").exists())
        )

    def _detect_chroot(self) -> bool:
        """Detect if running inside a chroot."""
        return (
            Path("/data/local/nhsystem").exists() or
            Path("/etc/debian_chroot").exists() or
            os.environ.get("CHROOT") is not None
        )

    def _detect_wsl(self) -> bool:
        """Detect if running inside WSL."""
        return (
            self.system == "linux" and
            "microsoft" in platform.release().lower()
        )

    def get_platform_name(self) -> str:
        """Return human-readable platform name."""
        if self.is_android:
            if self.is_chroot:
                return "Android (Chroot)"
            return "Android (Native)"
        elif self.is_wsl:
            return "Windows (WSL)"
        elif self.system == "linux":
            return "Linux"
        elif self.system == "darwin":
            return "macOS"
        elif self.system == "windows":
            return "Windows"
        return f"Unknown ({self.system})"

    def get_tool_path(self, tool_name: str) -> Optional[Path]:
        """Find tool executable across platforms."""
        # Try matrix-runtime/bin first
        matrix_bin = MATRIX_ROOT / "bin" / tool_name
        if matrix_bin.exists():
            return matrix_bin

        # Try src/device/bin (nh-* tools)
        src_bin = MATRIX_BIN / f"nh-{tool_name}"
        if src_bin.exists():
            return src_bin

        # Try nh-* without prefix
        nh_tool = MATRIX_BIN / tool_name
        if nh_tool.exists():
            return nh_tool

        # Try system PATH
        which = subprocess.run(
            ["which", tool_name],
            capture_output=True, text=True
        )
        if which.returncode == 0:
            return Path(which.stdout.strip())

        return None

# ── Plugin System ──────────────────────────────────────────────────

class PluginManager:
    """Dynamic plugin loader for Matrix extensions."""

    def __init__(self, platform: Platform):
        self.platform = platform
        self.plugins: Dict[str, Any] = {}
        self.load_plugins()

    def load_plugins(self):
        """Load all plugins from plugins directory."""
        if not MATRIX_PLUGINS.exists():
            return

        for plugin_file in MATRIX_PLUGINS.glob("*.py"):
            if plugin_file.name.startswith("_"):
                continue
            try:
                # Dynamic import
                sys.path.insert(0, str(MATRIX_PLUGINS))
                module = __import__(plugin_file.stem)
                if hasattr(module, "register"):
                    module.register(self)
                self.plugins[plugin_file.stem] = module
            except Exception as e:
                print(f"{Colors.YELLOW}Warning: Failed to load plugin {plugin_file.stem}: {e}{Colors.NC}")

    def get_plugin(self, name: str):
        """Get a specific plugin."""
        return self.plugins.get(name)

    def list_plugins(self) -> List[str]:
        """List all loaded plugins."""
        return list(self.plugins.keys())

# ── Subsystem Router ─────────────────────────────────────────────

class SubsystemRouter:
    """Route commands to appropriate subsystems."""

    SUBSYSTEMS = {
        "ai": {
            "desc": "AI-Native Security Copilot",
            "tools": ["ai", "ai-triage", "agent"],
            "phase": 1,
        },
        "privacy": {
            "desc": "Privacy & Anonymization Tools",
            "tools": ["privacy", "crypt", "anon", "forensic", "privaudit", "id"],
            "phase": 1,
        },
        "mesh": {
            "desc": "Mesh Networking (Reticulum)",
            "tools": ["meshchat", "reticulum"],
            "phase": 2,
        },
        "cellular": {
            "desc": "5G/LTE Security Toolkit",
            "tools": ["cellular", "5g", "imsi-catcher"],
            "phase": 3,
        },
        "ebpf": {
            "desc": "eBPF Kernel Defense",
            "tools": ["ebpf", "bpf", "trace"],
            "phase": 4,
        },
        "pqc": {
            "desc": "Post-Quantum Cryptography",
            "tools": ["pqc", "kyber", "dilithium"],
            "phase": 5,
        },
        "hsm": {
            "desc": "Hardware Security Module",
            "tools": ["hsm", "yubikey", "fido2"],
            "phase": 6,
        },
        "threat": {
            "desc": "Threat Intelligence",
            "tools": ["threat", "intel", "ioc"],
            "phase": 7,
        },
        "cyberphys": {
            "desc": "Cyber-Physical Systems",
            "tools": ["canbus", "mavlink", "zigbee"],
            "phase": 8,
        },
        "immersive": {
            "desc": "Immersive Interface",
            "tools": ["ar", "vr", "voice"],
            "phase": 9,
        },
        "autonomous": {
            "desc": "Autonomous Operations",
            "tools": ["self-heal", "predict", "adaptive"],
            "phase": 10,
        },
        "core": {
            "desc": "Core Infrastructure",
            "tools": ["status", "health", "backup", "mount", "services"],
            "phase": 0,
        },
        "iot": {
            "desc": "IoT & Hardware Hacking",
            "tools": ["sdr", "rtl", "wifi", "bluetooth"],
            "phase": 0,
        },
    }

    def __init__(self, platform: Platform):
        self.platform = platform

    def route(self, subsystem: str, command: List[str]) -> int:
        """Route command to appropriate subsystem."""
        if subsystem not in self.SUBSYSTEMS:
            print(f"{Colors.RED}Unknown subsystem: {subsystem}{Colors.NC}")
            self.list_subsystems()
            return 1

        # Get tool for subsystem
        tools = self.SUBSYSTEMS[subsystem]["tools"]

        if not command:
            # Show subsystem info
            self._show_subsystem_info(subsystem)
            return 0

        # Try to find and execute tool
        tool_name = command[0]
        tool_path = self.platform.get_tool_path(tool_name)

        if tool_path:
            # Execute tool
            try:
                result = subprocess.run(
                    [str(tool_path)] + command[1:],
                    cwd=MATRIX_ROOT
                )
                return result.returncode
            except Exception as e:
                print(f"{Colors.RED}Failed to execute {tool_name}: {e}{Colors.NC}")
                return 1
        else:
            print(f"{Colors.YELLOW}Tool not found: {tool_name}{Colors.NC}")
            print(f"Available tools in {subsystem}: {', '.join(tools)}")
            return 1

    def _show_subsystem_info(self, subsystem: str):
        """Display subsystem information."""
        info = self.SUBSYSTEMS[subsystem]
        print(f"\n{Colors.BOLD}Subsystem: {subsystem}{Colors.NC}")
        print(f"Description: {info['desc']}")
        print(f"Phase: {info['phase']}")
        print(f"Tools: {', '.join(info['tools'])}")
        print()

    def list_subsystems(self):
        """List all available subsystems."""
        print(f"\n{Colors.BOLD}Available Subsystems:{Colors.NC}")
        print(f"{'Subsystem':<20} {'Phase':<8} {'Description':<40}")
        print("─" * 70)
        for name, info in sorted(self.SUBSYSTEMS.items()):
            print(f"{name:<20} {info['phase']:<8} {info['desc']:<40}")

# ── Matrix CLI ─────────────────────────────────────────────────────

class MatrixCLI:
    """Main CLI interface for NetHunter Matrix Platform."""

    def __init__(self):
        self.platform = Platform()
        self.router = SubsystemRouter(self.platform)
        self.plugins = PluginManager(self.platform)

    def banner(self):
        """Display Matrix banner."""
        print(f"""
{Colors.CYAN}{Colors.BOLD}
╔═══════════════════════════════════════════════════════════════════════╗
║                                                                   ║
║   ███╗   ██╗ █████╗ ████████╗██╗  ██╗██╗   ██╗██████╗      ║
║   ████╗  ██║██╔══██╗╚══██╔══╝██║  ██║██║   ██║██╔══██╗     ║
║   ██╔██╗ ██║███████║   ██║   ███████║██║   ██║██████╔╝     ║
║   ██║╚██╗██║██╔══██║   ██║   ██╔══██║██║   ██║██╔══██╗     ║
║   ██║ ╚████║██║  ██║   ██║   ██║  ██║╚██████╔╝██████╔╝     ║
║   ╚═╝  ╚═══╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝ ╚═════╝ ╚═════╝      ║
║                                                                   ║
║   NetHunter Matrix Platform v{MATRIX_VERSION} "{MATRIX_CODENAME}"       ║
║   Build: {MATRIX_BUILD} | Platform: {self.platform.get_platform_name()}                    ║
║                                                                   ║
╚═══════════════════════════════════════════════════════════════════════╝
{Colors.NC}""")

    def status(self):
        """Show Matrix platform status."""
        print(f"\n{Colors.BOLD}Matrix Platform Status{Colors.NC}")
        print("─" * 50)
        print(f"Version: {MATRIX_VERSION}")
        print(f"Platform: {self.platform.get_platform_name()}")
        print(f"Architecture: {self.platform.machine}")
        print(f"Root: {MATRIX_ROOT}")
        print(f"Plugins loaded: {len(self.plugins.list_plugins())}")
        print(f"Subsystems: {len(self.router.SUBSYSTEMS)}")
        print()

        # Tool inventory
        if MATRIX_BIN.exists():
            tools = list(MATRIX_BIN.glob("nh-*"))
            print(f"Tools available: {len(tools)}")
            for tool in sorted(tools)[:10]:
                print(f"  • {tool.stem}")
            if len(tools) > 10:
                print(f"  ... and {len(tools) - 10} more")
        print()

    def run(self, args: List[str]) -> int:
        """Main entry point - unified access to ALL tools."""
        if not args or args[0] in ["--help", "-h"]:
            self.help()
            return 0

        if args[0] == "--version" or args[0] == "-v":
            print(f"NetHunter Matrix Platform v{MATRIX_VERSION} ({MATRIX_CODENAME})")
            return 0

        if args[0] == "status":
            self.banner()
            self.status()
            return 0

        if args[0] == "subsystems":
            self.router.list_subsystems()
            return 0

        if args[0] == "plugins":
            print(f"\n{Colors.BOLD}Loaded Plugins:{Colors.NC}")
            for plugin in self.plugins.list_plugins():
                print(f"  • {plugin}")
            return 0

        if args[0] == "tools":
            self._list_all_tools()
            return 0

        # Try direct tool execution (nh-* tools)
        tool_path = self.platform.get_tool_path(args[0])
        if tool_path:
            return self._execute_tool(tool_path, args[1:])

        # Try subsystem routing
        return self.router.route(args[0], args[1:])

    def _list_all_tools(self):
        """List ALL available tools."""
        print(f"\n{Colors.BOLD}All Available Tools:{Colors.NC}")
        print(f"{'Tool':<30} {'Type':<15} {'Phase':<10}")
        print("─" * 60)

        # Shell tools from plugins/shell/
        shell_dir = Path.home() / ".nmatrix" / "plugins" / "shell"
        if not shell_dir.exists():
            shell_dir = Path(__file__).parent.parent / "plugins" / "shell"

        if shell_dir.exists():
            for tool in sorted(shell_dir.glob("nh-*")):
                # Determine phase from tool category
                phase = self._get_tool_phase(tool.stem)
                print(f"{tool.stem:<30} {'shell':<15} {phase:<10}")

        print(f"\nTotal: {len(list(shell_dir.glob('nh-*')))} tools")

    def _get_tool_phase(self, tool_name: str) -> str:
        """Map tool to its phase."""
        phase_map = {
            "ai": "1", "ai-triage": "1",
            "privacy": "1", "crypt": "5", "anon": "1", "forensic": "1",
            "mesh": "2", "meshchat": "2",
            "cellular": "3", "5g": "3",
            "ebpf": "4", "bpf": "4",
            "pqc": "5", "kyber": "5", "dilithium": "5",
            "hsm": "6", "yubikey": "6", "fido2": "6",
            "threat": "7", "intel": "7", "ioc": "7",
            "cyberphys": "8", "canbus": "8", "mavlink": "8",
            "immersive": "9", "ar": "9", "vr": "9",
            "autonomous": "10", "self-heal": "10",
        }
        for key, phase in phase_map.items():
            if key in tool_name:
                return phase
        return "core"

    def _execute_tool(self, tool_path: Path, args: List[str]) -> int:
        """Execute a tool directly."""
        try:
            result = subprocess.run(
                [str(tool_path)] + args,
                cwd=Path.cwd()
            )
            return result.returncode
        except KeyboardInterrupt:
            print(f"\n{Colors.YELLOW}Interrupted{Colors.NC}")
            return 130
        except Exception as e:
            print(f"{Colors.RED}Error executing {tool_path.name}: {e}{Colors.NC}")
            return 1

    def help(self):
        """Display help."""
        self.banner()
        print(f"""
{Colors.BOLD}Usage:{Colors.NC}
  nmatrix <subsystem> <command> [options]
  nmatrix <tool> [options]
  nmatrix [status|subsystems|plugins|help]

{Colors.BOLD}Subsystems:{Colors.NC}""")
        self.router.list_subsystems()
        print(f"""
{Colors.BOLD}Examples:{Colors.NC}
  nmatrix ai triage                    # AI-powered log analysis
  nmatrix privacy scan                  # Privacy audit
  nmatrix mesh start                    # Start mesh networking
  nmatrix pqc generate                 # Generate PQ keys
  nmatrix core status                  # Show system status

{Colors.BOLD}Direct Tool Access:{Colors.NC}
  nmatrix nh-privacy status             # Direct tool access
  nmatrix nh-ai chat "hello"           # AI chat

{Colors.BOLD}Management:{Colors.NC}
  nmatrix status                        # Platform status
  nmatrix subsystems                    # List subsystems
  nmatrix plugins                      # List plugins
  nmatrix --version                    # Show version
""")

# ── Main ─────────────────────────────────────────────────────────

def main():
    cli = MatrixCLI()
    args = sys.argv[1:]
    return cli.run(args)

if __name__ == "__main__":
    sys.exit(main())
