#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-kali-nh — Enter Kali NetHunter (Android-optimized) chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

KALI_NH_ROOT="/data/local/nhsystem/roots/kali-nh"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering Kali NetHunter (rooted)..."
    [ -d "$KALI_NH_ROOT" ] || { echo "Kali NetHunter not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$KALI_NH_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering Kali NetHunter (rootless/proot)..."
    proot -0 -r "$KALI_NH_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
