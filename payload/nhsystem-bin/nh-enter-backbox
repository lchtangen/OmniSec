#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-backbox — Enter BackBox (Ubuntu-based pentest) chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

BACKBOX_ROOT="/data/local/nhsystem/roots/backbox"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering BackBox (rooted)..."
    [ -d "$BACKBOX_ROOT" ] || { echo "BackBox not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$BACKBOX_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering BackBox (rootless/proot)..."
    proot -0 -r "$BACKBOX_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
