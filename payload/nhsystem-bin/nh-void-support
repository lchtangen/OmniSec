#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P2
# nh-void-support — Void Linux chroot support.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

VOID_ROOT="/data/local/nhsystem/roots/void"

setup_void() {
    echo "[*] Setting up Void Linux chroot..."
    mkdir -p "$VOID_ROOT"
    echo "  Void Linux: lightweight, rolling release"
}

case "${1:-setup}" in
    setup) setup_void ;;
    *) echo "Usage: nh-void-support [setup]" ;;
esac
