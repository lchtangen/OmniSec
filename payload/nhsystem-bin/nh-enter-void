#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-void — Enter Void Linux chroot

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

VOID_ROOT="/data/local/nhsystem/roots/void"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering Void Linux (rooted)..."
    [ -d "$VOID_ROOT" ] || { echo "Void not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$VOID_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering Void Linux (rootless/proot)..."
    proot -0 -r "$VOID_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
