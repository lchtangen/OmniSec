#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-parrot — Enter ParrotOS chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

PARROT_ROOT="/data/local/nhsystem/roots/parrot"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering ParrotOS (rooted)..."
    [ -d "$PARROT_ROOT" ] || { echo "ParrotOS not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$PARROT_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering ParrotOS (rootless/proot)..."
    proot -0 -r "$PARROT_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
