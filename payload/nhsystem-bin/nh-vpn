#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# nh-vpn — manage WireGuard VPN with kill switch integration
set -u
. /data/local/nhsystem/bin/nh-lib

root="$(arch_root)"
[ -d "$root" ] || { echo "arch rootfs not found: $root" >&2; exit 1; }
mount_root "$root" || exit 1

KILLSWITCH="${NH_KILLSWITCH:-auto}"

case "${1:-status}" in
    up)
        echo "[nh-vpn] bringing wg0 up"
        chroot_exec "$root" /usr/bin/wg-quick up wg0
        if [ "$KILLSWITCH" != "off" ]; then
            sh /data/local/nhsystem/bin/nh-killswitch enable 2>/dev/null && \
                echo "[nh-vpn] kill switch enabled"
        fi
        ;;
    down)
        echo "[nh-vpn] bringing wg0 down"
        sh /data/local/nhsystem/bin/nh-killswitch disable 2>/dev/null && \
            echo "[nh-vpn] kill switch disabled"
        chroot_exec "$root" /usr/bin/wg-quick down wg0 2>/dev/null || true
        ;;
    status)
        echo "[nh-vpn] WireGuard status"
        chroot_exec "$root" /usr/bin/wg show 2>/dev/null || echo "  wg0 not active"
        echo ""
        sh /data/local/nhsystem/bin/nh-killswitch status 2>/dev/null || true
        ;;
    setup)
        echo "[nh-vpn] running WireGuard setup helper"
        [ -f "$root/root/arch-wireguard-setup.sh" ] || {
            cp /data/local/tmp/arch-wireguard-setup.sh "$root/root/arch-wireguard-setup.sh" 2>/dev/null || true
        }
        chroot_exec "$root" /bin/bash /root/arch-wireguard-setup.sh
        ;;
    killswitch)
        shift
        sh /data/local/nhsystem/bin/nh-killswitch "$@"
        ;;
    *)
        echo "usage: nh-vpn [up|down|status|setup|killswitch]" >&2
        exit 2
        ;;
esac
