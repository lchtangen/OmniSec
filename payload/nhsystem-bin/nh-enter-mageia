#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-mageia — Enter Mageia chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

MAGEIA_ROOT="/data/local/nhsystem/roots/mageia"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering Mageia (rooted)..."
    [ -d "$MAGEIA_ROOT" ] || { echo "Mageia not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$MAGEIA_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering Mageia (rootless/proot)..."
    proot -0 -r "$MAGEIA_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
