#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-opensuse — Enter openSUSE chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

OPENSUSE_ROOT="/data/local/nhsystem/roots/opensuse"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering openSUSE (rooted)..."
    [ -d "$OPENSUSE_ROOT" ] || { echo "openSUSE not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$OPENSUSE_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering openSUSE (rootless/proot)..."
    proot -0 -r "$OPENSUSE_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
