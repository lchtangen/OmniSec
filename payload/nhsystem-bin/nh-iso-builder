#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P2
# nh-iso-builder — Build custom ISO images!

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

build_iso() {
    local name="${1:-custom}"
    echo "[*] Building ISO: $name..."
}

case "${1:-help}" in
    build) build_iso "${2:-}" ;;
    *) echo "Usage: nh-iso-builder [build <name>]" ;;
esac
