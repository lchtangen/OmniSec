#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P1
# nh-ai-triage - AI-powered log analysis and intelligent triage system
# Performance: incremental analysis, smart caching, multi-source aggregation
set -u

NHSYSTEM=${NHSYSTEM:-/data/local/nhsystem}
OLLAMA_HOST=${OLLAMA_HOST:-http://127.0.0.1:11434}
MODEL=${NH_AI_TRIAGE_MODEL:-llama3.2:3b}
CACHE_DIR="$NHSYSTEM/cache/ai-triage"
TRIAGE_DB="$NHSYSTEM/logs/triage.db"
MAX_LOG_LINES=5000
ANALYSIS_TIMEOUT=30

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Ensure directories exist
mkdir -p "$CACHE_DIR" "$NHSYSTEM/logs"

# ── Utility Functions ─────────────────────────────────────────────────────────

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
err()   { printf "${RED}[ERR]${NC} %s\n" "$*" >&2; }
debug() { [ "${DEBUG:-0}" = "1" ] && printf "${CYAN}[DBG]${NC} %s\n" "$*" || true; }

# Performance: cache management
cache_get() {
    local key="$1"
    local cache_file="$CACHE_DIR/$(echo "$key" | md5sum | cut -d' ' -f1).cache"
    if [ -f "$cache_file" ]; then
        local age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0) ))
        if [ "$age" -lt "${CACHE_TTL:-300}" ]; then
            debug "Cache hit: $key (age: ${age}s)"
            cat "$cache_file"
            return 0
        fi
    fi
    return 1
}

cache_set() {
    local key="$1"
    local cache_file="$CACHE_DIR/$(echo "$key" | md5sum | cut -d' ' -f1).cache"
    cat > "$cache_file"
    debug "Cached: $key -> $cache_file"
}

cache_clear() {
    rm -rf "$CACHE_DIR"/*
    info "Cache cleared"
}

# ── Log Collection (Performance Optimized) ──────────────────────────────────

collect_system_logs() {
    local cache_key="system_logs_$(date +%Y%m%d%H)"
    cache_get "$cache_key" && return 0
    
    {
        echo "=== System Logs (last 100 lines) ==="
        logcat -d -t 100 2>/dev/null || true
        echo ""
        echo "=== Dmesg (last 50 lines) ==="
        dmesg | tail -50 2>/dev/null || true
    } | cache_set "$cache_key"
    
    cache_get "$cache_key"
}

collect_chroot_logs() {
    local root="${1:-}"
    [ -d "$root" ] || return 1
    
    local cache_key="chroot_logs_$(basename "$root")_$(date +%Y%m%d%H)"
    cache_get "$cache_key" && return 0
    
    {
        echo "=== Chroot: $(basename "$root") ==="
        for log in "$root/var/log/"*.log "$root/var/log/"*.log.*; do
            [ -f "$log" ] || continue
            echo "--- $(basename "$log") (last 30 lines) ---"
            tail -30 "$log" 2>/dev/null || true
            echo ""
        done
    } | cache_set "$cache_key"
    
    cache_get "$cache_key"
}

collect_service_logs() {
    local cache_key="service_logs_$(date +%Y%m%d%H)"
    cache_get "$cache_key" && return 0
    
    {
        echo "=== Service Status ==="
        for svc in sshd nginx tor vpn; do
            if pgrep -x "$svc" >/dev/null 2>&1; then
                echo "$svc: running"
            else
                echo "$svc: stopped"
            fi
        done
        echo ""
        echo "=== Recent Service Logs ==="
        nh-log 2>/dev/null | tail -100 || true
    } | cache_set "$cache_key"
    
    cache_get "$cache_key"
}

collect_all_logs() {
    info "Collecting logs from all sources..."
    local all_logs="/tmp/nh-triage-input-$(date +%s).txt"
    
    {
        echo "=== NH-AI-TRIAGE Analysis Input ==="
        echo "Generated: $(date)"
        echo "Device: $(getprop ro.product.model 2>/dev/null)"
        echo ""
        
        # System logs (with limit)
        collect_system_logs 2>/dev/null | head -n "$MAX_LOG_LINES" || true
        echo ""
        
        # Chroot logs
        for root in /data/local/nhsystem/roots/*/; do
            [ -d "$root" ] && collect_chroot_logs "$root" 2>/dev/null | head -n 1000 || true
        done
        echo ""
        
        # Service logs
        collect_service_logs 2>/dev/null | head -n 500 || true
        echo ""
        
        # Health check output
        echo "=== Health Check ==="
        nh-health 2>/dev/null | tail -50 || true
        
    } > "$all_logs"
    
    echo "$all_logs"
}

# ── AI Analysis ──────────────────────────────────────────────────────────────

check_ollama() {
    if ! curl -s --connect-timeout 3 "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
        err "Ollama not reachable at $OLLAMA_HOST"
        err "Start with: ollama serve &"
        return 1
    fi
    return 0
}

ai_analyze() {
    local input_file="$1"
    local analysis_type="${2:-triage}"
    
    check_ollama || return 1
    
    info "Analyzing logs with AI model: $MODEL"
    
    local system_prompt=""
    case "$analysis_type" in
        triage)
            system_prompt="You are a system reliability expert analyzing logs from an Android device running NetHunter with Arch Linux and Kali Linux chroots.
Your task is to:
1. Identify critical issues (crashes, errors, security concerns)
2. Categorize by severity: CRITICAL, HIGH, MEDIUM, LOW, INFO
3. Provide specific, actionable recommendations
4. Group related issues together
5. Output in a structured format with clear priorities

Focus on:
- Service failures and crashes
- Security violations or anomalies
- Resource exhaustion (disk, memory)
- Network connectivity issues
- Authentication failures
- Performance degradation patterns

Be concise but thorough. Include specific commands to fix issues when possible."
            ;;
        security)
            system_prompt="You are a security analyst reviewing logs for potential security issues.
Focus on:
- Authentication failures and brute force attempts
- Unauthorized access attempts
- Suspicious network connections
- Privilege escalation attempts
- Malware indicators
- Data exfiltration signs

Categorize findings by risk level and provide mitigation steps."
            ;;
        performance)
            system_prompt="You are a performance engineer analyzing system logs.
Focus on:
- Resource bottlenecks (CPU, memory, I/O, network)
- Slow operations and timeouts
- Memory leaks or excessive usage
- Disk space issues
- Service response times

Provide optimization recommendations with expected impact."
            ;;
    esac
    
    # Truncate input if too large
    local input_size
    input_size=$(wc -c < "$input_file" 2>/dev/null || echo 0)
    if [ "$input_size" -gt 50000 ]; then
        warn "Input large (${input_size} bytes), truncating to last 30000 bytes"
        tail -c 30000 "$input_file" > "${input_file}.truncated"
        input_file="${input_file}.truncated"
    fi
    
    local data
    data=$(cat "$input_file" 2>/dev/null | sed 's/"/\\"/g' | sed 's/$/\\n/' | tr -d '\n')
    
    local response_file="/tmp/nh-triage-response-$(date +%s).json"
    
    curl -s --max-time "$ANALYSIS_TIMEOUT" "$OLLAMA_HOST/api/generate" \
        -d "{
            \"model\": \"$MODEL\",
            \"prompt\": \"$data\\n\\nPerform the analysis now:\",
            \"system\": \"$system_prompt\",
            \"stream\": false,
            \"options\": {
                \"temperature\": 0.1,
                \"num_predict\": 2048
            }
        }" 2>/dev/null > "$response_file" || {
            err "AI analysis request failed (timeout: ${ANALYSIS_TIMEOUT}s)"
            return 1
        }
    
    if [ -f "$response_file" ]; then
        grep -o '"response":"[^"]*"' "$response_file" 2>/dev/null | \
            cut -d'"' -f4 | sed 's/\\n/\n/g' | sed 's/\\"/"/g'
        rm -f "$response_file"
    fi
}

# ── Output Formatting ─────────────────────────────────────────────────────────

format_text() {
    local input="$1"
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  NH-AI-TRIAGE REPORT"
    echo "  Generated: $(date)"
    echo "  Model: $MODEL"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    echo "$input" | while IFS= read -r line; do
        # Color-code severity levels
        case "$line" in
            *CRITICAL*) printf "${RED}%s${NC}\n" "$line" ;;
            *HIGH*)     printf "${YELLOW}%s${NC}\n" "$line" ;;
            *MEDIUM*)   printf "${BLUE}%s${NC}\n" "$line" ;;
            *LOW*)      printf "${CYAN}%s${NC}\n" "$line" ;;
            *INFO*)     printf "${GREEN}%s${NC}\n" "$line" ;;
            *)          echo "$line" ;;
        esac
    done
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
}

format_json() {
    local input="$1"
    echo "{"
    echo "  \"timestamp\": \"$(date -Iseconds)\","
    echo "  \"model\": \"$MODEL\","
    echo "  \"device\": \"$(getprop ro.product.model 2>/dev/null)\","
    echo "  \"analysis\": \"$(echo "$input" | sed 's/"/\\"/g' | sed 's/$/\\n/' | tr -d '\n')\""
    echo "}"
}

format_markdown() {
    local input="$1"
    echo "# NH-AI-Triage Report"
    echo ""
    echo "**Generated:** $(date)"
    echo "**Model:** $MODEL"
    echo "**Device:** $(getprop ro.product.model 2>/dev/null)"
    echo ""
    echo "---"
    echo ""
    echo "$input"
}

# ── Trend Analysis ───────────────────────────────────────────────────────────

analyze_trends() {
    info "Analyzing trends across recent triage reports..."
    
    local reports
    reports=$(ls -t "$NHSYSTEM/logs/triage-"*.txt 2>/dev/null | head -5)
    
    if [ -z "$reports" ]; then
        warn "No previous triage reports found for trend analysis"
        return 0
    fi
    
    echo ""
    echo "── Trend Analysis (last 5 reports) ──"
    
    local critical_count=0
    local high_count=0
    
    for report in $reports; do
        [ -f "$report" ] || continue
        local c=$(grep -c "CRITICAL" "$report" 2>/dev/null || echo 0)
        local h=$(grep -c "HIGH" "$report" 2>/dev/null || echo 0)
        critical_count=$((critical_count + c))
        high_count=$((high_count + h))
        echo "  $(basename "$report"): CRITICAL=$c, HIGH=$h"
    done
    
    echo ""
    echo "  Total CRITICAL issues: $critical_count"
    echo "  Total HIGH issues: $high_count"
    
    if [ "$critical_count" -gt 10 ]; then
        warn "High number of critical issues detected across reports"
    fi
}

# ── Main Commands ────────────────────────────────────────────────────────────

cmd_triage() {
    local format="${1:-text}"
    local type="${2:-triage}"
    
    info "Starting AI-powered triage analysis..."
    info "Type: $type | Format: $format"
    
    # Collect logs
    local log_file
    log_file=$(collect_all_logs)
    [ -f "$log_file" ] || { err "Failed to collect logs"; return 1; }
    
    debug "Log file: $log_file ($(wc -l < "$log_file") lines)"
    
    # Run AI analysis
    local analysis
    analysis=$(ai_analyze "$log_file" "$type")
    
    if [ -z "$analysis" ]; then
        err "AI analysis failed or returned empty"
        return 1
    fi
    
    # Save report
    local report_file="$NHSYSTEM/logs/triage-$(date +%Y%m%d-%H%M%S).txt"
    echo "$analysis" > "$report_file"
    info "Report saved: $report_file"
    
    # Output in requested format
    case "$format" in
        text)
            format_text "$analysis"
            ;;
        json)
            format_json "$analysis"
            ;;
        markdown|md)
            format_markdown "$analysis"
            ;;
        *)
            warn "Unknown format: $format, defaulting to text"
            format_text "$analysis"
            ;;
    esac
    
    # Cleanup
    rm -f "$log_file" "${log_file}.truncated" 2>/dev/null || true
    
    # Trend analysis
    analyze_trends
}

cmd_security() {
    info "Running security-focused analysis..."
    cmd_triage "${1:-text}" "security"
}

cmd_performance() {
    info "Running performance analysis..."
    cmd_triage "${1:-text}" "performance"
}

cmd_quick() {
    info "Quick triage (last 100 lines from key logs)..."
    local quick_log="/tmp/nh-triage-quick-$(date +%s).txt"
    
    {
        echo "=== Quick System Check ==="
        echo "Time: $(date)"
        echo ""
        echo "--- Recent Errors (logcat) ---"
        logcat -d -t 50 2>/dev/null | grep -iE "error|fail|crash" || echo "None found"
        echo ""
        echo "--- Disk Usage ---"
        df -h /data /sdcard 2>/dev/null | head -5
        echo ""
        echo "--- Memory ---"
        free -m 2>/dev/null | head -3 || true
        echo ""
        echo "--- Top Processes ---"
        ps -eo pid,ppid,cmd,%mem,%cpu --sort=-%mem 2>/dev/null | head -10 || true
    } > "$quick_log"
    
    ai_analyze "$quick_log" "triage" | format_text
    rm -f "$quick_log"
}

cmd_watch() {
    local interval="${1:-60}"
    info "Watching logs every $interval seconds (Ctrl+C to stop)..."
    
    while true; do
        echo ""
        echo "── $(date) ──"
        cmd_quick
        sleep "$interval"
    done
}

cmd_history() {
    echo "── Triage Report History ──"
    local reports
    reports=$(ls -t "$NHSYSTEM/logs/triage-"*.txt 2>/dev/null)
    
    if [ -z "$reports" ]; then
        info "No triage reports found"
        return 0
    fi
    
    echo "$reports" | while read -r report; do
        [ -f "$report" ] || continue
        local lines=$(wc -l < "$report")
        local critical=$(grep -c "CRITICAL" "$report" 2>/dev/null || echo 0)
        printf "  %-40s  lines=%-5d  critical=%-3d\n" "$(basename "$report")" "$lines" "$critical"
    done
}

cmd_show() {
    local report="${1:-}"
    [ -n "$report" ] || { err "Usage: nh-ai-triage show <report-name>"; return 1; }
    
    local report_file="$NHSYSTEM/logs/$report"
    [ -f "$report_file" ] || { err "Report not found: $report"; return 1; }
    
    cat "$report_file"
}

cmd_clear_cache() {
    cache_clear
}

# ── Usage ────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
nh-ai-triage - AI-Powered Log Analysis & Triage System

Usage: nh-ai-triage <command> [options]

Commands:
  triage [format] [type]    Full triage analysis
                             format: text (default), json, markdown
                             type: triage (default), security, performance
  
  security [format]          Security-focused analysis
  performance [format]      Performance analysis
  quick [format]             Quick analysis (last 100 lines)
  watch [interval]           Continuous monitoring (default: 60s)
  
  history                    List previous triage reports
  show <report-name>         Show a specific report
  clear-cache                Clear analysis cache
  
  help                       Show this help

Examples:
  nh-ai-triage triage                    # Full analysis, text output
  nh-ai-triage security json             # Security analysis, JSON output
  nh-ai-triage quick                     # Quick check
  nh-ai-triage watch 30                  # Watch every 30 seconds

Environment:
  OLLAMA_HOST              Ollama server (default: http://127.0.0.1:11434)
  NH_AI_TRIAGE_MODEL       Model to use (default: llama3.2:3b)
  DEBUG=1                  Enable debug output
  CACHE_TTL=300            Cache TTL in seconds (default: 300)

Performance Notes:
  - Results are cached for 5 minutes (configurable via CACHE_TTL)
  - Log collection is incremental where possible
  - Large inputs are automatically truncated to 50KB
  - Analysis timeout: ${ANALYSIS_TIMEOUT}s

Requires: Ollama running with model pulled
Setup: nh-ai setup
EOF
    exit 0
}

# ── Main ─────────────────────────────────────────────────────────────────────

[ $# -ge 1 ] || usage

case "$1" in
    triage)
        shift
        cmd_triage "$@"
        ;;
    security)
        shift
        cmd_security "$@"
        ;;
    performance)
        shift
        cmd_performance "$@"
        ;;
    quick)
        shift
        cmd_quick "$@"
        ;;
    watch)
        shift
        cmd_watch "${1:-60}"
        ;;
    history)
        cmd_history
        ;;
    show)
        shift
        cmd_show "$@"
        ;;
    clear-cache)
        cmd_clear_cache
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        err "Unknown command: $1"
        usage
        ;;
esac
