#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-settings-device — Device settings!

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

show_device_settings() {
    echo "Device Settings:"
    echo "  Model: $(getprop ro.product.model 2>/dev/null || echo "Unknown")"
    echo "  Android: $(getprop ro.build.version.release 2>/dev/null || echo "Unknown")"
    echo "  ABI: $(uname -m)"
    echo "  Mode: $([ -r /data/local/nhsystem/bin/nh-lib ] && echo "Rooted" || echo "Rootless/Proot")"
}

set_mode() {
    local mode="${1:-rooted}"
    echo "[*] Setting mode to: $mode"
}

case "${1:-show}" in
    show) show_device_settings ;;
    mode) set_mode "${2:-}" ;;
    *) show_device_settings ;;
esac
ENDOFFILE'
chmod +x /home/tangen/nethunter-setup/src/device/bin/nh-settings-device && echo "503/25+: nh-settings-device added!"