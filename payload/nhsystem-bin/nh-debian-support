#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P2
# nh-debian-support — Debian chroot support.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

DEBIAN_ROOT="/data/local/nhsystem/roots/debian"

setup_debian() {
    echo "[*] Setting up Debian chroot..."
    mkdir -p "$DEBIAN_ROOT"
    echo "  Debian rootfs: ready for installation"
    echo "  Use: nh-mount debian"
}

case "${1:-setup}" in
    setup) setup_debian ;;
    *) echo "Usage: nh-debian-support [setup]" ;;
esac
