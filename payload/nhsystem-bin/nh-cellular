#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P3
# nh-cellular — Cellular Security (WiFi-based detection for OnePlus 7 Pro)
set -euo pipefail

CELLULAR_DIR="/data/local/nhsystem/cellular"
WIFI_SCAN="$CELLULAR_DIR/wifi-scan.txt"
CELL_TOWERS="$CELLULAR_DIR/towers.txt"

show_usage() {
    cat <<EOF
nh-cellular - Cellular Security (WiFi-based detection)

Usage: nh-cellular <command> [args]

Commands:
  status            Show cellular/WiFi status
  scan [iface]     Scan WiFi for cellular-adjacent signals
  towers            List detected cell towers via WiFi
  analyze <pcap>    Analyze cellular PCAP (requires tcpdump)
  detect             Detect IMSI catcher indicators
  help              Show this message

Note: Uses WiFi signals to detect cellular environment on OnePlus 7 Pro.
      No SDR hardware required — works with built-in WiFi.
EOF
}

init_cellular() {
    mkdir -p "$CELLULAR_DIR"
    touch "$WIFI_SCAN" "$CELL_TOWERS"
}

cmd_status() {
    echo "══ Cellular/WiFi Status ═══════════"
    init_cellular
    echo ""
    echo "── Device: OnePlus 7 Pro (ARM64) ──"
    echo "  Kernel: $(uname -r)"
    echo ""
    echo "── Network Interfaces ──"
    ip link show 2>/dev/null | grep -E "wlan|rmnet|lo" | head -10
    echo ""
    echo "── WiFi Connection ──"
    if command -v iwconfig >/dev/null 2>&1; then
        iwconfig wlan0 2>/dev/null | grep -E "ESSID|Frequency|Bit Rate" | head -5
    fi
    echo ""
    echo "── Cellular (if available) ──"
    # Check for rmnet interfaces (cellular)
    ip addr show 2>/dev/null | grep "rmnet" | head -5 || echo "  No rmnet interfaces (WiFi-only mode)"
}

cmd_scan() {
    local iface="${1:-wlan0}"
    echo "══ Scanning for Cellular Signals via $iface ═════"
    init_cellular
    
    echo "  Scanning WiFi (cellular-adjacent signals)..."
    echo "  Scan time: $(date)" > "$WIFI_SCAN"
    
    if command -v iwlist >/dev/null 2>&1; then
        iwlist "$iface" scan 2>/dev/null | grep -E "Cell|ESSID|Channel|Frequency|Signal" | tee -a "$WIFI_SCAN" | head -50
    else
        echo "  iwlist not available — trying alternative..."
        # Use /proc/net/wireless if available
        cat /proc/net/wireless 2>/dev/null || echo "  No wireless info available"
    fi
    
    echo ""
    echo "  Scan saved to: $WIFI_SCAN"
    
    # Detect potential cellular signals (some leak via WiFi)
    echo ""
    echo "── Analyzing for cellular indicators ──"
    grep -iE "lte|5g|4g|cellular|tower|base" "$WIFI_SCAN" 2>/dev/null | head -10 || echo "  No cellular indicators in WiFi scan"
}

cmd_towers() {
    echo "══ Detected Cell Towers (via WiFi) ═══════"
    init_cellular
    
    # On Android, we can read from certain system properties
    echo "  Querying system for tower info..."
    
    # Try getprop for cellular info
    if command -v getprop >/dev/null 2>&1; then
        echo "  Operator: $(getprop gsm.operator.alpha 2>/dev/null || echo 'Unknown')"
        echo "  MCC/MNC: $(getprop gsm.sim.operator.numeric 2>/dev/null || echo 'Unknown')"
        echo "  Cell ID: $(getprop gsm.cell.id 2>/dev/null || echo 'Unknown')"
        echo "  LAC: $(getprop gsm.cell.lac 2>/dev/null || echo 'Unknown')"
        echo "  Signal: $(getprop gsm.signal_strength 2>/dev/null || echo 'Unknown')"
    fi
    
    # Save to file
    {
        echo "Tower scan: $(date)"
        getprop | grep -iE "gsm|cellular|lte|5g" 2>/dev/null
    } > "$CELL_TOWERS"
    
    echo ""
    echo "  Tower data saved to: $CELL_TOWERS"
}

cmd_analyze() {
    local pcap="${1:-}"
    [ -z "$pcap" ] && { echo "Usage: nh-cellular analyze <pcap-file>"; exit 1; }
    [ ! -f "$pcap" ] && { echo "  PCAP not found: $pcap"; exit 1; }
    
    echo "══ Analyzing Cellular PCAP: $pcap ═════"
    
    if command -v tcpdump >/dev/null 2>&1; then
        echo "  PCAP analysis (first 50 packets):"
        tcpdump -r "$pcap" 2>/dev/null | head -50
    elif command -v tshark >/dev/null 2>&1; then
        echo "  Protocol hierarchy:"
        tshark -r "$pcap" -q -z io,phs 2>/dev/null | head -20
        echo ""
        echo "  Top talkers:"
        tshark -r "$pcap" -q -z conv,ip 2>/dev/null | head -10
    else
        echo "  No analysis tools available (install tcpdump or wireshark)"
    fi
}

cmd_detect() {
    echo "══ Detecting IMSI Catcher Indicators ═══════"
    init_cellular
    
    echo "  Checking for suspicious WiFi APs (potential StingRay leakage)..."
    iwlist wlan0 scan 2>/dev/null | awk '/ESSID/ {print $0}' | while read -r line; do
        # Check for known IMSI catcher patterns
        if echo "$line" | grep -qiE "intercept|tap|surveil|fake|rogue|evil"; then
            echo "  ⚠ SUSPICIOUS: $line"
        elif echo "$line" | grep -qiE "police|fbi|nsa|gov"; then
            echo "  ⚠ GOVERNMENT: $line"
        fi
    done
    
    echo ""
    echo "  Checking for fake base station indicators..."
    
    # Check signal strength anomalies
    if command -v iwconfig >/dev/null 2>&1; then
        local signal=$(iwconfig wlan0 2>/dev/null | grep "Signal level" | awk '{print $4}' | tr -d 'dBm=')
        if [ -n "$signal" ] && [ "$signal" -gt -30 ]; then
            echo "  ⚠ Strong signal ($signal dBm) — potential nearby fake BTS"
        else
            echo "  ✓ Signal levels normal"
        fi
    fi
    
    echo ""
    echo "  Note: Full IMSI catcher detection requires SDR hardware."
    echo "  This WiFi-based check is a basic heuristic only."
}

init_cellular

case "${1:-status}" in
    status)        cmd_status ;;
    scan)          cmd_scan "${2:-}" ;;
    towers)        cmd_towers ;;
    analyze)       cmd_analyze "${2:-}" ;;
    detect)        cmd_detect ;;
    help|*)        show_usage ;;
esac
