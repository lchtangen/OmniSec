#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-blackarch — Enter BlackArch (Arch-based pentest) chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

BLACKARCH_ROOT="/data/local/nhsystem/roots/blackarch"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering BlackArch (rooted)..."
    [ -d "$BLACKARCH_ROOT" ] || { echo "BlackArch not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$BLACKARCH_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering BlackArch (rootless/proot)..."
    proot -0 -r "$BLACKARCH_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
