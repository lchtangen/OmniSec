#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-rocky — Enter Rocky Linux chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

ROCKY_ROOT="/data/local/nhsystem/roots/rocky"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering Rocky Linux (rooted)..."
    [ -d "$ROCKY_ROOT" ] || { echo "Rocky not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$ROCKY_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering Rocky Linux (rootless/proot)..."
    proot -0 -r "$ROCKY_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
