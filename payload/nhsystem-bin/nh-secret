#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P2
# nh-secret - Encrypted secrets store (GPG-backed)
set -u

NHSYSTEM=/data/local/nhsystem
SECRET_DIR=$NHSYSTEM/etc/secrets
SECRET_FILE=$SECRET_DIR/store.gpg

ensure_dirs() {
    mkdir -p $SECRET_DIR
    chmod 700 $SECRET_DIR
}

have_gpg() {
    command -v gpg >/dev/null 2>&1
}

secrets_list() {
    ensure_dirs
    if [ ! -f "$SECRET_FILE" ]; then
        echo "  No secrets store found"
        echo "  Create one: nh-secret set <key> <value>"
        return 0
    fi
    if ! have_gpg; then
        echo "  gpg not available" >&2
        exit 1
    fi
    echo "── Stored Secrets ──"
    gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -v '^#' | cut -d= -f1 | \
        while read -r key; do
            [ -n "$key" ] && echo "  ${key}"
        done
    echo ""
    echo "  $(gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -cvE '^#|^$' || echo 0) secrets stored"
}

secret_get() {
    local key="$1"
    ensure_dirs
    if [ ! -f "$SECRET_FILE" ]; then
        echo "  Secret not found: $key" >&2
        exit 1
    fi
    if ! have_gpg; then
        echo "  gpg not available" >&2
        exit 1
    fi
    gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep "^${key}=" | cut -d= -f2- || \
        { echo "  Secret not found: $key" >&2; exit 1; }
}

secret_set() {
    local key="$1" value="$2"
    ensure_dirs
    if ! have_gpg; then
        echo "  gpg not available" >&2
        exit 1
    fi
    local tmp="$SECRET_DIR/tmp"
    if [ -f "$SECRET_FILE" ]; then
        gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -v "^${key}=" > "$tmp" || true
    fi
    echo "${key}=${value}" >> "$tmp"
    # Encrypt for default GPG key or user
    gpg --encrypt --armor --recipient "$(gpg --list-keys --keyid-format SHORT 2>/dev/null | grep '^   ' | head -1 | awk '{print $1}')" \
        --output "$SECRET_FILE" "$tmp" 2>/dev/null || {
        # Fallback: symmetric encryption
        gpg --symmetric --armor --output "$SECRET_FILE" "$tmp" 2>/dev/null || {
            # Last resort: plaintext with restricted perms (NOT recommended)
            cp "$tmp" "${SECRET_FILE%.gpg}.txt"
            chmod 600 "${SECRET_FILE%.gpg}.txt"
            echo "  Warning: GPG unavailable, stored as plaintext (restricted perms)" >&2
        }
    }
    rm -f "$tmp"
    echo "  Secret stored: $key"
}

secret_delete() {
    local key="$1"
    ensure_dirs
    if [ ! -f "$SECRET_FILE" ]; then
        echo "  No secrets store" >&2
        exit 1
    fi
    if ! have_gpg; then
        echo "  gpg not available" >&2
        exit 1
    fi
    local tmp="$SECRET_DIR/tmp"
    gpg --decrypt --quiet "$SECRET_FILE" 2>/dev/null | grep -v "^${key}=" > "$tmp"
    gpg --encrypt --armor \
        --recipient "$(gpg --list-keys --keyid-format SHORT 2>/dev/null | grep '^   ' | head -1 | awk '{print $1}')" \
        --output "$SECRET_FILE" "$tmp" 2>/dev/null || \
        gpg --symmetric --armor --output "$SECRET_FILE" "$tmp" 2>/dev/null || true
    rm -f "$tmp"
    echo "  Secret deleted: $key"
}

usage() {
    cat <<EOF
usage: nh-secret <command> [args]

Commands:
  list                  List stored secret names
  get <key>             Get a secret value
  set <key> <value>     Store a secret
  delete <key>          Delete a secret

Secrets are encrypted with GPG.
EOF
    exit 1
}

[ $# -ge 1 ] || usage
case "$1" in
    list) secrets_list ;;
    get) shift; [ $# -ge 1 ] || usage; secret_get "$1" ;;
    set) shift; [ $# -ge 2 ] || usage; secret_set "$1" "$2" ;;
    delete) shift; [ $# -ge 1 ] || usage; secret_delete "$1" ;;
    *) usage ;;
esac
