#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P8
# nh-iot — IoT Device Discovery & Security Testing

set -euo pipefail

IOT_DIR="/data/local/nhsystem/iot"
DEVICES_FILE="$IOT_DIR/devices.json"
SCAN_LOG="$IOT_DIR/scan.log"

show_usage() {
    cat <<EOF
nh-iot — IoT Security Testing (WiFi-based)

Usage: nh-iot <command> [args]

Commands:
  status            Show IoT network status
  scan [network]   Scan for IoT devices (nmap/ping)
  fingerprint <ip>   Identify IoT device type
  test <ip>         Run security tests (common vulns)
  monitor           Monitor IoT device activity
  list              List discovered devices
  help              Show this message

Examples:
  nh-iot scan 192.168.1.0/24
  nh-iot fingerprint 192.168.1.50
  nh-iot test 192.168.1.50

Note: Works on OnePlus 7 Pro via WiFi. Uses nmap, ping, curl.
EOF
}

init_iot() {
    mkdir -p "$IOT_DIR"
    if [ ! -f "$DEVICES_FILE" ]; then
        echo '{"devices":[],"scan_time":"","vulnerable":0}' > "$DEVICES_FILE"
    fi
    touch "$SCAN_LOG"
}

cmd_status() {
    echo "══ IoT Network Status ═══════════"
    init_iot
    
    echo "── Local Network ──"
    local ip=$(ip route | grep wlan0 | grep -oP 'default via \K[0-9.]+' | head -1)
    echo "  Gateway: ${ip:-Unknown}"
    
    echo ""
    echo "── IoT Devices ──"
    local count=$(python3 -c "import json; d=json.load(open('$DEVICES_FILE')); print(len(d['devices']))" 2>/dev/null || echo 0)
    echo "  Discovered: $count"
    
    local vuln=$(python3 -c "import json; d=json.load(open('$DEVICES_FILE')); print(d.get('vulnerable',0))" 2>/dev/null || echo 0)
    echo "  Vulnerable: $vuln"
    
    echo ""
    echo "── Common IoT Ports ──"
    echo "  80/443: HTTP/HTTPS (cameras, plugs, thermostats)"
    echo "  1883/8883: MQTT (IoT messaging)"
    echo "  5683: CoAP (constrained devices)"
    echo "  22/23: SSH/Telnet (management)"
}

cmd_scan() {
    local network="${1:-$(ip route | grep wlan0 | awk '{print $1}')}"
    echo "══ Scanning for IoT Devices: $network ═════"
    init_iot
    
    echo "  Scan started: $(date)" | tee -a "$SCAN_LOG"
    
    # Method 1: Ping sweep (fast)
    echo ""
    echo "── Ping Sweep ──"
    local found=0
    for i in $(seq 1 254); do
        local target=$(echo "$network" | cut -d. -f1-3).$i
        if ping -c 1 -W 1 "$target" >/dev/null 2>&1; then
            echo "  ✓ $target (responsive)"
            found=$((found + 1))
        fi
    done 2>/dev/null
    
    echo ""
    echo "── Port Scan (common IoT ports) ──"
    if command -v nmap >/dev/null 2>&1; then
        echo "  Running nmap..."
        nmap -p 80,443,1883,5683,22,23,2323 --open "$network" 2>/dev/null | grep -E "Nmap scan|open" | tee -a "$SCAN_LOG" | head -30
    else
        echo "  nmap not available — using basic check..."
        for port in 80 443 1883 22; do
            echo -n "  Checking port $port... "
            nc -z -w 1 "$network" "$port" 2>/dev/null && echo "OPEN" || echo "closed"
        done
    fi
    
    # Save results
    python3 -c "
import json, sys
from datetime import datetime
with open('$DEVICES_FILE') as f:
    d = json.load(f)
d['scan_time'] = datetime.now().isoformat()
d['devices'] = list(set(d['devices'] + ['$network']))
with open('$DEVICES_FILE', 'w') as f:
    json.dump(d, f, indent=2)
" 2>/dev/null || echo "  Scan results saved to: $SCAN_LOG"
    
    echo ""
    echo "  Total devices found: $found"
}

cmd_fingerprint() {
    local ip="${1:-}"
    [ -z "$ip" ] && { echo "Usage: nh-iot fingerprint <ip>"; exit 1; }
    
    echo "══ Fingerprinting IoT Device: $ip ═════"
    init_iot
    
    # Banner grabbing HTTP
    echo "── HTTP Banner ──"
    if command -v curl >/dev/null 2>&1; then
        curl -s --connect-timeout 3 "http://$ip" 2>/dev/null | head -20 | grep -iE "server|www-authenticate|x-powered" | head -5 || echo "  No HTTP response"
        
        echo ""
        echo "  HTTP Headers:"
        curl -I -s --connect-timeout 3 "http://$ip" 2>/dev/null | head -10 || echo "  Connection failed"
    else
        echo "  curl not available"
    fi
    
    echo ""
    echo "── Port Analysis ──"
    for port in 80 443 22 23 1883 5683; do
        if nc -z -w 2 "$ip" "$port" 2>/dev/null; then
            echo "  ✓ Port $port: OPEN"
        fi
    done
    
    echo ""
    echo "── Device Identification ──"
    # Check for common IoT signatures
    local banner=$(curl -s --connect-timeout 2 "http://$ip" 2>/dev/null | tr -d '\n' | head -1)
    if echo "$banner" | grep -qi "camera\|cam\."; then
        echo "  ✓ Possible: IP Camera"
    elif echo "$banner" | grep -qi "plug\|socket"; then
        echo "  ✓ Possible: Smart Plug"
    elif echo "$banner" | grep -qi "thermostat\|nest\|ecobee"; then
        echo "  ✓ Possible: Thermostat"
    elif echo "$banner" | grep -qi "hub\|bridge"; then
        echo "  ✓ Possible: Smart Hub/Gateway"
    else
        echo "  ? Unknown device type"
    fi
}

cmd_test() {
    local ip="${1:-}"
    [ -z "$ip" ] && { echo "Usage: nh-iot test <ip>"; exit 1; }
    
    echo "══ IoT Security Test: $ip ═════════"
    init_iot
    local vulns=0
    
    echo "[1/5] Default Credentials Check..."
    # Check common paths
    for path in "/" "/login" "/admin" "/config" "/setup"; do
        local code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 "http://$ip$path" 2>/dev/null || echo "000")
        if [ "$code" = "200" ] || [ "$code" = "401" ] || [ "$code" = "403" ]; then
            echo "  ✓ Path accessible: $path (HTTP $code)"
        fi
    done
    
    echo ""
    echo "[2/5] Firmware Version Disclosure..."
    curl -s --connect-timeout 2 "http://$ip" 2>/dev/null | grep -iE "version|firmware|build|model" | head -5 || echo "  No version info found"
    
    echo ""
    echo "[3/5] Encryption Check..."
    if nc -z -w 2 "$ip" 443 2>/dev/null; then
        echo "  ✓ HTTPS available (port 443)"
        # Check TLS version
        echo | openssl s_client -connect "$ip:443" -tls1_2 2>/dev/null | grep -E "Protocol|error" | head -3
    else
        echo "  ⚠ No HTTPS (unencrypted communication)"
        vulns=$((vulns + 1))
    fi
    
    echo ""
    echo "[4/5] Open Ports Analysis..."
    if command -v nmap >/dev/null 2>&1; then
        nmap -sT -p 1-1000 --open "$ip" 2>/dev/null | grep "open" | head -10
    else
        for port in 21 22 23 80 443 8080; do
            nc -z -w 1 "$ip" "$port" 2>/dev/null && echo "  ✓ Port $port: OPEN"
        done
    fi
    
    echo ""
    echo "[5/5] IoT Protocol Detection..."
    nc -z -w 2 "$ip" 1883 2>/dev/null && { echo "  ✓ MQTT detected (port 1883)"; vulns=$((vulns + 1)); }
    nc -z -w 2 "$ip" 5683 2>/dev/null && { echo "  ✓ CoAP detected (port 5683)"; }
    
    echo ""
    echo "══ Results ═════════════"
    echo "  Vulnerabilities found: $vulns"
    if [ $vulns -gt 0 ]; then
        echo "  ⚠ Device has security issues!"
        # Save to devices file
        python3 -c "
import json
with open('$DEVICES_FILE') as f:
    d = json.load(f)
d['vulnerable'] = d.get('vulnerable', 0) + 1
with open('$DEVICES_FILE', 'w') as f:
    json.dump(d, f, indent=2)
" 2>/dev/null
    else
        echo "  ✓ No obvious vulnerabilities"
    fi
}

cmd_monitor() {
    echo "══ Monitoring IoT Devices (Ctrl+C to stop) ═"
    init_iot
    
    while true; do
        # Check for new devices
        local arp=$(ip neigh 2>/dev/null | grep -v "FAILED\|INCOMPLETE" | wc -l)
        echo "[$(date)] Devices in ARP table: $arp"
        
        # Check for unusual traffic
        if command -v tcpdump >/dev/null 2>&1; then
            timeout 5 tcpdump -i wlan0 -c 10 "udp port 1883 or udp port 5683" 2>/dev/null | while read line; do
                echo "  IoT traffic: $line"
                echo "$(date): $line" >> "$SCAN_LOG"
            done
        fi
        
        sleep 30
    done
}

cmd_list() {
    echo "══ Discovered IoT Devices ════════"
    init_iot
    
    if [ -s "$DEVICES_FILE" ]; then
        python3 -c "
import json
with open('$DEVICES_FILE') as f:
    d = json.load(f)
print(f\"  Last scan: {d.get('scan_time', 'Never')}\")
print(f\"  Devices: {len(d.get('devices', []))}\")
for dev in d.get('devices', []):
    print(f\"    - {dev}\")
" 2>/dev/null || cat "$SCAN_LOG" | tail -10
    else
        echo "  No devices discovered yet"
        echo "  Run: nh-iot scan"
    fi
}

init_iot

case "${1:-help}" in
    status)      cmd_status ;;
    scan)        cmd_scan "${2:-}" ;;
    fingerprint) cmd_fingerprint "${2:-}" ;;
    test)        cmd_test "${2:-}" ;;
    monitor)     cmd_monitor ;;
    list)        cmd_list ;;
    help|*)     show_usage ;;
esac
