#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-enter-gentoo — Enter Gentoo chroot.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

GENTOO_ROOT="/data/local/nhsystem/roots/gentoo"
MODE="${1:-rooted}"

enter_rooted() {
    echo "[*] Entering Gentoo Linux (rooted)..."
    [ -d "$GENTOO_ROOT" ] || { echo "Gentoo not installed. Run: nh-chroot-manager"; exit 1; }
    chroot "$GENTOO_ROOT" /bin/bash -l
}

enter_rootless() {
    echo "[*] Entering Gentoo (rootless/proot)..."
    proot -0 -r "$GENTOO_ROOT" -w / -l /bin/bash
}

case "$MODE" in
    rootless|--rootless) enter_rootless ;;
    *) enter_rooted ;;
esac
