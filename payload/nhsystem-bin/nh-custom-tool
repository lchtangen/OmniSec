#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P2
# nh-custom-tool — Custom tool builder for power users.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

create_tool() {
    local name="${1:-mytool}"
    local category="${2:-misc}"
    echo "[*] Creating custom tool: $name (category: $category)"
    local tool_path="/data/local/nhsystem/custom/$category/$name"
    mkdir -p "$(dirname "$tool_path")"
    cat > "$tool_path" <<TOOLEOF
#!/system/bin/sh
# Custom tool: $name
# Generated by nh-custom-tool

echo "Running $name..."
# Add your commands here

TOOLEOF
    chmod +x "$tool_path"
    echo "  Tool created: $tool_path"
}

list_tools() {
    echo "══ Custom Tools ═"
    ls -1 /data/local/nhsystem/custom/*/ 2>/dev/null || echo "  No custom tools yet"
}

case "${1:-list}" in
    create) create_tool "${2:-}" "${3:-}" ;;
    list) list_tools ;;
    *) echo "Usage: nh-custom-tool [create <name>|list]" ;;
esac
