#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-oneplus8-support — OnePlus 8 series support.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

detect_oneplus8() {
    local model=$(getprop ro.product.model 2>/dev/null || echo "Unknown")
    if echo "$model" | grep -qiE "oneplus 8|instantnord"; then
        echo "[*] OnePlus 8 series detected: $model"
        return 0
    else
        echo "  Not a OnePlus 8 device"
        return 1
    fi
}

case "${1:-detect}" in
    detect) detect_oneplus8 ;;
    *) echo "Usage: nh-oneplus8-support [detect]" ;;
esac
