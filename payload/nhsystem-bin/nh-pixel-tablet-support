#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P2
# nh-pixel-tablet-support — Pixel Tablet support.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

detect_pixel_tablet() {
    local model=$(getprop ro.product.model 2>/dev/null || echo "Unknown")
    if echo "$model" | grep -qiE "pixel tablet|tangorpro"; then
        echo "[*] Pixel Tablet detected: $model"
        return 0
    else
        echo "  Not a Pixel Tablet"
        return 1
    fi
}

case "${1:-detect}" in
    detect) detect_pixel_tablet ;;
    *) echo "Usage: nh-pixel-tablet-support [detect]" ;;
esac
