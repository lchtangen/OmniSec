#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P2
# nh-live-usb — Create live USB drives!

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib"

create_live() {
    local iso="${1:-}" device="${2:-}"
    echo "[*] Creating live USB: $device from $iso"
}

case "${1:-help}" in
    create) create_live "${2:-}" "${3:-}" ;;
    *) echo "Usage: nh-live-usb [create <iso> <device>]" ;;
esac
