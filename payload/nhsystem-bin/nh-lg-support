#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P2
# nh-lg-support — LG device support.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

detect_lg() {
    local model=$(getprop ro.product.model 2>/dev/null || echo "Unknown")
    if echo "$model" | grep -qi lg; then
        echo "[*] LG device detected: $model"
        return 0
    else
        echo "  Not an LG device"
        return 1
    fi
}

case "${1:-detect}" in
    detect) detect_lg ;;
    *) echo "Usage: nh-lg-support [detect]" ;;
esac
