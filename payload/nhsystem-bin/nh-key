#!/system/bin/sh
# PRIORITY: P1
# Device-side key management — WireGuard keys, API key store,
# authorized_keys management for chroot SSH access.

NHSYSTEM="${NHSYSTEM:-/data/local/nhsystem}"
OMNISEC_DIR="${NHSYSTEM}/omnisec"
OMNISEC_KEYS="${OMNISEC_DIR}/keys"
OMNISEC_CONFIG="${OMNISEC_DIR}/config"

usage() {
    cat <<EOF
Usage: nh-key <command> [args]

Device-side key management commands:
  wg-gen [name]      Generate WireGuard key pair on-device
  wg-show [name]     Show WireGuard public key
  ssh-auth [key]     Add SSH public key to chroot authorized_keys
  api-store <name> <key>  Store an API key for service auth
  api-get <name>     Retrieve an API key
  api-list           List stored API keys and hashes
  init               Initialize on-device key store
EOF
}

init_store() {
    mkdir -p "${OMNISEC_KEYS}" 2>/dev/null
    mkdir -p "${OMNISEC_KEYS}/wg" 2>/dev/null
    mkdir -p "${OMNISEC_KEYS}/api" 2>/dev/null
    mkdir -p "${OMNISEC_KEYS}/ssh" 2>/dev/null
    chmod 0700 "${OMNISEC_DIR}" "${OMNISEC_KEYS}" 2>/dev/null || true
    echo "key store initialized at ${OMNISEC_KEYS}"
}

wg_gen() {
    name="${1:-wg0}"
    mkdir -p "${OMNISEC_KEYS}/wg" 2>/dev/null
    priv="${OMNISEC_KEYS}/wg/${name}.key"
    pub="${OMNISEC_KEYS}/wg/${name}.pub"
    if [ -f "$priv" ]; then
        echo "key '$name' already exists" >&2
        exit 1
    fi
    wg genkey > "$priv" 2>/dev/null || {
        echo "wg not available — is wireguard-tools installed?" >&2
        exit 1
    }
    chmod 0600 "$priv"
    wg pubkey < "$priv" > "$pub"
    chmod 0644 "$pub"
    echo "generated: $name"
    echo "  public: $(cat "$pub")"
}

wg_show() {
    name="${1:-wg0}"
    pub="${OMNISEC_KEYS}/wg/${name}.pub"
    if [ -f "$pub" ]; then
        echo "$(cat "$pub")"
    else
        echo "key not found: $name" >&2
        exit 1
    fi
}

ssh_auth() {
    key="${1:-}"
    if [ -z "$key" ]; then
        echo "usage: nh-key ssh-auth <public-key>" >&2
        exit 1
    fi
    # Add to all chroot authorized_keys
    for root in archlinux kali-arm64; do
        dir="${NHSYSTEM}/roots/${root}"
        if [ -d "$dir" ]; then
            auth="$dir/root/.ssh/authorized_keys"
            mkdir -p "$(dirname "$auth")" 2>/dev/null
            echo "$key" >> "$auth"
            chmod 0600 "$auth" 2>/dev/null || true
            echo "added to $root/root/.ssh/authorized_keys"
        fi
    done
    # Also store in omnisec store
    echo "$key" >> "${OMNISEC_KEYS}/ssh/authorized_keys"
    chmod 0600 "${OMNISEC_KEYS}/ssh/authorized_keys" 2>/dev/null || true
}

api_store() {
    name="${1:-}"
    key="${2:-}"
    if [ -z "$name" ] || [ -z "$key" ]; then
        echo "usage: nh-key api-store <name> <key>" >&2
        exit 1
    fi
    mkdir -p "${OMNISEC_KEYS}/api" 2>/dev/null
    echo "$key" > "${OMNISEC_KEYS}/api/${name}.key"
    chmod 0600 "${OMNISEC_KEYS}/api/${name}.key"
    echo "stored: api key '$name'"
}

api_get() {
    name="${1:-}"
    if [ -z "$name" ]; then
        echo "usage: nh-key api-get <name>" >&2
        exit 1
    fi
    if [ -f "${OMNISEC_KEYS}/api/${name}.key" ]; then
        cat "${OMNISEC_KEYS}/api/${name}.key"
    else
        echo "key not found: $name" >&2
        exit 1
    fi
}

api_list() {
    mkdir -p "${OMNISEC_KEYS}/api" 2>/dev/null
    for f in "${OMNISEC_KEYS}/api/"*.key; do
        [ -f "$f" ] || continue
        name=$(basename "$f" .key)
        hash=$(sha256sum "$f" 2>/dev/null | cut -c1-16)
        echo "  $name (hash: ${hash}...) "
    done
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    init)      init_store ;;
    wg-gen)    wg_gen "$@" ;;
    wg-show)   wg_show "$@" ;;
    ssh-auth)  ssh_auth "$@" ;;
    api-store) api_store "$@" ;;
    api-get)   api_get "$@" ;;
    api-list)  api_list ;;
    help|--help|-h) usage ;;
    *)         usage >&2; exit 2 ;;
esac
