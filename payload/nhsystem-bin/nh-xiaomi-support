#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 matrix
# PRIORITY: P1
# nh-xiaomi-support — Xiaomi/Redmi device compatibility.

set -euo pipefail
. /data/local/nhsystem/bin/nh-lib

detect_xiaomi() {
    local model=$(getprop ro.product.model 2>/dev/null || echo "Unknown")
    if echo "$model" | grep -qiE "xiaomi|redmi|poco|mi "; then
        echo "[*] Xiaomi device detected: $model"
        return 0
    else
        echo "  Not a Xiaomi device"
        return 1
    fi
}

case "${1:-detect}" in
    detect) detect_xiaomi ;;
    *) echo "Usage: nh-xiaomi-support [detect]" ;;
esac
