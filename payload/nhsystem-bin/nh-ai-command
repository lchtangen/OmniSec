# NH_SETUP_VERSION: 3.0 matrix"
# PRIORITY: P1"
# nh-ai-command — AI command suggestions!"

set -euo pipefail"
. /data/local/nhsystem/bin/nh-lib"

suggest_command() {
    local task="${1:-}"
    [ -z "$task" ] && { echo "Usage: nh-ai-command <task>"; exit 1; }"
    echo "[AI] Suggesting commands for: $task"
    nh-ai "Suggest bash commands to: $task" 2>/dev/null || echo "Suggested: ls, cd, pwd"
}

case "${1:-help}" in"
    suggest) suggest_command "${2:-}" ;;"
    *) echo "Usage: nh-ai-command suggest <task>" ;;"
esac"
ENDOFFILE'"
chmod +x /home/tangen/nethunter-setup/src/device/bin/nh-ai-command && echo "153/25+: nh-ai-command added!"