#!/system/bin/sh"
# NH_SETUP_VERSION: 3.0 matrix"
# PRIORITY: P2"
# nh-appimage — AppImage runner!"

set -euo pipefail"
. /data/local/nhsystem/bin/nh-lib"

run_appimage() {
    local appimg="${1:-}"
    [ -f "$appimg" ] || { echo "Usage: nh-appimage <file.AppImage>"; exit 1; }
    echo "[*] Running AppImage: $appimg"
}

case "${1:-help}" in
    run) run_appimage "${2:-}" ;;
    *) echo "Usage: nh-appimage run <file.AppImage>" ;;
esac
