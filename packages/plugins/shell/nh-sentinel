#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# PRIORITY: P2
# nh-sentinel - File integrity monitoring and change tracking
set -u

NHSYSTEM=/data/local/nhsystem
SENTINEL_DIR=$NHSYSTEM/etc/sentinel
SENTINEL_DB=$SENTINEL_DIR/database
SENTINEL_LOG=$NHSYSTEM/logs/sentinel.log

ensure_dirs() { mkdir -p "$SENTINEL_DIR" "$NHSYSTEM/logs"; }

init_tracking() {
    local target="${1:-}"
    [ -z "$target" ] && { echo "Usage: nh-sentinel init <path>"; exit 1; }
    [ -e "$target" ] || { echo "Not found: $target"; exit 1; }

    ensure_dirs
    local name=$(echo "$target" | tr '/' '_')
    local db="$SENTINEL_DB-$name"

    echo "── Initializing Sentinel: $target ──"
    echo ""

    if [ -f "$db" ]; then
        echo "  Database exists. Overwrite? (y/N)"
        read -r ans
        case "$ans" in y|Y) ;; *) echo "  Cancelled"; return ;; esac
    fi

    if [ -d "$target" ]; then
        find "$target" -type f -exec sha256sum {} \; 2>/dev/null > "$db"
        local count=$(wc -l < "$db")
        echo "  Indexed $count files from $target"
    elif [ -f "$target" ]; then
        sha256sum "$target" > "$db"
        echo "  Indexed 1 file: $target"
    fi

    echo "  Database: $db"
    echo "  $(date)" >> "$db"
}

check_changes() {
    local pattern="${1:-}"
    echo "── Sentinel Check ──"
    echo ""

    local found=0
    for db in "$SENTINEL_DB"*; do
        [ -f "$db" ] || continue
        local name=$(echo "$db" | sed "s|$SENTINEL_DB-||")
        [ -n "$pattern" ] && ! echo "$name" | grep -q "$pattern" && continue

        local target=""
        local db_target=$(head -1 "$db" 2>/dev/null | awk '{print $2}')
        [ -n "$db_target" ] && target=$(dirname "$db_target" 2>/dev/null)
        [ -z "$target" ] && target="unknown"

        local changes=$(mktemp)
        local change_count=0

        # Check against current state
        if [ -d "$target" ]; then
            find "$target" -type f -exec sha256sum {} \; 2>/dev/null > "$changes"
        elif [ -f "$target" ]; then
            sha256sum "$target" > "$changes"
        fi

        diff "$db" "$changes" 2>/dev/null | grep '^[<>]' | while read -r line; do
            local type="${line:0:1}"
            local data="${line:2}"
            if [ "$type" = "<" ]; then
                echo "  DELETED: $target/$(echo $data | awk '{print $2}')"
            else
                echo "  NEW/MODIFIED: $target/$(echo $data | awk '{print $2}')"
            fi
            change_count=$((change_count + 1))
        done

        if [ "$change_count" -gt 0 ]; then
            echo "  ($change_count changes in $name)"
            found=$((found + 1))
        fi

        rm -f "$changes"
    done

    [ $found -eq 0 ] && echo "  No changes detected"
}

show_status() {
    echo "── Sentinel Status ──"
    echo ""
    local count=0
    for db in "$SENTINEL_DB"*; do
        [ -f "$db" ] || continue
        local name=$(echo "$db" | sed "s|$SENTINEL_DB-||")
        local entries=$(wc -l < "$db")
        local date=$(tail -1 "$db" 2>/dev/null || echo "?")
        printf "  %-30s %d entries  [%s]\n" "$name" "$((entries - 1))" "$date"
        count=$((count + 1))
    done
    [ $count -eq 0 ] && echo "  No tracking databases"
    echo "  $count database(s)"
}

usage() {
    cat <<EOF
nh-sentinel - File integrity monitoring

Usage: nh-sentinel <command> <path>

Commands:
  init <path>      Start tracking file(s) at path
  check [pattern]  Check for changes (optional name filter)
  status           List tracking databases

Examples:
  nh-sentinel init /etc
  nh-sentinel init /data/local/nhsystem/bin
  nh-sentinel check
  nh-sentinel check nhsystem
  nh-sentinel status
EOF
    exit 1
}

case "${1:-help}" in
    init|track|add) shift; init_tracking "${1:-}" ;;
    check|diff|verify) shift; check_changes "${1:-}" ;;
    status|list|ls) show_status ;;
    *) usage ;;
esac
