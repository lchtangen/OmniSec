#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P2
# nh-ebpf - eBPF Kernel Defense & Observability
# Load custom eBPF programs, monitor syscalls, file integrity
set -u

NHSYSTEM=${NHSYSTEM:-/data/local/nhsystem}
EBPF_DIR="$NHSYSTEM/ebpf"
CONFIG_DIR="$NHSYSTEM/etc/ebpf"
BPFTRACE_DIR="$NHSYSTEM/bpftrace"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p "$EBPF_DIR" "$CONFIG_DIR" "$BPFTRACE_DIR"

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
err()   { printf "${RED}[ERR]${NC} %s\n" "$*" >&2; }
debug() { [ "${DEBUG:-0}" = "1" ] && printf "${CYAN}[DBG]${NC} %s\n" "$*" || true; }

check_root() {
    [ "$(id -u)" -eq 0 ] || { err "This command requires root"; return 1; }
}

check_ebpf_support() {
    # Check if kernel supports eBPF
    if [ -d /proc/sys/net/core/bpf_jit_enable ] || \
       [ -f /sys/kernel/debug/tracing/kprobe_events ] || \
       uname -r | grep -q "5\.[0-9]+"; then
        ok "Kernel supports eBPF"
        return 0
    else
        warn "Kernel may not support eBPF (requires Linux 4.1+)"
        return 1
    fi
}

# ── eBPF Program Loader ──────────────────────────────────

load_ebpf_program() {
    local prog_file="$1"
    [ -f "$prog_file" ] || { err "Program file not found: $prog_file"; return 1; }
    
    check_root || return 1
    check_ebpf_support || return 1
    
    info "Loading eBPF program: $(basename "$prog_file")"
    
    # Try bpftrace first
    if command -v bpftrace >/dev/null 2>&1; then
        bpftrace -e "$(cat "$prog_file")" &
        local pid=$!
        echo "$pid" > "$EBPF_DIR/bpftrace.pid"
        ok "bpftrace program loaded (PID: $pid)"
        return 0
    fi
    
    # Try using python/bcc
    if python3 -c "import bcc" 2>/dev/null; then
        python3 -c "
from bcc import BPF
with open('$prog_file') as f:
    bpf_text = f.read()
b = BPF(text=bpf_text)
print('eBPF program loaded')
" &
        ok "BCC program loaded"
        return 0
    fi
    
    warn "No eBPF loader available (install bpftrace or bcc)"
    return 1
}

unload_ebpf() {
    info "Unloading eBPF programs..."
    if [ -f "$EBPF_DIR/bpftrace.pid" ]; then
        local pid
        pid=$(cat "$EBPF_DIR/bpftrace.pid" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -f "$EBPF_DIR/bpftrace.pid"
    fi
    pkill -f bpftrace 2>/dev/null || true
    ok "eBPF programs unloaded"
}

# ── File Integrity Monitor (eBPF) ────────────────────────

start_file_monitor() {
    local watch_dir="${1:-/data/local/nhsystem}"
    
    check_root || return 1
    
    info "Starting file integrity monitor on: $watch_dir"
    
    # Create bpftrace script for file monitoring
    local script="$BPFTRACE_DIR/file_monitor.bt"
    cat > "$script" <<'EBPF'
#!/usr/bin/env bpftrace

BEGIN {
    printf("File Integrity Monitor started\n");
}

tracepoint:syscalls:sys_enter_openat,
tracepoint:syscalls:sys_enter_write {
    printf("File access: %s (PID: %d)\n", str(args->filename), pid);
}
EBPF
    
    chmod +x "$script"
    
    if command -v bpftrace >/dev/null 2>&1; then
        bpftrace "$script" > "$EBPF_DIR/file_monitor.log" 2>&1 &
        local pid=$!
        echo "$pid" > "$EBPF_DIR/file_monitor.pid"
        ok "File monitor started (PID: $pid)"
        info "Log: $EBPF_DIR/file_monitor.log"
    else
        warn "bpftrace not installed"
        info "Install in Arch: pacman -S bpftrace"
    fi
}

# ── Syscall Audit Trail ──────────────────────────────────

start_syscall_audit() {
    check_root || return 1
    
    info "Starting syscall audit trail..."
    
    # Monitor execve, connect, bind syscalls
    local script="$BPFTRACE_DIR/syscall_audit.bt"
    cat > "$script" <<'EBPF'
#!/usr/bin/env bpftrace

BEGIN {
    printf("Syscall Audit Trail started\n");
}

tracepoint:syscalls:sys_enter_execve {
    printf("EXEC: %s (PID: %d, UID: %d)\n", 
           str(args->filename), pid, uid);
}

tracepoint:syscalls:sys_enter_connect {
    printf("CONNECT: PID %d connecting to %s\n", pid, 
           str(args->uservaddr));
}

tracepoint:syscalls:sys_enter_bind {
    printf("BIND: PID %d binding to port\n", pid);
}
EBPF
    
    if command -v bpftrace >/dev/null 2>&1; then
        bpftrace "$script" > "$EBPF_DIR/syscall_audit.log" 2>&1 &
        local pid=$!
        echo "$pid" > "$EBPF_DIR/syscall_audit.pid"
        ok "Syscall audit started (PID: $pid)"
        info "Log: $EBPF_DIR/syscall_audit.log"
    else
        warn "bpftrace not available"
    fi
}

# ── Process Ancestry Tracker ─────────────────────────────

start_process_tracker() {
    check_root || return 1
    
    info "Starting process ancestry tracker..."
    
    # Use eBPF to track process relationships
    local script="$BPFTRACE_DIR/process_tracker.bt"
    cat > "$script" <<'EBPF'
#!/usr/bin/env bpftrace

BEGIN {
    printf("Process Ancestry Tracker started\n");
}

tracepoint:sched:sched_process_fork {
    printf("FORK: Parent PID %d -> Child PID %d\n", 
           args->parent_pid, args->child_pid);
}

tracepoint:sched:sched_process_exec {
    printf("EXEC: PID %d comm %s\n", pid, comm);
}
EBPF
    
    if command -v bpftrace >/dev/null 2>&1; then
        bpftrace "$script" > "$EBPF_DIR/process_tracker.log" 2>&1 &
        local pid=$!
        echo "$pid" > "$EBPF_DIR/process_tracker.pid"
        ok "Process tracker started (PID: $pid)"
    else
        warn "bpftrace not available"
    fi
}

# ── Status ───────────────────────────────────────────

show_status() {
    echo ""
    echo "════════════════════════════════════════════════════════"
    echo "  NH-eBPF STATUS"
    echo "  Time: $(date)"
    echo "════════════════════════════════════════════════════════"
    echo ""
    
    # Kernel support
    echo "── Kernel Support ──"
    if check_ebpf_support 2>/dev/null; then
        ok "eBPF supported"
        uname -r | sed 's/^/  Kernel: /'
    else
        warn "eBPF may not be supported"
    fi
    
    echo ""
    
    # Running monitors
    echo "── Active Monitors ──"
    local monitors="file_monitor syscall_audit process_tracker"
    for mon in $monitors; do
        if [ -f "$EBPF_DIR/${mon}.pid" ]; then
            local pid
            pid=$(cat "$EBPF_DIR/${mon}.pid" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                ok "$mon: Running (PID: $pid)"
            else
                warn "$mon: Not running (stale PID file)"
            fi
        else
            info "$mon: Not running"
        fi
    done
    
    echo ""
    
    # Tools available
    echo "── Available Tools ──"
    for tool in bpftrace bcc-examples python3; do
        if command -v "$tool" >/dev/null 2>&1; then
            ok "$tool: Available"
        else
            info "$tool: Not installed"
        fi
    done
}

# ── Log Viewer ──────────────────────────────────────

view_logs() {
    local log_type="${1:-all}"
    
    case "$log_type" in
        file)
            [ -f "$EBPF_DIR/file_monitor.log" ] && \
                tail -50 "$EBPF_DIR/file_monitor.log" || info "No file monitor log"
            ;;
        syscall)
            [ -f "$EBPF_DIR/syscall_audit.log" ] && \
                tail -50 "$EBPF_DIR/syscall_audit.log" || info "No syscall audit log"
            ;;
        process)
            [ -f "$EBPF_DIR/process_tracker.log" ] && \
                tail -50 "$EBPF_DIR/process_tracker.log" || info "No process tracker log"
            ;;
        all|*)
            for log in "$EBPF_DIR"/*.log; do
                [ -f "$log" ] || continue
                echo "── $(basename "$log") ──"
                tail -20 "$log"
                echo ""
            done
            ;;
    esac
}

# ── Usage ────────────────────────────────────────────

usage() {
    cat <<EOF
nh-ebpf - eBPF Kernel Defense & Observability

Usage: nh-ebpf <command> [options]

Setup:
  setup               Install eBPF tools (bpftrace, BCC)
  check               Check kernel eBPF support

Monitors:
  start-file [dir]     Start file integrity monitor (default: /data/local/nhsystem)
  stop-file            Stop file integrity monitor
  start-syscall        Start syscall audit trail
  stop-syscall         Stop syscall audit
  start-process        Start process ancestry tracker
  stop-process         Stop process tracker
  stop-all             Stop all monitors

Status:
  status              Show eBPF status
  logs [type]         View logs (file|syscall|process|all)

Examples:
  nh-ebpf setup
  nh-ebpf start-file /data/local/nhsystem
  nh-ebpf start-syscall
  nh-ebpf status
  nh-ebpf logs all

Installation (in Arch chroot):
  pacman -S bpftrace bcc-tools python-bcc

Notes:
  - Requires root access
  - Requires Linux kernel 4.1+ (eBPF support)
  - Android GKI kernels have eBPF enabled
  - Similar to Tetragon/Falco but runs on Android
EOF
}

# ── Main ────────────────────────────────────────────

[ $# -ge 1 ] || usage

case "$1" in
    setup)
        check_root || exit 1
        info "Installing eBPF tools..."
        if [ -f /data/local/nhsystem/roots/archlinux/usr/bin/pacman ]; then
            chroot /data/local/nhsystem/roots/archlinux pacman -S --noconfirm bpftrace bcc-tools 2>/dev/null || \
                warn "Failed to install via pacman"
        else
            warn "Arch chroot not found for installation"
        fi
        ;;
    check)
        check_ebpf_support
        ;;
    start-file)
        shift
        start_file_monitor "${1:-/data/local/nhsystem}"
        ;;
    stop-file)
        [ -f "$EBPF_DIR/file_monitor.pid" ] && \
            kill "$(cat "$EBPF_DIR/file_monitor.pid")" 2>/dev/null
        ok "File monitor stopped"
        ;;
    start-syscall)
        start_syscall_audit
        ;;
    stop-syscall)
        [ -f "$EBPF_DIR/syscall_audit.pid" ] && \
            kill "$(cat "$EBPF_DIR/syscall_audit.pid")" 2>/dev/null
        ok "Syscall audit stopped"
        ;;
    start-process)
        start_process_tracker
        ;;
    stop-process)
        [ -f "$EBPF_DIR/process_tracker.pid" ] && \
            kill "$(cat "$EBPF_DIR/process_tracker.pid")" 2>/dev/null
        ok "Process tracker stopped"
        ;;
    stop-all)
        unload_ebpf
        ;;
    status)
        show_status
        ;;
    logs)
        shift
        view_logs "${1:-all}"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        err "Unknown command: $1"
        usage
        ;;
esac
