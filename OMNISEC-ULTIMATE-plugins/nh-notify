#!/system/bin/sh
# NH_SETUP_VERSION: 3.0 nextgen
# PRIORITY: P5
# nh-notify — Notification system
set -euo pipefail
show_usage() { cat <<EOF
nh-notify - Notification System
Usage: nh-notify <title> <message>
EOF
}
[ $# -lt 2 ] && show_usage && exit 1
am broadcast -a android.intent.action.SHOW_NOTIFICATION -e title "$1" -e text "$2" 2>/dev/null || echo "Notification sent (Android only)"
