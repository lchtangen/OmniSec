#!/system/bin/sh
# NH_SETUP_VERSION: 2.0 nextgen
# nh-proc - Process monitor with top-like display
set -u

echo "══ Process Monitor ══"
echo ""

# CPU usage per process (using ps)
if ps --help 2>&1 | grep -q '\-A'; then
    ps -A -o pid,ppid,user,%cpu,%mem,rss,args 2>/dev/null | head -30
else
    ps -eo pid,ppid,user,%cpu,%mem,rss,args 2>/dev/null | head -30
fi

echo ""
echo "── Top CPU Consumers ──"
if [ -f /proc/loadavg ]; then
    echo "  load: $(cat /proc/loadavg)"
fi

echo ""
echo "── Top Memory Consumers ──"
# Sort by RSS (rough memory usage)
for pid in /proc/[0-9]*/status; do
    [ -f "$pid" ] || continue
    NAME=$(grep '^Name:' "$pid" 2>/dev/null | awk '{print $2}')
    RSS=$(grep '^VmRSS:' "$pid" 2>/dev/null | awk '{print $2}')
    [ -n "$RSS" ] && printf "  %-20s %s kB\n" "$NAME" "$RSS"
done 2>/dev/null | sort -k2 -rn | head -10
