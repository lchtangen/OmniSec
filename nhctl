# ── AI Commands ──────────────────────────────────────────────────────────
nh_ai() {
    local subcmd="${1:-help}"
    shift 2>/dev/null || true
    case "$subcmd" in
        chat|ask)       require_root; adbr "sh /data/local/nhsystem/bin/nh-ai chat $*" ;;
        diagnose)       require_root; adbr "sh /data/local/nhsystem/bin/nh-ai diagnose" ;;
        status)         require_root; adbr "sh /data/local/nhsystem/bin/nh-ai status" ;;
        models)         require_root; adbr "sh /data/local/nhsystem/bin/nh-ai models" ;;
        install|pull)   require_root; adbr "sh /data/local/nhsystem/bin/nh-ai install ${2:-}" ;;
        recon)          require_root; adbr "sh /data/local/nhsystem/bin/nh-ai recon $*" ;;
        sessions)       require_root; adbr "sh /data/local/nhsystem/bin/nh-ai sessions $*" ;;
        setup)          require_root; adbr "sh /data/local/nhsystem/bin/nh-ai setup" ;;
        help|*)         echo "Usage: nhctl ai <command> [args]"
                        echo "Commands: chat, ask, diagnose, status, models, install, recon, sessions, setup"
                        echo "Alias: nhctl ask <question> = nhctl ai ask <question>"
                        ;;
    esac
}

nh_ask() {
    require_root
    adbr "sh /data/local/nhsystem/bin/nh-ai chat $*"
}

case "$cmd" in
    ask)
        shift 2>/dev/null || true
        nh_ask "$@"
        ;;
    ai)
        nh_ai "$@"
        ;;
    status)
        ./preflight.sh "${1:-$ADB_SERIAL}" || true
        require_root
        adbr "/data/local/nhsystem/bin/nh-status"
        ;;
    forward)
        ./setup-adb-forwards.sh "$ADB_SERIAL"
        ;;
    connect-arch|enter-arch)
        ./connect-arch.sh
        ;;
    arch)
        CONNECT_ARCH_FORCE_TERMUX=1 ./connect-arch.sh
        ;;
    termux)
        require_adb
        ./setup-adb-forwards.sh "$ADB_SERIAL" >/dev/null
        TERMUX_USER="${TERMUX_USER:-$(detect_termux_user)}"
        exec ssh -t -p 8022 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "${TERMUX_USER}@127.0.0.1"
        ;;
    setup-ssh)
        ./setup-ssh-config.sh "${1:-$DEVICE_IP}"
        ;;
    backup)
        run_backup
        ;;
    deploy-tools)
        deploy_tools
        ;;
    deploy-sudo-wrapper)
        deploy_sudo_wrapper_cmd
        ;;
    deploy-bootkali)
        deploy_bootkali_fixes
        ;;
    repair-arch-ssh)
        repair_arch_ssh
        ;;
