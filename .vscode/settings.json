{
    // ── Shell scripting ──────────────────────────────────────────────────────
    "shellcheck.enable": true,
    "shellcheck.run": "onSave",
    "shellcheck.executablePath": "/usr/bin/shellcheck",
    "shellcheck.customArgs": ["-x"],
    "shellcheck.exclude": ["SC1091"],
    "bashIde.shellcheckPath": "/usr/bin/shellcheck",

    "editor.defaultFormatter": "foxundermoon.shell-format",
    "shellformat.flag": "-i 4 -ci",
    "shellformat.useEditorConfig": true,
    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.rulers": [100]
    },

    // ── C (nh-sudo.c) ────────────────────────────────────────────────────────
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.rulers": [80]
    },

    // ── File associations ────────────────────────────────────────────────────
    "files.associations": {
        "*.sh": "shellscript",
        "nh-*": "shellscript",
        "nh-lib": "shellscript",
        "Dockerfile*": "dockerfile",
        "*.env*": "dotenv",
        "arch-*": "shellscript",
        "kali-*": "shellscript",
        "deploy-*": "shellscript",
        ".github/workflows/*.yml": "yaml",
        "*.conf": "ini",
        "sshd_config": "ini",
        "*.md": "markdown",
        "*.c": "c",
        "PKGBUILD": "shellscript",
        ".aider*.yml": "yaml",
        ".aider*.yaml": "yaml",
        ".aider.conf.json": "jsonc",
        ".claude/**/*.json": "jsonc",
        ".claude/agents/*.md": "markdown",
        ".continue/**/*.json": "jsonc",
        ".codeium/**/*.json": "jsonc",
        ".cody/**/*.json": "jsonc",
        ".cursorrules": "markdown",
        ".clinerules": "markdown",
        ".windsurfrules": "markdown",
        ".roo/rules/*.mdc": "markdown",
        ".cursor/rules/*.mdc": "markdown",
        ".github/copilot-instructions*.md": "markdown",
        "*.prompt.md": "markdown",
        "*.instructions.md": "markdown",
        "*.agent.md": "markdown",
        "AGENTS.md": "markdown",
        "CLAUDE.md": "markdown",
        "CODEX.md": "markdown",
        "OPENCODE.md": "markdown",
        "SKILL.md": "markdown",
        ".opencode/**/*.json": "jsonc",
        ".opencode/**/*.yml": "yaml",
        ".opencode/**/*.yaml": "yaml"
    },

    // ── Search / explorer exclusions ─────────────────────────────────────────
    "files.exclude": {
        "**/*.tar.gz": true,
        "**/build": true,
        "**/dist": true,
        "**/payload": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.claude/projects/**": true,
        "**/.claude/todos/**": true,
        "**/.claude/cache/**": true,
        "**/.aider.chat.history.md": true,
        "**/.aider.input.history": true,
        "**/.aider.tags.cache.v*": true,
        "**/.codex/**": true,
        "**/.continue/**": true,
        "**/.gemini/**": true,
        "**/.codeium/**": true,
        "**/.cody/**": true,
        "**/.sourcegraph/**": true,
        "**/.opencode/**": true
    },
    "search.exclude": {
        "**/*.tar.gz": true,
        "**/build": true,
        "**/dist": true,
        "**/payload": true,
        "**/__pycache__": true,
        "**/node_modules": true,
        "**/package-lock.json": true,
        "**/.claude/projects/**": true,
        "**/.claude/todos/**": true,
        "**/.claude/cache/**": true,
        "**/.aider.chat.history.md": true,
        "**/.aider.input.history": true,
        "**/.aider.tags.cache.v*": true,
        "**/.codex/**": true,
        "**/.continue/**": true,
        "**/.gemini/**": true,
        "**/.codeium/**": true,
        "**/.cody/**": true,
        "**/.sourcegraph/**": true,
        "**/.opencode/**": true
    },
    "files.watcherExclude": {
        "**/*.tar.gz": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/payload/**": true,
        "**/__pycache__/**": true,
        "**/node_modules/**": true,
        "**/.claude/projects/**": true,
        "**/.claude/todos/**": true,
        "**/.claude/cache/**": true,
        "**/.aider.chat.history.md": true,
        "**/.aider.input.history": true,
        "**/.aider.tags.cache.v*": true,
        "**/.codex/**": true,
        "**/.continue/**": true,
        "**/.gemini/**": true,
        "**/.codeium/**": true,
        "**/.cody/**": true,
        "**/.sourcegraph/**": true,
        "**/.opencode/**": true
    },
    "search.followSymlinks": false,

    // ── Terminal ─────────────────────────────────────────────────────────────
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "/usr/bin/zsh",
            "args": []
        },
        "Arch Chroot (SSH)": {
            "path": "/usr/bin/ssh",
            "args": ["-p", "2222", "archlinux@127.0.0.1"],
            "icon": "terminal-linux"
        },
        "Kali Chroot (SSH)": {
            "path": "/usr/bin/ssh",
            "args": ["nh-kali"],
            "icon": "terminal-linux"
        },
        "Android / Termux (SSH)": {
            "path": "/usr/bin/ssh",
            "args": ["-p", "8022", "u0_a171@127.0.0.1"],
            "icon": "device-mobile"
        },
        "ADB Root Shell": {
            "path": "/usr/bin/adb",
            "args": ["shell", "/debug_ramdisk/su", "-c", "zsh || bash"],
            "icon": "debug-console"
        },
        "Codex CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "codex"],
            "icon": "hubot"
        },
        "Claude CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "claude"],
            "icon": "comment-discussion"
        },
        "GitHub Copilot CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "gh copilot"],
            "icon": "github"
        },
        "Aider CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "aider"],
            "icon": "terminal-bash"
        },
        "Gemini CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "gemini"],
            "icon": "sparkle"
        },
        "Codeium CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "codeium"],
            "icon": "symbol-method"
        },
        "Cody CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "cody"],
            "icon": "extensions"
        },
        "Continue CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "cn"],
            "icon": "sync"
        },
        "Augment CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "auggie"],
            "icon": "sparkle-filled"
        },
        "OpenCode CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "opencode"],
            "icon": "code"
        },
        "Roo CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "roo"],
            "icon": "terminal"
        },
        "Windsurf CLI": {
            "path": "/usr/bin/env",
            "args": ["bash", "-lc", "windsurf"],
            "icon": "terminal"
        }
    },
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.defaultLocation": "editor",
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.cwd": "${workspaceFolder}",

    // ── Remote SSH targets (visible in Remote Explorer) ──────────────────────
    "remote.SSH.configFile": "~/.ssh/config",
    "remote.SSH.remotePlatform": {
        "nh-arch": "linux",
        "nh-kali": "linux",
        "nh-android": "linux"
    },

    // ── Task runner ──────────────────────────────────────────────────────────
    "task.allowAutomaticTasks": "on",
    "makefile.configureOnOpen": false,

    // ── Diagnostics & productivity ───────────────────────────────────────────
    "errorLens.enabled": true,
    "errorLens.messageEnabled": true,
    "problems.showCurrentInStatus": true,
    "git.autofetch": true,
    "git.pruneOnFetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.untrackedChanges": "separate",
    "git.openRepositoryInParentFolders": "always",
    "scm.defaultViewMode": "tree",
    "todo-tree.highlights.enabled": true,
    "todo-tree.tree.showScanModeButton": true,
    "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "NOTE", "SECURITY", "PERF"],

    // ── Editor ───────────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    "editor.inlineSuggest.enabled": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.stickyScroll.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "trailing",
    "editor.wordWrap": "off",
    "workbench.editor.enablePreview": false,
    "workbench.startupEditor": "none",
    "explorer.compactFolders": false,
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",

    // ── Markdown/YAML/Python quality defaults ───────────────────────────────
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": false
    },
    "markdownlint.configFile": "${workspaceFolder}/.markdownlint.jsonc",
    "markdownlint.run": "onSave",
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },
    "yaml.validate": true,
    "yaml.format.enable": true,
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.{yml,yaml}"
    },
    "cSpell.enabled": true,
    "cSpell.language": "en,en-US",
    "cSpell.diagnosticLevel": "Warning",
    "cSpell.import": ["${workspaceFolder}/cspell.json"],
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.callArgumentNames": "partial",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",

    // ── Copilot (project scope) ───────────────────────────────────────────────
    "chat.commandCenter.enabled": true,
    "chat.useCustomizationsInParentRepositories": true,
    "chat.promptFilesLocations": {
        ".github/prompts": true
    },
    "chat.agentFilesLocations": {
        ".github/agents": true,
        ".claude/agents": true
    },
    "chat.agentSkillsLocations": {
        ".github/skills": true,
        ".agents/skills": true,
        ".claude/skills": true
    },
    "chat.promptFilesRecommendations": {
        ".github/prompts": true
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.chat.localeOverride": "en",
    "github.copilot.chat.organizationCustomAgents.enabled": true,
    "github.copilot.chat.skillTool.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "shellscript": true,
        "c": true,
        "yaml": true,
        "python": true,
        "markdown": true,
        "plaintext": false
    }
}
